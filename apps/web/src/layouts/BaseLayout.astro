---
import { getSiteSettings, getAnnouncementBar } from '@lib/payload'
import type { Media } from '@shared/types/payload-types'

interface Props {
  title: string
  description?: string
  ogImage?: string
  /** Canonical URL override; default = current path absolut terhadap site. */
  canonical?: string
  /** og:type (default 'website'; detail pages bisa pakai 'product'/'article'). */
  ogType?: string
  /** noindex,nofollow (mis. 404). Default index,follow. */
  noindex?: boolean
}

const {
  title,
  description: descProp,
  ogImage: ogImageProp,
  canonical: canonicalProp,
  ogType = 'website',
  noindex = false,
} = Astro.props

// Canonical (absolute). Astro.site = https://dnjourneysbali.com (astro.config).
const canonicalURL =
  canonicalProp ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href

// Fetch site-settings — semua fallback branding/SEO dari sini. Fail-safe: null → hardcoded fallback.
const settings = await getSiteSettings().catch(() => null)

const siteName = settings?.siteName ?? 'DnJourneysBali'
const siteTitle = `${title} — ${siteName}`

// Description cascade: prop → CMS defaultSeo.metaDescription → hardcoded fallback
const description =
  descProp ??
  settings?.defaultSeo?.metaDescription ??
  'Your Bali Journey, Our Local Expertise'

// OG image cascade: prop → CMS defaultSeo.ogImage → none
const ogImageMedia = (typeof settings?.defaultSeo?.ogImage === 'object' ? settings.defaultSeo.ogImage : null) as Media | null
const ogImage = ogImageProp ?? ogImageMedia?.url ?? undefined

// Favicon cascade: CMS site-settings.favicon → hardcoded /favicon.svg
const faviconMedia = (typeof settings?.favicon === 'object' ? settings.favicon : null) as Media | null
const faviconUrl = faviconMedia?.url ?? '/favicon.svg'
const faviconMime = faviconMedia?.mimeType ?? 'image/svg+xml'

// Analytics — both providers optional & independent
const gaId = settings?.defaultSeo?.googleAnalyticsId as string | undefined
const cfAnalyticsToken = settings?.defaultSeo?.cloudflareWebAnalyticsToken as string | undefined

// Phase 4.33 — Announcement Bar zero-flash dismissal check.
// Read the version SSR, inline a tiny script in <head> that stamps
// data-ab-hidden on <html> before body paint if the visitor already
// dismissed this exact message. CSS hides .announcement-bar under that
// attribute so it never flickers on repeat visits.
let abVersion = ''
try {
  const bar = await getAnnouncementBar()
  abVersion = (bar as any)?.version ?? ''
} catch { /* absent = no head script needed */ }
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:type" content={ogType} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Favicon (CMS-driven with hardcoded fallback) -->
    <link rel="icon" type={faviconMime} href={faviconUrl} />

    <!-- Preload fonts -->
    <link rel="preload" href="/fonts/plus-jakarta-sans-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-variable.woff2" as="font" type="font/woff2" crossorigin />

    {abVersion && (
      <script is:inline set:html={`
        try {
          if (localStorage.getItem('dnj:ab-dismissed:${abVersion}') === '1') {
            document.documentElement.setAttribute('data-ab-hidden', 'true');
          }
        } catch (_) {}
      `}></script>
    )}
    <style is:global>
      html[data-ab-hidden] .announcement-bar { display: none !important; }
    </style>

    {/* Google Analytics 4 — only if measurement ID set in CMS */}
    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline set:html={`
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', '${gaId}');
        `}></script>
      </>
    )}
  </head>
  <body>
    <slot />

    <!-- GSAP init -->
    <script>
      import { initAnimations } from '@lib/animations'
      document.addEventListener('astro:page-load', initAnimations)
    </script>

    {/* Cloudflare Web Analytics — beacon (privacy-first, cookieless). Only if token set. */}
    {cfAnalyticsToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cfAnalyticsToken}"}`}
      ></script>
    )}
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
