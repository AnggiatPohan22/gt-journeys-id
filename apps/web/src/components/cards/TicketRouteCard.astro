---
/**
 * TicketRouteCard — kartu tiket rute horizontal yang REUSABLE (Phase 4.61).
 *
 * Generik & tidak tahu domain (ferry/bus/train) — cukup dikirim props di bawah.
 * Dipakai FerryTicketsCard (variant="ticket"); modul transport lain nanti bisa
 * memanggil komponen ini langsung dengan bentuk data yang sama.
 *
 * Layout: badges + harga (kanan atas), operator (kiri atas), baris rute
 * Origin → Arrival (thumbnail, nama, terminal, jam, tanggal, durasi, booked),
 * lalu tombol More info + Book Now. Responsif: kolom rute menumpuk di mobile.
 */
import Icon from '@components/common/Icon.astro'
import { formatPrice } from '@shared/utils/format-price'

export interface TicketBadge {
  text: string
  style?: 'ocean' | 'leaf' | 'coral'
}
export interface TicketEndpoint {
  name: string
  terminal?: string
  time?: string
  date?: string
}
export interface TicketPrice {
  amount: number
  currency: string
  /** Label unit, mis. "Per person · Taxes incl." */
  per?: string
  /** Harga total (opsional), mis. 2 pax. */
  total?: number
  /** Nama kelas/cabin, mis. "Economy". */
  className?: string
  /** Harga asli sebelum diskon → tampil coret. */
  original?: number
  /** Persen hemat (dihitung otomatis bila tak diisi tapi original ada). */
  savePct?: number
}
export interface Props {
  href: string
  bookHref: string
  moreInfoHref?: string
  operator?: { name?: string; logo?: string }
  badges?: TicketBadge[]
  image?: { url: string; alt?: string }
  from: TicketEndpoint
  to: TicketEndpoint
  middle?: { label?: string; icon?: string; duration?: string; bookedLabel?: string }
  price?: TicketPrice
  bookText?: string
  moreInfoText?: string
  /** Phase 4.61.3 — corak/watermark dekoratif (opsional). */
  background?: { url: string; opacity: number; position: 'right' | 'cover' | 'tile' | 'center' }
}

const {
  href,
  bookHref,
  moreInfoHref,
  operator,
  badges = [],
  image,
  from,
  to,
  middle = {},
  price,
  bookText = 'Book Now',
  moreInfoText = 'More info',
  background,
} = Astro.props

// Phase 4.61.3 — style layer background dekoratif. Ringan: 1 <div> CSS bg,
// tanpa <img> tambahan di DOM konten; URL sama antar kartu → 1x download.
const bgSizeByPos: Record<string, string> = { right: 'auto 100%', cover: 'cover', tile: 'auto', center: 'contain' }
const bgRepeatByPos: Record<string, string> = { right: 'no-repeat', cover: 'no-repeat', tile: 'repeat', center: 'no-repeat' }
const bgPosByPos: Record<string, string> = { right: 'right center', cover: 'center', tile: 'top left', center: 'center' }
const bgStyle = background
  ? [
      `background-image:url('${background.url}')`,
      `background-size:${bgSizeByPos[background.position] ?? 'auto 100%'}`,
      `background-repeat:${bgRepeatByPos[background.position] ?? 'no-repeat'}`,
      `background-position:${bgPosByPos[background.position] ?? 'right center'}`,
      `opacity:${background.opacity}`,
    ].join(';')
  : ''

const badgeClass: Record<string, string> = {
  ocean: 'bg-ocean/10 text-ocean',
  leaf: 'bg-leaf/15 text-leaf',
  coral: 'bg-coral/15 text-coral',
}

const savePct =
  price?.savePct ??
  (price?.original && price.original > price.amount
    ? Math.round(((price.original - price.amount) / price.original) * 100)
    : undefined)

const midLabel = middle.label ?? 'Ferry'
const midIcon = middle.icon ?? 'ship'
---

<article class="group relative bg-white rounded-2xl border border-sand-dark/10 shadow-sm hover:shadow-lg transition-shadow duration-300 overflow-hidden">
  {background && (
    <div
      class="absolute inset-0 pointer-events-none"
      style={bgStyle}
      aria-hidden="true"
    ></div>
  )}
  <div class="relative p-5 md:p-6">
    {/* ── Top: operator + badges (left) · price (right) ── */}
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="min-w-0">
        {badges.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-3">
            {badges.map((b) => (
              <span class={`px-2.5 py-1 rounded-md text-xs font-semibold ${badgeClass[b.style ?? 'leaf']}`}>
                {b.text}
              </span>
            ))}
          </div>
        )}
        {(operator?.logo || operator?.name) && (
          <div class="flex items-center gap-2.5">
            {operator?.logo && (
              <img src={operator.logo} alt={operator?.name ?? 'Operator'} loading="lazy" class="h-7 w-auto max-w-[120px] object-contain" />
            )}
            {operator?.name && <span class="font-semibold text-ocean text-lg">{operator.name}</span>}
          </div>
        )}
      </div>

      {price && (
        <div class="text-right shrink-0">
          <p class="font-display text-2xl md:text-3xl font-bold text-ocean leading-none">
            {formatPrice(price.amount, price.currency)}
          </p>
          {price.per && <p class="text-xs text-stone-light mt-1">{price.per}</p>}
          {typeof price.total === 'number' && (
            <p class="text-xs text-stone-light font-semibold">Total {formatPrice(price.total, price.currency)}</p>
          )}
          <div class="flex items-center justify-end gap-2 mt-1.5">
            {price.className && (
              <span class="px-2 py-0.5 rounded border border-sand-dark/30 text-[11px] text-stone">{price.className}</span>
            )}
            {price.original && price.original > price.amount && (
              <span class="text-xs text-stone-light line-through">{formatPrice(price.original, price.currency)}</span>
            )}
            {savePct && savePct > 0 && (
              <span class="px-2 py-0.5 rounded bg-coral text-white text-[11px] font-semibold">Save {savePct}%</span>
            )}
          </div>
        </div>
      )}
    </div>

    {/* ── Route row ── */}
    <a href={href} class="block no-underline text-current mt-5">
      <div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-6">
        {image?.url && (
          <div class="w-full md:w-32 lg:w-40 shrink-0 aspect-[4/3] md:aspect-square rounded-xl overflow-hidden bg-sand">
            <img src={image.url} alt={image.alt ?? from.name} loading="lazy"
                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
        )}

        <div class="flex-1 grid grid-cols-1 md:grid-cols-3 items-center gap-4">
          {/* From */}
          <div class="min-w-0">
            <p class="font-display text-lg md:text-xl font-bold text-ocean leading-tight truncate">{from.name}</p>
            {from.terminal && <p class="text-sm text-stone-light truncate">{from.terminal}</p>}
            {from.time && <p class="font-display text-2xl font-bold text-ocean mt-1">{from.time}</p>}
            {from.date && <p class="text-xs text-stone-light">{from.date}</p>}
          </div>

          {/* Middle */}
          <div class="flex flex-col items-center text-center">
            <p class="text-xs text-stone-light">{midLabel}</p>
            <Icon name={midIcon} class="w-6 h-6 text-coral my-1" />
            {middle.duration && <p class="text-sm font-semibold text-coral">{middle.duration}</p>}
            {middle.bookedLabel && <p class="text-xs text-stone-light">{middle.bookedLabel}</p>}
          </div>

          {/* To */}
          <div class="min-w-0 md:text-right">
            <p class="font-display text-lg md:text-xl font-bold text-ocean leading-tight truncate">{to.name}</p>
            {to.terminal && <p class="text-sm text-stone-light truncate">{to.terminal}</p>}
            {to.time && <p class="font-display text-2xl font-bold text-ocean mt-1">{to.time}</p>}
            {to.date && <p class="text-xs text-stone-light">{to.date}</p>}
          </div>
        </div>
      </div>
    </a>

    {/* ── Actions ── */}
    <div class="flex items-stretch gap-3 mt-5 pt-5 border-t border-sand-dark/10">
      <a href={moreInfoHref ?? href}
         class="px-5 py-3 rounded-xl bg-sand text-stone font-semibold text-sm hover:bg-sand-dark/20 transition-colors no-underline flex items-center justify-center">
        {moreInfoText}
      </a>
      <a href={bookHref}
         class="flex-1 px-5 py-3 rounded-xl bg-coral hover:bg-coral-dark text-white font-semibold text-center transition-colors no-underline flex items-center justify-center">
        {bookText}
      </a>
    </div>
  </div>
</article>
