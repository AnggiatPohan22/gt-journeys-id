---
/**
 * CuratedCard — reusable card matching the design of the (formerly)
 * hardcoded "Curated Alternatives" section on each service detail
 * page (Phase 4.16, Pass 1).
 *
 * Ported verbatim from the hardcoded blocks (tour/villa/etc.):
 *   - white bg, rounded-2xl, hover lift + border tint
 *   - h-56 image, object-cover, hover zoom (scale-105, 700ms)
 *   - floating price chip (absolute top-right, white/95 backdrop-blur)
 *   - per-service-type meta line (icons + text tuned per collection)
 *
 * A single component with a `serviceType` switch keeps the exact
 * behaviour of each per-page card while allowing Service Grid's
 * Curated template to reuse it across all 8 services.
 */
import Icon from '@components/common/Icon.astro'
import { formatPrice } from '@shared/utils/format-price'
import type { Media } from '@shared/types/payload-types'

type ServiceType =
  | 'tours'
  | 'accommodations'
  | 'water-activities'
  | 'yachts'
  | 'restaurants'
  | 'venues'
  | 'rentals'
  | 'spa'

interface Props {
  item: any
  serviceType: ServiceType
  hrefBase: string
}

const { item, serviceType, hrefBase } = Astro.props

const asMedia = (v: unknown): Media | null =>
  v && typeof v === 'object' ? (v as Media) : null

const img = asMedia(item.featuredImage)
const imgUrl = img?.sizes?.card?.url ?? img?.url ?? ''
const imgAlt = img?.alt ?? item.title ?? item.name ?? ''
const dest = typeof item.destination === 'object' ? item.destination : null
const title = item.title ?? item.name ?? ''
const href = `${hrefBase}/${item.slug}`

// ── Per-type price computation ─────────────────────────────
let priceStr: string | null = null
let priceSuffix: string = ''
if (serviceType === 'tours' || serviceType === 'water-activities') {
  const p = item?.pricing?.adultPrice
  const c = item?.pricing?.currency ?? 'IDR'
  if (typeof p === 'number' && p > 0) { priceStr = formatPrice(p, c); priceSuffix = '/pax' }
} else if (serviceType === 'accommodations') {
  const rooms = (item.roomTypes ?? []) as any[]
  const min = rooms.map((r) => r.pricePerNight).filter((n): n is number => typeof n === 'number' && n > 0).sort((a, b) => a - b)[0]
  const c = rooms.find((r) => r.pricePerNight === min)?.currency ?? 'IDR'
  if (typeof min === 'number') { priceStr = formatPrice(min, c); priceSuffix = '/nt' }
} else if (serviceType === 'yachts') {
  const pkg = ((item.packages ?? []) as any[]).filter((p) => typeof p.price === 'number' && p.price > 0).sort((a, b) => (a.price ?? 0) - (b.price ?? 0))[0]
  if (pkg) { priceStr = formatPrice(pkg.price, pkg.currency ?? 'IDR'); priceSuffix = '' }
} else if (serviceType === 'rentals' || serviceType === 'spa') {
  const tiers = (item.pricingTiers ?? []) as any[]
  const best = tiers.filter((t) => typeof t.price === 'number' && t.price > 0).sort((a, b) => (a.price ?? 0) - (b.price ?? 0))[0]
  if (best) {
    priceStr = formatPrice(best.price, best.currency ?? 'IDR')
    const durMap: Record<string, string> = { hour: 'hr', day: 'day', night: 'nt', week: 'wk', month: 'mo', session: 'session' }
    priceSuffix = best.duration ? `/${durMap[best.duration] ?? best.duration}` : '/day'
  }
} else if (serviceType === 'restaurants') {
  const rangeMap: Record<string, string> = { budget: '$', mid_range: '$$', upscale: '$$$', fine_dining: '$$$$' }
  priceStr = rangeMap[item.priceRange ?? 'mid_range'] ?? '$$'
  priceSuffix = ''
}
// venues: no price chip (packages typically request-a-quote)

// ── Per-type meta line (below title/destination) ───────────
type Meta = { icon: string; text: string }
const meta: Meta[] = []
if (serviceType === 'tours') {
  if (item.duration)         meta.push({ icon: 'schedule', text: String(item.duration) })
  if (item.maxParticipants)  meta.push({ icon: 'group', text: `Max ${item.maxParticipants}` })
} else if (serviceType === 'accommodations') {
  const rooms = (item.roomTypes ?? []) as any[]
  const guests = rooms.reduce((s, r) => s + (r.maxGuests ?? 0), 0)
  if (rooms.length)          meta.push({ icon: 'villa', text: `${rooms.length} ${rooms.length === 1 ? 'Room' : 'Rooms'}` })
  if (guests)                meta.push({ icon: 'group', text: `${guests} Guests` })
} else if (serviceType === 'water-activities') {
  if (item.duration)         meta.push({ icon: 'schedule', text: String(item.duration) })
} else if (serviceType === 'yachts') {
  if (item.capacity)         meta.push({ icon: 'group', text: `Up to ${item.capacity} guests` })
} else if (serviceType === 'venues') {
  if (item.capacity?.maxGuests) meta.push({ icon: 'group', text: `Up to ${item.capacity.maxGuests} guests` })
} else if (serviceType === 'rentals' || serviceType === 'spa') {
  const spec = item.specifications
  if (spec?.brand)           meta.push({ icon: 'badge', text: `${spec.brand} ${spec.model ?? ''}`.trim() })
}
---

<a
  href={href}
  class="group block bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-transparent hover:border-sand-dark/20 hover:-translate-y-1 no-underline"
>
  <div class="relative h-56 overflow-hidden">
    {imgUrl && (
      <img
        src={imgUrl}
        alt={imgAlt}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      />
    )}
    {priceStr && (
      <div class="absolute top-3 right-3 bg-white/95 backdrop-blur-sm px-3 py-1 rounded-full">
        <span class="text-xs font-semibold text-ocean">
          {priceStr}{priceSuffix && <span class="font-normal text-stone-light">{priceSuffix}</span>}
        </span>
      </div>
    )}
  </div>
  <div class="p-5">
    <h3 class="font-display text-lg text-ocean mb-1 group-hover:text-coral transition-colors">{title}</h3>
    {dest && (
      <p class="text-xs text-stone-light mb-3 flex items-center gap-1">
        <Icon name="location_on" class="w-3 h-3" /> {dest.name}
      </p>
    )}
    {meta.length > 0 && (
      <div class="flex items-center gap-4 text-stone-light text-xs">
        {meta.map((m) => (
          <span class="flex items-center gap-1">
            <Icon name={m.icon} class="w-4 h-4 text-ocean" /> {m.text}
          </span>
        ))}
      </div>
    )}
  </div>
</a>
