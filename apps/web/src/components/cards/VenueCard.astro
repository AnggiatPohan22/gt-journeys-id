---
import type { Venue } from '@shared/types/payload-types'
import { formatPrice } from '@shared/utils/format-price'
import { lexicalToPlainText } from '@lib/lexical'
import DetailedCard from './DetailedCard.astro'
import CardBgLayer from './CardBgLayer.astro'
import type { CardBackground } from '@lib/serviceCards'

interface Props { venue: Venue; hrefBase?: string; variant?: 'compact' | 'detailed'; background?: CardBackground }
const { venue, hrefBase = '/venue', variant = 'compact', background } = Astro.props

const img = typeof venue.featuredImage === 'object' ? venue.featuredImage : null
const imgUrl = img?.sizes?.card?.url ?? img?.url ?? ''
const imgAlt = img?.alt ?? venue.name
const dest = typeof venue.destination === 'object' ? venue.destination : null

const packages = venue.packages ?? []
const cheapest = packages
  .map((p) => p.startingPrice)
  .filter((p): p is number => typeof p === 'number' && p > 0)
  .sort((a, b) => a - b)[0]
const currency = packages.find((p) => p.startingPrice === cheapest)?.currency ?? 'IDR'

const venueTypeLabel: Record<NonNullable<Venue['venueType']>, string> = {
  beach: 'Beach',
  garden: 'Garden',
  cliff: 'Cliff',
  chapel: 'Chapel',
  ballroom: 'Ballroom',
  villa_private: 'Private Villa',
  other: 'Venue',
}

const galleryFromArr = Array.isArray((venue as any).gallery)
  ? (venue as any).gallery.map((g: any) => typeof g?.image === 'object' ? { url: g.image.sizes?.card?.url ?? g.image.url ?? '', alt: g.image.alt } : null).filter((x: any) => x && x.url)
  : []
const detailedImages = [imgUrl ? { url: imgUrl, alt: imgAlt } : null, ...galleryFromArr].filter(Boolean) as { url: string; alt?: string }[]
const detailedDescription = (venue as any).subtitle ?? ((venue as any).description ? lexicalToPlainText((venue as any).description).slice(0, 160) : '')
const detailedAmenities = Array.isArray((venue as any).features)
  ? (venue as any).features.slice(0, 4).map((f: any) => ({ name: f.name, icon: f.icon }))
  : []
const capacityText = venue.capacity && (venue.capacity.minGuests || venue.capacity.maxGuests)
  ? `Capacity: ${venue.capacity.minGuests ?? '?'}–${venue.capacity.maxGuests ?? '?'} guests`
  : undefined
---

{variant === 'detailed' ? (
  <DetailedCard
    href={`${hrefBase}/${venue.slug}`}
    images={detailedImages}
    badge={venue.venueType ? venueTypeLabel[venue.venueType] : undefined}
    eyebrow={dest?.name}
    title={venue.name}
    description={detailedDescription || capacityText}
    amenities={detailedAmenities}
    price={cheapest ? { value: cheapest, currency, unit: 'starting package' } : undefined}
    bookText="Enquire"
    background={background}
  />
) : (
<article class="group relative bg-white rounded-xl overflow-hidden border border-sand-dark/10 hover:shadow-lg transition-shadow duration-300">
  <CardBgLayer background={background} />
  <a href={`${hrefBase}/${venue.slug}`} class="relative block no-underline text-current">
    <div class="relative aspect-[4/3] overflow-hidden bg-sand">
      {imgUrl ? (
        <img src={imgUrl} alt={imgAlt} loading="lazy"
             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
      ) : (
        <div class="w-full h-full flex items-center justify-center text-stone-light text-sm">No image</div>
      )}
      {venue.venueType && (
        <span class="absolute top-3 left-3 px-2.5 py-1 bg-white/95 text-ocean text-xs font-semibold uppercase tracking-wider rounded">
          {venueTypeLabel[venue.venueType]}
        </span>
      )}
    </div>
    <div class="p-5">
      {dest && <p class="text-xs uppercase tracking-wider text-leaf mb-2">{dest.name}</p>}
      <h3 class="font-display text-xl text-ocean mb-2 line-clamp-2 group-hover:text-coral transition-colors">
        {venue.name}
      </h3>
      {venue.capacity && (venue.capacity.minGuests || venue.capacity.maxGuests) && (
        <p class="text-xs text-stone-light mb-3">
          Capacity: {venue.capacity.minGuests ?? '?'}–{venue.capacity.maxGuests ?? '?'} guests
        </p>
      )}
      <div class="flex items-center justify-between pt-3 border-t border-sand-dark/10">
        {cheapest ? (
          <div>
            <p class="text-coral font-semibold">{formatPrice(cheapest, currency)}</p>
            <p class="text-xs text-stone-light font-normal">starting package</p>
          </div>
        ) : <span class="text-xs text-stone-light">Contact for quote</span>}
        {packages.length > 0 && (
          <span class="text-xs text-stone whitespace-nowrap">{packages.length} {packages.length === 1 ? 'package' : 'packages'}</span>
        )}
      </div>
    </div>
  </a>
</article>
)}
