---
import type { Restaurant } from '@shared/types/payload-types'
import { lexicalToPlainText } from '@lib/lexical'
import DetailedCard from './DetailedCard.astro'
import CardBgLayer from './CardBgLayer.astro'
import type { CardBackground } from '@lib/serviceCards'

interface Props { restaurant: Restaurant; hrefBase?: string; variant?: 'compact' | 'detailed'; background?: CardBackground }
const { restaurant, hrefBase = '/restaurant', variant = 'compact', background } = Astro.props

const img = typeof restaurant.featuredImage === 'object' ? restaurant.featuredImage : null
const imgUrl = img?.sizes?.card?.url ?? img?.url ?? ''
const imgAlt = img?.alt ?? restaurant.name
const dest = typeof restaurant.destination === 'object' ? restaurant.destination : null

const priceRangeLabel: Record<NonNullable<Restaurant['priceRange']>, string> = {
  budget: '$',
  mid_range: '$$',
  fine_dining: '$$$',
}

const cuisines = restaurant.cuisineType ?? []
const cuisineLabel: Record<string, string> = {
  indonesian: 'Indonesian',
  western: 'Western',
  seafood: 'Seafood',
  fusion: 'Fusion',
  japanese: 'Japanese',
  italian: 'Italian',
  cafe: 'Café',
  bar: 'Bar',
}

const galleryFromArr = Array.isArray((restaurant as any).gallery)
  ? (restaurant as any).gallery.map((g: any) => typeof g?.image === 'object' ? { url: g.image.sizes?.card?.url ?? g.image.url ?? '', alt: g.image.alt } : null).filter((x: any) => x && x.url)
  : []
const detailedImages = [imgUrl ? { url: imgUrl, alt: imgAlt } : null, ...galleryFromArr].filter(Boolean) as { url: string; alt?: string }[]
const detailedDescription = (restaurant as any).subtitle ?? ((restaurant as any).description ? lexicalToPlainText((restaurant as any).description).slice(0, 160) : '')
const detailedAmenities = Array.isArray((restaurant as any).features)
  ? (restaurant as any).features.slice(0, 4).map((f: any) => ({ name: f.name, icon: f.icon }))
  : cuisines.slice(0, 4).map((c: any) => ({ name: cuisineLabel[c] ?? c }))
---

{variant === 'detailed' ? (
  <DetailedCard
    href={`${hrefBase}/${restaurant.slug}`}
    images={detailedImages}
    badge={restaurant.priceRange ? priceRangeLabel[restaurant.priceRange] : undefined}
    eyebrow={dest?.name}
    title={restaurant.name}
    description={detailedDescription}
    amenities={detailedAmenities}
    bookText="Reserve"
    background={background}
  />
) : (
<article class="group relative bg-white rounded-xl overflow-hidden border border-sand-dark/10 hover:shadow-lg transition-shadow duration-300">
  <CardBgLayer background={background} />
  <a href={`${hrefBase}/${restaurant.slug}`} class="relative block no-underline text-current">
    <div class="relative aspect-[4/3] overflow-hidden bg-sand">
      {imgUrl ? (
        <img src={imgUrl} alt={imgAlt} loading="lazy"
             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
      ) : (
        <div class="w-full h-full flex items-center justify-center text-stone-light text-sm">No image</div>
      )}
      {restaurant.priceRange && (
        <span class="absolute top-3 right-3 px-2.5 py-1 bg-white/95 text-ocean text-xs font-semibold rounded">
          {priceRangeLabel[restaurant.priceRange]}
        </span>
      )}
    </div>
    <div class="p-5">
      {dest && <p class="text-xs uppercase tracking-wider text-leaf mb-2">{dest.name}</p>}
      <h3 class="font-display text-xl text-ocean mb-2 line-clamp-2 group-hover:text-coral transition-colors">
        {restaurant.name}
      </h3>
      {cuisines.length > 0 && (
        <p class="text-xs text-stone-light mb-3">
          {cuisines.map((c) => cuisineLabel[c] ?? c).join(' · ')}
        </p>
      )}
    </div>
  </a>
</article>
)}
