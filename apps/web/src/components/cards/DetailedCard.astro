---
import Icon from '@components/common/Icon.astro'
import { formatPrice } from '@shared/utils/format-price'
import CardBgLayer from './CardBgLayer.astro'
import type { CardBackground } from '@lib/serviceCards'

interface Amenity {
  name: string
  icon?: string
}
interface GalleryImg {
  url: string
  alt?: string
}
interface Props {
  href: string
  images: GalleryImg[]
  badge?: string
  eyebrow?: string
  title: string
  rating?: number
  description?: string
  amenities?: Amenity[]
  price?: { value: number; currency: string; unit?: string }
  bookText?: string
  background?: CardBackground
}

const {
  href,
  images,
  badge,
  eyebrow,
  title,
  rating,
  description,
  amenities = [],
  price,
  bookText = 'Book Now',
  background,
} = Astro.props

const galleryImages = images.filter((i) => i.url)
const primary = galleryImages[0]
const hasMultiple = galleryImages.length > 1
const cardId = `dc-${Math.random().toString(36).slice(2, 9)}`
---

<article class="group relative bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col">
  <CardBgLayer background={background} />
  {/* Image / slider */}
  <div class="relative aspect-[4/3] bg-sand overflow-hidden" data-role="dc-slider" data-card-id={cardId}>
    {galleryImages.length > 0 ? (
      galleryImages.map((img, idx) => (
        <img
          src={img.url}
          alt={img.alt ?? title}
          loading="lazy"
          data-slide-idx={idx}
          class:list={[
            'absolute inset-0 w-full h-full object-cover transition-opacity duration-500',
            idx === 0 ? 'opacity-100' : 'opacity-0',
          ]}
        />
      ))
    ) : (
      <div class="w-full h-full flex items-center justify-center text-stone-light text-sm">
        No image
      </div>
    )}

    {badge && (
      <span class="absolute top-3 left-3 z-10 px-3 py-1 bg-white/95 backdrop-blur-sm text-ocean text-[10px] font-bold uppercase tracking-widest rounded-full shadow">
        {badge}
      </span>
    )}

    <button
      type="button"
      class="absolute top-3 right-3 z-10 w-8 h-8 rounded-full bg-white/90 hover:bg-white shadow flex items-center justify-center text-stone hover:text-coral transition-colors"
      aria-label="Favorite"
      onclick="event.preventDefault(); event.stopPropagation();"
    >
      <Icon name="favorite" class="w-4 h-4" />
    </button>

    {hasMultiple && (
      <div class="absolute bottom-3 left-1/2 -translate-x-1/2 z-10 flex gap-1.5" data-role="dc-dots" data-card-id={cardId}>
        {galleryImages.map((_, idx) => (
          <button
            type="button"
            aria-label={`Image ${idx + 1}`}
            data-dot-idx={idx}
            data-active={idx === 0 ? 'true' : 'false'}
            class="w-2 h-2 rounded-full bg-white/60 transition-all data-[active=true]:bg-white data-[active=true]:w-6"
            onclick="event.preventDefault(); event.stopPropagation();"
          ></button>
        ))}
      </div>
    )}
  </div>

  {/* Body */}
  <a href={href} class="relative flex-1 flex flex-col p-5 no-underline text-current">
    {eyebrow && (
      <p class="text-[10px] uppercase tracking-widest text-leaf mb-1 font-semibold">{eyebrow}</p>
    )}

    <div class="flex items-start justify-between gap-3 mb-2">
      <h3 class="font-display text-lg text-ocean line-clamp-2 group-hover:text-coral transition-colors flex-1">
        {title}
      </h3>
      {rating && (
        <span class="shrink-0 flex items-center gap-0.5 text-coral text-sm">
          {Array.from({ length: Math.max(1, Math.min(5, Math.round(rating))) }).map(() => <span>★</span>)}
        </span>
      )}
    </div>

    {description && (
      <p class="text-sm text-stone-light line-clamp-2 mb-4">{description}</p>
    )}

    {amenities.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-4">
        {amenities.slice(0, 4).map((a) => (
          <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-sand text-stone rounded-full text-[11px]">
            {a.icon && <Icon name={a.icon} class="w-3 h-3 text-leaf" />}
            <span>{a.name}</span>
          </span>
        ))}
      </div>
    )}

    <div class="mt-auto pt-3 border-t border-sand-dark/10 flex items-center justify-between gap-3">
      {price ? (
        <div>
          <p class="text-coral font-bold text-lg leading-tight">{formatPrice(price.value, price.currency)}</p>
          {price.unit && <p class="text-[11px] text-stone-light">{price.unit}</p>}
        </div>
      ) : (
        <span class="text-xs text-stone-light">Contact for rates</span>
      )}
      <span class="inline-flex items-center gap-1 px-4 py-2 bg-coral hover:bg-coral-dark text-white text-xs font-semibold rounded-full transition-colors shadow-sm">
        {bookText}
      </span>
    </div>
  </a>
</article>

<script>
  const initDetailedCards = () => {
    const sliders = document.querySelectorAll<HTMLElement>('[data-role="dc-slider"][data-card-id]')
    sliders.forEach((slider) => {
      const id = slider.dataset.cardId!
      const slides = slider.querySelectorAll<HTMLElement>('[data-slide-idx]')
      if (slides.length <= 1) return
      const dotsWrap = document.querySelector<HTMLElement>(`[data-role="dc-dots"][data-card-id="${id}"]`)
      const dots = dotsWrap?.querySelectorAll<HTMLButtonElement>('[data-dot-idx]') ?? []
      let active = 0
      const setActive = (i: number) => {
        active = ((i % slides.length) + slides.length) % slides.length
        slides.forEach((s, idx) => s.classList.toggle('opacity-0', idx !== active))
        slides.forEach((s, idx) => s.classList.toggle('opacity-100', idx === active))
        dots.forEach((d, idx) => d.setAttribute('data-active', idx === active ? 'true' : 'false'))
      }
      dots.forEach((d) => {
        d.addEventListener('click', (e) => {
          e.preventDefault()
          e.stopPropagation()
          setActive(Number(d.dataset.dotIdx))
        })
      })
    })
  }
  document.addEventListener('astro:page-load', initDetailedCards)
  initDetailedCards()
</script>
