---
import type { Page, Media } from '@shared/types/payload-types'
import { resolvePadding as resolveBlockPadding, resolveColorValue } from '@lib/blockStyles'

type Block = Extract<NonNullable<Page['content']>[number], { blockType: 'hero' }>
interface Props { block: Block }
const { block } = Astro.props

// New fields (imageFit, imagePosition, contentAlignment, containerWidth,
// entryAnimation, per-slide fit/position) belum tentu ada di generated types
// sampai `pnpm generate:types` dijalankan setelah CMS schema push. Pakai
// loose cast supaya frontend tetap kompilasi.
const b = block as any

// Text style resolution — pakai shared `resolveColorValue` helper dari
// blockStyles.ts (dual-mode token slug/hex).
const ts = b.ts ?? {}
const HEX_RE = /^#([0-9a-fA-F]{3,8})$/
const headingRes = resolveColorValue(ts.headingColor, 'text')
const subheadingRes = resolveColorValue(ts.subheadingColor, 'text')
// Hex color perlu di-set via CSS var supaya menang atas
// `.hero-block h1 { color: var(--hero-heading-color, white) !important }`.
const headingHexStyle = ts.headingColor && HEX_RE.test(String(ts.headingColor))
  ? `--hero-heading-color:${ts.headingColor};color:${ts.headingColor}`
  : headingRes.style
const headingAnim = ts.headingAnimIn && ts.headingAnimIn !== 'inherit' && ts.headingAnimIn !== 'none' ? `text-anim-${ts.headingAnimIn}` : ''
const subheadingAnim = ts.subheadingAnimIn && ts.subheadingAnimIn !== 'inherit' && ts.subheadingAnimIn !== 'none' ? `text-anim-${ts.subheadingAnimIn}` : ''

// ── Media resolution ─────────────────────────────────────────
const mediaType = block.mediaType ?? 'single'

const asMedia = (v: unknown): Media | null =>
  v && typeof v === 'object' ? (v as Media) : null

const singleImg = asMedia(block.singleImage)

const sliderImages = (block.imageSlider ?? [])
  .map((s: any) => ({
    media: asMedia(s.image),
    fit: s.imageFit ?? 'cover',
    pos: s.imagePosition ?? 'center',
    caption: s.caption,
  }))
  .filter((s: any): s is { media: Media; fit: string; pos: string; caption?: string } => !!s.media)

const videoPoster = asMedia(block.videoPoster)
const videoFile = asMedia(block.videoFile)
const videoUrl = block.videoUrl ?? ''
const videoOpts = block.videoOptions ?? {}

// ── Image fit + position (Tailwind object-* classes) ─────────
const fitClassMap: Record<string, string> = {
  cover: 'object-cover',
  contain: 'object-contain',
  fill: 'object-fill',
  'scale-down': 'object-scale-down',
}
const posClassMap: Record<string, string> = {
  'top-left': 'object-left-top',
  top: 'object-top',
  'top-right': 'object-right-top',
  left: 'object-left',
  center: 'object-center',
  right: 'object-right',
  'bottom-left': 'object-left-bottom',
  bottom: 'object-bottom',
  'bottom-right': 'object-right-bottom',
}
const fitClass = (v?: string) => fitClassMap[v ?? 'cover'] ?? 'object-cover'
const posClass = (v?: string) => posClassMap[v ?? 'center'] ?? 'object-center'

const singleFit = fitClass(b.imageFit)
const singlePos = posClass(b.imagePosition)

// Detect YouTube / Vimeo for embed iframe
type EmbedInfo = { kind: 'youtube' | 'vimeo' | 'file'; src: string }
const parseVideo = (url: string, opts: typeof videoOpts): EmbedInfo | null => {
  if (!url) return null
  const params = new URLSearchParams({
    autoplay: opts.autoplay === false ? '0' : '1',
    mute: opts.muted === false ? '0' : '1',
    loop: opts.loop === false ? '0' : '1',
    controls: opts.controls ? '1' : '0',
  })
  const yt = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)([\w-]{11})/)
  if (yt) {
    const id = yt[1]
    const p = new URLSearchParams({
      autoplay: opts.autoplay === false ? '0' : '1',
      mute: opts.muted === false ? '0' : '1',
      loop: opts.loop === false ? '0' : '1',
      playlist: id,
      controls: opts.controls ? '1' : '0',
      modestbranding: '1',
      rel: '0',
    })
    return { kind: 'youtube', src: `https://www.youtube.com/embed/${id}?${p}` }
  }
  const vm = url.match(/vimeo\.com\/(?:video\/)?(\d+)/)
  if (vm) {
    return { kind: 'vimeo', src: `https://player.vimeo.com/video/${vm[1]}?${params}&background=1` }
  }
  return { kind: 'file', src: url }
}

const embedInfo =
  mediaType === 'video' && (block.videoSource === 'url' ? videoUrl : videoFile?.url)
    ? parseVideo(block.videoSource === 'url' ? videoUrl : (videoFile?.url ?? ''), videoOpts)
    : null

const heroImageUrl = mediaType === 'single' ? (singleImg?.sizes?.hero?.url ?? singleImg?.url ?? '') : ''
const heroImageAlt = singleImg?.alt ?? block.heading ?? ''

const posterUrl = videoPoster?.sizes?.hero?.url ?? videoPoster?.url ?? ''
const posterAlt = videoPoster?.alt ?? block.heading ?? ''

// ── Advanced styling resolution ──────────────────────────────
// Phase 4.24 — Hero opt-out from unified block padding system. Viewport
// min-height + flex-center drives Hero's vertical rhythm, adding pt/pb
// would double-count. Editor can still set sectionPadding preset (compact/
// spacious) if they want explicit padding on top of viewport height —
// falsy default = no extra padding.
const heroPaddingRaw = block.sectionPadding ? resolveBlockPadding(block.sectionPadding) : ''
const paddingClass = `${heroPaddingRaw} min-h-[calc(100vh-5rem)]`

const contentAlignment = (b.contentAlignment ?? 'center') as 'left' | 'center' | 'right'
const alignTextClass =
  contentAlignment === 'left' ? 'text-left' :
  contentAlignment === 'right' ? 'text-right' :
                                 'text-center'
const alignMarginClass =
  contentAlignment === 'left' ? 'mr-auto ml-0' :
  contentAlignment === 'right' ? 'ml-auto mr-0' :
                                 'mx-auto'
const alignFlexClass =
  contentAlignment === 'left' ? 'items-start' :
  contentAlignment === 'right' ? 'items-end' :
                                 'items-center'

const containerWidth = (b.containerWidth ?? 'normal') as 'full' | 'wide' | 'normal' | 'narrow'
const containerClass =
  containerWidth === 'full'   ? 'w-full px-4 sm:px-6 lg:px-8' :
  containerWidth === 'wide'   ? 'w-full max-w-7xl px-4 sm:px-6 lg:px-8' :
  containerWidth === 'narrow' ? 'w-full max-w-3xl px-4 sm:px-6 lg:px-8' :
                                'w-full max-w-5xl px-4 sm:px-6 lg:px-8'

const entryAnimation = (b.entryAnimation ?? 'reveal') as string
// Map to data-animate value. `reveal` = default GSAP fade-up. Fallbacks:
// - fade / zoom / slide-left / slide-right diimplementasi via CSS di
//   `<style>` bawah supaya tidak bergantung GSAP preset (yg mungkin belum
//   ada). 'reveal' tetap pakai existing data-animate.
const useDataAnimate = entryAnimation === 'reveal'
const entryClass = !useDataAnimate && entryAnimation !== 'none' ? `entry-${entryAnimation}` : ''

const bg = block.background ?? {}
const bgType = bg.type ?? 'default'
// Phase 4.55 — bg color dual-mode. Fallback ocean bila default/kosong.
const bgRes = bgType === 'color' && bg.color
  ? resolveColorValue(bg.color as string, 'bg')
  : { className: 'bg-ocean', style: '' }
const sectionBgClass = bgRes.className || (bgRes.style ? '' : 'bg-ocean')
const sectionBgStyle = bgRes.style
const overlayOpacity = ((bg.overlayOpacity ?? 40) / 100)
const bgImg = asMedia(bg.image)
const bgImgUrl = bgImg?.sizes?.hero?.url ?? bgImg?.url ?? ''

// Button resolution (Phase 4.55 — dual-mode color)
const btn = block.button ?? {}
const btnVariant = btn.variant ?? 'solid'
const btnColorRaw = (btn.color ?? 'coral') as string
const btnRadius = btn.radius ?? 'rounded'
const btnHover = btn.hoverAnimation ?? 'scale'
const btnTextColorRaw = (btn.textColor ?? 'default') as string

// Auto-contrast helper untuk solid variant tanpa textColor manual.
const autoContrastFor = (v: string): { className: string; style: string } => {
  if (HEX_RE.test(v)) {
    // Sederhana: hex terang → teks ocean; gelap → teks putih.
    const hex = v.slice(1)
    const r = parseInt(hex.substring(0, 2) || '0', 16)
    const g = parseInt(hex.substring(2, 4) || '0', 16)
    const b = parseInt(hex.substring(4, 6) || '0', 16)
    const luma = (0.299 * r + 0.587 * g + 0.114 * b) / 255
    return luma > 0.7 ? { className: 'text-ocean', style: '' } : { className: 'text-white', style: '' }
  }
  return ['white', 'sand'].includes(v)
    ? { className: 'text-ocean', style: '' }
    : { className: 'text-white', style: '' }
}

const btnRadiusClass =
  btnRadius === 'sharp' ? 'rounded-none' :
  btnRadius === 'pill'  ? 'rounded-full' :
                          'rounded-lg'
const btnHoverClass =
  btnHover === 'fade'      ? 'hover:opacity-80' :
  btnHover === 'underline' ? 'hover:underline underline-offset-4' :
  btnHover === 'none'      ? '' :
                             'hover:scale-105'

const btnBaseClasses = ['inline-flex items-center gap-2 px-8 py-4 font-semibold no-underline transition-all', btnRadiusClass, btnHoverClass]

// Build class list + inline style. Style dipisah supaya bisa di-inject
// ke `style` attribute (hex path) tanpa mengganggu Tailwind class (token).
let btnClasses: string[] = [...btnBaseClasses]
let btnStyle = ''

const btnBgRes = resolveColorValue(btnColorRaw, 'bg')
const btnBorderRes = resolveColorValue(btnColorRaw, 'border')
const btnTxtRes = resolveColorValue(btnColorRaw, 'text')

if (btnVariant === 'ghost') {
  btnClasses.push(btnTxtRes.className, 'hover:bg-white/10')
  if (btnTxtRes.style) btnStyle = btnTxtRes.style
} else if (btnVariant === 'outline') {
  btnClasses.push('border-2', btnBorderRes.className, btnTxtRes.className)
  const styleParts: string[] = []
  if (btnBorderRes.style) styleParts.push(btnBorderRes.style)
  if (btnTxtRes.style)    styleParts.push(btnTxtRes.style)
  btnStyle = styleParts.join(';')
  // Note: hover state utk hex path pakai class fallback (skip auto-hover
  // fill utk hex custom — editor bisa custom lewat CSS layer nanti kalau perlu).
  if (!btnBgRes.style) btnClasses.push(`hover:${btnBgRes.className}`, 'hover:text-white')
} else {
  // Solid: bg = button color, text = textColor override kalau ada, else auto contrast.
  btnClasses.push(btnBgRes.className)
  const styleParts: string[] = []
  if (btnBgRes.style) styleParts.push(btnBgRes.style)

  if (btnTextColorRaw && btnTextColorRaw !== 'default') {
    const btnTxtOverride = resolveColorValue(btnTextColorRaw, 'text')
    btnClasses.push(btnTxtOverride.className)
    if (btnTxtOverride.style) styleParts.push(btnTxtOverride.style)
  } else {
    const auto = autoContrastFor(btnColorRaw)
    btnClasses.push(auto.className)
    if (auto.style) styleParts.push(auto.style)
  }
  btnStyle = styleParts.join(';')
}

const hasMedia = (mediaType === 'single' && heroImageUrl) ||
                 (mediaType === 'multiple' && sliderImages.length > 0) ||
                 (mediaType === 'video' && embedInfo)

const showBgImage = bgType === 'image' && bgImgUrl
const showOverlay = hasMedia || showBgImage
---

<section
  class:list={[
    'hero-block relative overflow-hidden flex flex-col justify-center',
    alignFlexClass,
    // Full-bleed rule: Hero SELALU edge-to-edge viewport.
    'w-screen relative left-1/2 right-1/2 -mx-[50vw]',
    paddingClass,
  ]}
>
  <!-- BASE BG -->
  <div class:list={['absolute inset-0 z-0', sectionBgClass]} style={sectionBgStyle || undefined}></div>

  <!-- BG image (Advanced tab override) -->
  {showBgImage && (
    <div class="absolute inset-0 z-[1]">
      <img src={bgImgUrl} alt="" class="w-full h-full object-cover object-center" loading="eager" />
    </div>
  )}

  <!-- MEDIA layer -->
  {mediaType === 'single' && heroImageUrl && (
    <div class="absolute inset-0 z-[1]">
      <img src={heroImageUrl} alt={heroImageAlt} class:list={['w-full h-full', singleFit, singlePos]} loading="eager" fetchpriority="high" />
    </div>
  )}

  {mediaType === 'multiple' && sliderImages.length > 0 && (
    <div
      class="absolute inset-0 z-[1] hero-slider"
      data-transition={block.imageTransition ?? 'fade'}
      data-interval={block.transitionInterval ?? 5}
      data-autostart={(b.sliderAutoStart ?? false) ? 'true' : 'false'}
    >
      {sliderImages.map((s: any, i: number) => {
        const url = s.media.sizes?.hero?.url ?? s.media.url ?? ''
        return (
          <img
            src={url}
            alt={s.media.alt ?? ''}
            class:list={['absolute inset-0 w-full h-full hero-slide', fitClass(s.fit), posClass(s.pos), i === 0 && 'is-active']}
            data-idx={i}
            loading="eager"
            fetchpriority={i === 0 ? 'high' : undefined}
          />
        )
      })}
    </div>
  )}

  {mediaType === 'video' && embedInfo && (
    <div class="absolute inset-0 z-[1]">
      {posterUrl && (
        <img src={posterUrl} alt={posterAlt} class:list={['absolute inset-0 w-full h-full', singleFit, singlePos]} loading="eager" />
      )}
      {embedInfo.kind === 'file' ? (
        <video
          class:list={['absolute inset-0 w-full h-full', singleFit, singlePos]}
          src={embedInfo.src}
          poster={posterUrl || undefined}
          autoplay={videoOpts.autoplay !== false}
          muted={videoOpts.muted !== false}
          loop={videoOpts.loop !== false}
          controls={videoOpts.controls === true}
          playsinline
        />
      ) : (
        <iframe
          class="absolute inset-0 w-full h-full pointer-events-none"
          style="width:100vw;height:56.25vw;min-height:100%;min-width:177.77vh;left:50%;top:50%;transform:translate(-50%,-50%);"
          src={embedInfo.src}
          allow="autoplay; encrypted-media"
          allowfullscreen
          frameborder="0"
        ></iframe>
      )}
    </div>
  )}

  <!-- OVERLAY -->
  {showOverlay && (
    <div class="absolute inset-0 z-[2] bg-black" style={`opacity:${overlayOpacity}`}></div>
  )}

  <!-- CONTENT -->
  <div class:list={['relative z-10', containerClass, alignTextClass, alignMarginClass, entryClass]}>
    <h1
      class:list={['font-display text-4xl md:text-6xl lg:text-7xl font-bold max-w-4xl text-white drop-shadow-lg', alignMarginClass, headingRes.className, headingAnim]}
      style={headingHexStyle || undefined}
      data-animate={useDataAnimate && !headingAnim ? 'reveal' : undefined}
    >
      {block.heading}
    </h1>
    {block.subheading && (
      <p
        class:list={['mt-6 text-lg md:text-xl text-white/90 max-w-2xl drop-shadow', alignMarginClass, subheadingRes.className, subheadingAnim]}
        style={subheadingRes.style || undefined}
        data-animate={useDataAnimate && !subheadingAnim ? 'reveal' : undefined}
      >
        {block.subheading}
      </p>
    )}
    {block.ctaText && block.ctaLink && (
      <div class="mt-10" data-animate={useDataAnimate ? 'reveal' : undefined}>
        <a href={block.ctaLink} class:list={btnClasses} style={btnStyle || undefined}>
          {block.ctaText}
        </a>
      </div>
    )}
  </div>
</section>

<style>
  /* Force white heading dalam hero — override global.css h1 color:ocean.
     Phase 4.55 — pakai CSS var supaya inline style hex bisa override lewat
     `--hero-heading-color` (di-set di element saat editor pilih custom hex). */
  .hero-block h1,
  .hero-block h2,
  .hero-block h3 {
    color: var(--hero-heading-color, white) !important;
  }

  /* ── Slider transitions ────────────────────────────────── */
  .hero-slider .hero-slide {
    opacity: 0;
    transition: opacity 900ms ease, transform 6s ease, filter 900ms ease, clip-path 1100ms cubic-bezier(0.77, 0, 0.175, 1);
    z-index: 0;
  }
  .hero-slider .hero-slide.is-active {
    opacity: 1;
    z-index: 1;
  }

  /* Slide (horizontal) */
  .hero-slider[data-transition="slide"] .hero-slide { transform: translateX(30px); }
  .hero-slider[data-transition="slide"] .hero-slide.is-active { transform: translateX(0); }

  /* Zoom (Ken Burns) */
  .hero-slider[data-transition="zoom"] .hero-slide { transform: scale(1); }
  .hero-slider[data-transition="zoom"] .hero-slide.is-active { transform: scale(1.08); }

  /* Blur — cinematic crossfade */
  .hero-slider[data-transition="blur"] .hero-slide { filter: blur(20px); }
  .hero-slider[data-transition="blur"] .hero-slide.is-active { filter: blur(0); }

  /* Wipe — curtain reveal from left */
  .hero-slider[data-transition="wipe"] .hero-slide { clip-path: inset(0 100% 0 0); opacity: 1; }
  .hero-slider[data-transition="wipe"] .hero-slide.is-active { clip-path: inset(0 0 0 0); }

  /* Parallax — subtle vertical rise with fade */
  .hero-slider[data-transition="parallax"] .hero-slide { transform: translateY(30px); }
  .hero-slider[data-transition="parallax"] .hero-slide.is-active { transform: translateY(0); }

  /* None (instant) */
  .hero-slider[data-transition="none"] .hero-slide { transition: none; }

  @media (prefers-reduced-motion: reduce) {
    .hero-slider .hero-slide {
      transition: none;
      transform: none !important;
      filter: none !important;
      clip-path: none !important;
    }
  }

  /* ── Entry animations (CSS-only, tanpa dep GSAP) ─────────
     'reveal' pakai data-animate GSAP existing. Preset lain via keyframes. */
  .entry-fade,
  .entry-zoom,
  .entry-slide-left,
  .entry-slide-right {
    animation-duration: 900ms;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    animation-fill-mode: both;
  }
  .entry-fade      { animation-name: entryFade; }
  .entry-zoom      { animation-name: entryZoom; }
  .entry-slide-left  { animation-name: entrySlideLeft; }
  .entry-slide-right { animation-name: entrySlideRight; }

  @keyframes entryFade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes entryZoom {
    from { opacity: 0; transform: scale(0.92); }
    to   { opacity: 1; transform: scale(1); }
  }
  @keyframes entrySlideLeft {
    from { opacity: 0; transform: translateX(-40px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  @keyframes entrySlideRight {
    from { opacity: 0; transform: translateX(40px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .entry-fade,
    .entry-zoom,
    .entry-slide-left,
    .entry-slide-right {
      animation: none;
    }
  }
</style>

<script>
  const initHeroSliders = () => {
    document.querySelectorAll<HTMLElement>('.hero-slider').forEach((slider) => {
      const slides = Array.from(slider.querySelectorAll<HTMLElement>('.hero-slide'))
      if (slides.length < 2) return
      const intervalSec = Number(slider.dataset.interval ?? 5)
      const intervalMs = Math.max(2000, intervalSec * 1000)
      const autoStart = slider.dataset.autostart === 'true'
      let current = 0
      const advance = () => {
        slides[current].classList.remove('is-active')
        current = (current + 1) % slides.length
        slides[current].classList.add('is-active')
      }
      // autoStart = fire first transition immediately on load, then interval.
      // default = wait full interval before first transition.
      if (autoStart) {
        // Delay minimal supaya layout paint dulu (100ms), lalu langsung advance.
        setTimeout(advance, 100)
      }
      setInterval(advance, intervalMs)
    })
  }
  document.addEventListener('astro:page-load', initHeroSliders)
  initHeroSliders()
</script>
