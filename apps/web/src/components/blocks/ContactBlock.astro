---
import type { Page } from '@shared/types/payload-types'
import { siteConfig } from '@config/site'
import { lexicalToHtml } from '@lib/lexical'
import {
  resolveAlignment, resolveContainer, resolvePadding, resolvePaddingOverrideStyle,
  resolveEntryAnimation, resolveBackground,
  resolveTextColor, resolveTextAnimIn,
} from '@lib/blockStyles'

type Block = Extract<NonNullable<Page['content']>[number], { blockType: 'contact' }>
interface Props { block: Block }
const { block } = Astro.props

const b = block as any

const showMap = block.showMap ?? true
const showWa = block.showWhatsApp ?? true
const additionalHtml = block.additionalText ? lexicalToHtml(block.additionalText) : ''

const waNumber = siteConfig.contact.whatsapp.replace(/\D/g, '')
const email = siteConfig.contact.email
const phone = siteConfig.contact.phone
const address = siteConfig.contact.address

const align = resolveAlignment(b.contentAlignment ?? 'left')
const containerClass = resolveContainer(b.containerWidth)
const paddingClass = resolvePadding(b)
const padOverrideStyle = resolvePaddingOverrideStyle(b)
const entry = resolveEntryAnimation(b.entryAnimation, b.entryAnimationSpeed, b.entryAnimationDurationMs)
const bgResolved = resolveBackground(b.background)

const ts = b.ts ?? {}
const pColor = resolveTextColor(ts.paragraphColor)
const pAnim = resolveTextAnimIn(ts.paragraphAnimIn)
---

<section class:list={['relative overflow-hidden', paddingClass, bgResolved.bgClass]} data-animate={entry.dataAnimate} style={[padOverrideStyle, entry.style].filter(Boolean).join(";") || undefined}>
  {bgResolved.imageUrl && (
    <>
      <img src={bgResolved.imageUrl} alt="" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
      <div class="absolute inset-0 bg-black" style={`opacity:${bgResolved.overlayOpacity}`}></div>
    </>
  )}
  <div class:list={['relative z-10 mx-auto grid lg:grid-cols-2 gap-10 items-start', containerClass, entry.className]}>
    <div class={align.text}>
      <h2 class="font-display text-3xl md:text-4xl text-ocean mb-6">Get in Touch</h2>

      <dl class="space-y-4 text-sm">
        {email && (
          <div>
            <dt class="text-xs uppercase tracking-wider text-stone-light">Email</dt>
            <dd><a href={`mailto:${email}`} class="text-ocean hover:text-coral">{email}</a></dd>
          </div>
        )}
        {phone && (
          <div>
            <dt class="text-xs uppercase tracking-wider text-stone-light">Phone</dt>
            <dd><a href={`tel:${phone}`} class="text-ocean hover:text-coral">{phone}</a></dd>
          </div>
        )}
        {address && (
          <div>
            <dt class="text-xs uppercase tracking-wider text-stone-light">Address</dt>
            <dd class="text-stone">{address}</dd>
          </div>
        )}
      </dl>

      {additionalHtml && (
        <div class:list={['mt-6 rich-text text-sm', pColor, pAnim]} set:html={additionalHtml}></div>
      )}

      {showWa && (
        <a href={`https://wa.me/${waNumber}`} target="_blank" rel="noopener noreferrer"
           class="mt-6 inline-flex items-center gap-2 px-6 py-3 bg-[#25D366] hover:bg-[#1DA851] text-white font-semibold rounded-lg no-underline transition-colors">
          Chat on WhatsApp
        </a>
      )}
    </div>

    {showMap && (
      <div class="aspect-video bg-sand rounded-xl flex items-center justify-center text-stone-light text-sm">
        Map placeholder
        <span class="sr-only">(Site-level map embed lives in CMS Site Settings.)</span>
      </div>
    )}
  </div>
</section>
