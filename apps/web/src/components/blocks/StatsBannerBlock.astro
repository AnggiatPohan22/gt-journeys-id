---
import type { Page } from '@shared/types/payload-types'
import Icon from '@components/common/Icon.astro'
import {
  resolveContainer, resolvePadding, resolvePaddingOverrideStyle,
  resolveEntryAnimation,
  resolveTextColor, resolveTextAnimIn,
} from '@lib/blockStyles'

type Block = Extract<NonNullable<Page['content']>[number], { blockType: 'statsBanner' }>
interface Props { block: Block }
const { block } = Astro.props

const b = block as any

const bg = typeof block.backgroundImage === 'object' ? block.backgroundImage : null
const bgUrl = bg?.sizes?.hero?.url ?? bg?.url ?? ''

const containerClass = resolveContainer(b.containerWidth)
const paddingClass = resolvePadding(b)
const padOverrideStyle = resolvePaddingOverrideStyle(b)
const entry = resolveEntryAnimation(b.entryAnimation)

const ts = b.ts ?? {}
const eyebrowColor = resolveTextColor(ts.eyebrowColor)
const eyebrowAnim = resolveTextAnimIn(ts.eyebrowAnimIn)
const hColor = resolveTextColor(ts.headingColor)
const hAnim = resolveTextAnimIn(ts.headingAnimIn)
const labelColor = resolveTextColor(ts.labelColor)
const labelAnim = resolveTextAnimIn(ts.labelAnimIn)
const captionColor = resolveTextColor(ts.captionColor)
const captionAnim = resolveTextAnimIn(ts.captionAnimIn)

// Phase 4.23 Part B — 2 themes selectable per-instance from CMS.
// Default `theme-1` (Editorial Grid) matches Part A baseline byte-for-byte,
// jadi existing instances tidak berubah tampilan tanpa aksi editor.
const theme = (b.theme ?? 'theme-1') as 'theme-1' | 'theme-2'

// Dynamic grid — CMS allows 2-6 items. Berlaku sama untuk kedua tema.
// Class strings ditulis literal supaya Tailwind JIT bisa detect.
const itemCount = block.items?.length ?? 0
const gridColsClass = (() => {
  switch (itemCount) {
    case 2: return 'grid-cols-2'
    case 3: return 'grid-cols-1 sm:grid-cols-3'
    case 4: return 'grid-cols-2 md:grid-cols-4'
    case 5: return 'grid-cols-2 md:grid-cols-5'
    case 6: return 'grid-cols-2 md:grid-cols-3 lg:grid-cols-6'
    default: return 'grid-cols-2 md:grid-cols-4'
  }
})()
---

<section class:list={['relative bg-ocean text-white overflow-hidden', paddingClass]} data-animate={entry.dataAnimate} style={padOverrideStyle}>
  {bgUrl && (
    <div class="absolute inset-0 opacity-10">
      <img src={bgUrl} alt="" class="w-full h-full object-cover" />
    </div>
  )}

  <div class:list={['relative mx-auto text-center', containerClass, entry.className]}>
    {block.eyebrow && (
      <p class:list={['text-xs uppercase tracking-widest mb-2', eyebrowColor || 'text-white/70', eyebrowAnim]} data-animate="reveal">
        {block.eyebrow}
      </p>
    )}
    <h2 class:list={['font-display text-2xl md:text-3xl mb-12', hColor || 'text-white', hAnim]} data-animate="reveal">
      {block.heading}
    </h2>

    {theme === 'theme-2' ? (
      // ── Theme 2 — Feature Cards ─────────────────────────────────────
      // Icon-left card, glass-on-dark. Cocok untuk service detail page /
      // section modern-friendly. Tidak pakai divider (card itself already
      // provides visual separation).
      // ── Theme 2 — Feature Cards ─────────────────────────────────────
      <div class:list={['grid gap-4 md:gap-6', gridColsClass]} data-animate="stagger">
        {block.items.map((item) => (
          <div class="flex items-center gap-4 rounded-2xl bg-white/5 backdrop-blur border border-white/10 p-5 md:p-6 text-left h-full">
            <div class="shrink-0 inline-flex items-center justify-center w-14 h-14 rounded-xl bg-coral/15 text-coral">
              <Icon name={item.iconName} class="w-7 h-7" strokeWidth={1.75} />
            </div>
            <div class="flex-1 min-w-0">
              <p class:list={['font-display text-3xl md:text-4xl font-bold leading-none mb-1', labelColor || 'text-white', labelAnim]}>{item.value}</p>
              <p class:list={['text-sm', captionColor || 'text-white/70', captionAnim]}>{item.caption}</p>
            </div>
          </div>
        ))}
      </div>
    ) : (
      // ── Theme 1 — Editorial Grid (default, Part A baseline) ─────────
      <div class:list={['grid gap-y-10 gap-x-6 md:gap-x-8 justify-items-center items-center', gridColsClass]} data-animate="stagger">
        {block.items.map((item, i) => (
          <div class:list={[
            'w-full px-2 md:px-4 py-4 flex flex-col justify-center items-center text-center',
            i > 0 && 'md:border-l md:border-white/15',
          ]}>
            <div class="inline-flex mx-auto mb-3 text-white/90">
              <Icon name={item.iconName} class="w-8 h-8 md:w-10 md:h-10" strokeWidth={1.5} />
            </div>
            <p class:list={['font-display text-4xl md:text-5xl lg:text-6xl font-bold mb-2 leading-none', labelColor, labelAnim]}>{item.value}</p>
            <p class:list={['text-xs md:text-sm uppercase tracking-widest', captionColor || 'text-white/70', captionAnim]}>{item.caption}</p>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
