---
import type { Page } from '@shared/types/payload-types'
import { resolvePadding, resolvePaddingOverrideStyle } from '@lib/blockStyles'

type Block = Extract<NonNullable<Page['content']>[number], { blockType: 'embed' }>
interface Props { block: Block }
const { block } = Astro.props

const b = block as any

const type = block.embedType ?? 'custom'
const isUrl = /^https?:\/\//.test(block.embedCode.trim())
const iframeSrc = isUrl ? block.embedCode.trim() : ''

const paddingClass = resolvePadding(b)
const padOverrideStyle = resolvePaddingOverrideStyle(b)
---

<section class:list={[paddingClass]} data-animate="reveal"
  style={padOverrideStyle}>
  <div class="container-content max-w-4xl">
    {isUrl && (type === 'youtube' || type === 'map') ? (
      <div class="aspect-video rounded-xl overflow-hidden bg-sand">
        <iframe
          src={iframeSrc}
          class="w-full h-full border-0"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    ) : (
      <div class="rounded-xl overflow-hidden" set:html={block.embedCode}></div>
    )}
  </div>
</section>
