---
import type { Page, Media } from '@shared/types/payload-types'
import Icon from '@components/common/Icon.astro'
import { lexicalToPlainText } from '@lib/lexical'
import {
  getAccommodations, getTours, getWaterActivities, getYachts,
  getRestaurants, getVenues, getRentals, getSpas, getFerryTickets, getDestinations,
  getSiteSettings, getSiteFeatures,
} from '@lib/payload'
import AccommodationCard from '@components/cards/AccommodationCard.astro'
import TourCard from '@components/cards/TourCard.astro'
import WaterActivityCard from '@components/cards/WaterActivityCard.astro'
import YachtCard from '@components/cards/YachtCard.astro'
import RestaurantCard from '@components/cards/RestaurantCard.astro'
import VenueCard from '@components/cards/VenueCard.astro'
import RentalCard from '@components/cards/RentalCard.astro'
import SpaCard from '@components/cards/SpaCard.astro'
import FerryTicketsCard from '@components/cards/FerryTicketsCard.astro'
import {
  resolveContainer, resolveEntryAnimation,
  resolveTextColor, resolveTextAnimIn,
} from '@lib/blockStyles'

type Block = Extract<NonNullable<Page['content']>[number], { blockType: 'serviceListing' }>
interface Props { block: Block; serviceMeta?: any }
const { block, serviceMeta = null } = Astro.props

const b = block as any

// Task 3.3 — ServiceType (CMS) sebagai fallback kalau field blok kosong.
const svcName: string | undefined = serviceMeta?.name
const svcDescPlain: string | undefined = serviceMeta?.description
  ? lexicalToPlainText(serviceMeta.description).slice(0, 300)
  : undefined
const heading = b.heading || svcName
const description = b.description || svcDescPlain

// ── Fetch ─────────────────────────────────────────────
const serviceType = b.serviceType ?? 'accommodations'
const limit = b.limit ?? 24
const accommodationTypes: string[] = Array.isArray(b.accommodationTypes) ? b.accommodationTypes : []

let items: any[] = []
let destinations: any[] = []
let error: string | null = null

try {
  const opts = { limit, sort: 'sortOrder' }
  const destPromise = getDestinations({ limit: 100, sort: 'sortOrder' })
  let itemsPromise: Promise<any>
  switch (serviceType) {
    case 'tours':            itemsPromise = getTours(opts); break
    case 'water-activities': itemsPromise = getWaterActivities(opts); break
    case 'yachts':           itemsPromise = getYachts(opts); break
    case 'restaurants':      itemsPromise = getRestaurants(opts); break
    case 'venues':           itemsPromise = getVenues(opts); break
    case 'rentals':          itemsPromise = getRentals(opts); break
    case 'spa':              itemsPromise = getSpas(opts); break
    case 'ferry-tickets':    itemsPromise = getFerryTickets(opts); break
    default:                 itemsPromise = getAccommodations(opts); break
  }
  const [itemsData, destData] = await Promise.all([itemsPromise, destPromise])
  items = itemsData.docs
  destinations = destData.docs
  if (serviceType === 'accommodations' && accommodationTypes.length > 0) {
    items = items.filter((a) => accommodationTypes.includes(a.type))
  }
} catch (err) {
  error = err instanceof Error ? err.message : String(err)
}

const detailRouteMap: Record<string, string> = {
  accommodations: '/villa',
  tours: '/tour',
  rentals: '/rental',
  spa: '/spa',
  'water-activities': '/water-activity',
  yachts: '/yacht',
  restaurants: '/restaurant',
  venues: '/venue',
  'ferry-tickets': '/ferry-tickets',
}
const detailBase = detailRouteMap[serviceType] ?? '/'

// ── Hero media (uses shared mediaFields schema) ────────
const asMedia = (v: unknown): Media | null => (v && typeof v === 'object' ? (v as Media) : null)

const mediaType: 'single' | 'multiple' | 'video' | 'none' = b.mediaType ?? 'single'
const overlayOpacity = typeof b.heroOverlayOpacity === 'number' ? b.heroOverlayOpacity / 100 : 0.4
const heroMinHeight = b.heroMinHeight ?? 'md'
const heroMinHeightClass: Record<string, string> = {
  sm: 'min-h-[420px]',
  md: 'min-h-[520px] md:min-h-[560px]',
  lg: 'min-h-[600px] md:min-h-[680px]',
  full: 'min-h-screen',
}

// Fit + position maps
const fitClassMap: Record<string, string> = { cover: 'object-cover', contain: 'object-contain', fill: 'object-fill', 'scale-down': 'object-scale-down' }
const posClassMap: Record<string, string> = {
  'top-left': 'object-left-top', top: 'object-top', 'top-right': 'object-right-top',
  left: 'object-left', center: 'object-center', right: 'object-right',
  'bottom-left': 'object-left-bottom', bottom: 'object-bottom', 'bottom-right': 'object-right-bottom',
}
const fitClass = (v?: string) => fitClassMap[v ?? 'cover'] ?? 'object-cover'
const posClass = (v?: string) => posClassMap[v ?? 'center'] ?? 'object-center'

const svcCover = asMedia(serviceMeta?.coverImage)
const singleImg = asMedia(b.singleImage) ?? svcCover
const singleImgUrl = singleImg?.sizes?.hero?.url ?? singleImg?.url ?? ''
const singleImgAlt = singleImg?.alt ?? svcName ?? ''
const singleFit = fitClass(b.imageFit)
const singlePos = posClass(b.imagePosition)

// Per-slide fit/position removed from CMS to stay under Postgres 63-char
// identifier limit — all slides use block-level imageFit/imagePosition.
const sliderImages = Array.isArray(b.imageSlider)
  ? b.imageSlider
      .map((s: any) => {
        const m = asMedia(s?.image)
        return m ? { url: m.sizes?.hero?.url ?? m.url ?? '', alt: m.alt ?? '' } : null
      })
      .filter((s: any) => s && s.url)
  : []
const imageTransition = b.imageTransition ?? 'fade'
const transitionInterval = typeof b.transitionInterval === 'number' ? b.transitionInterval : 5
const sliderAutoStart = b.sliderAutoStart === true

// Video
const videoOpts = b.videoOptions ?? {}
const videoPoster = asMedia(b.videoPoster)
const videoFile = asMedia(b.videoFile)
const videoUrlRaw: string = (b.videoSource === 'file' ? (videoFile?.url ?? '') : (b.videoUrl ?? ''))
type EmbedInfo = { kind: 'youtube' | 'vimeo' | 'file'; src: string }
const parseVideo = (url: string): EmbedInfo | null => {
  if (!url) return null
  const yt = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)([\w-]{11})/)
  if (yt) {
    const id = yt[1]
    const p = new URLSearchParams({
      autoplay: videoOpts.autoplay === false ? '0' : '1',
      mute: videoOpts.muted === false ? '0' : '1',
      loop: videoOpts.loop === false ? '0' : '1',
      playlist: id,
      controls: videoOpts.controls ? '1' : '0',
      modestbranding: '1', rel: '0',
    })
    return { kind: 'youtube', src: `https://www.youtube.com/embed/${id}?${p}` }
  }
  const vm = url.match(/vimeo\.com\/(?:video\/)?(\d+)/)
  if (vm) return { kind: 'vimeo', src: `https://player.vimeo.com/video/${vm[1]}?autoplay=1&muted=1&loop=1&background=1` }
  return { kind: 'file', src: url }
}
const embedInfo = mediaType === 'video' && videoUrlRaw ? parseVideo(videoUrlRaw) : null
const posterUrl = videoPoster?.sizes?.hero?.url ?? videoPoster?.url ?? ''

// ── Filter + search config ─────────────────────────────
const enableDestFilter = b.enableDestinationFilter !== false
const enableSearch = b.enableSearch !== false
const searchNamePlaceholder = b.searchNamePlaceholder ?? 'Where are you staying?'
const showDatePicker = b.showDatePicker !== false
const showGuestCount = b.showGuestCount !== false
const searchButtonText = b.searchButtonText ?? 'Search Collection'
const hasFilterUI = enableDestFilter || enableSearch

// ── Hierarchical destinations (Phase 3.22) ─────────────
// Gated by Site Features. When ON: only "core" destinations (showInFilter)
// become filter tabs; child destinations are matched to their core. When OFF:
// flat behavior (every destination is its own tab, exact-match) — unchanged.
const features = await getSiteFeatures().catch(() => null)
const hierEnabled = (features as any)?.destinations?.hierarchicalFilter === true

const destBySlug = new Map<string, any>()
for (const d of destinations) if (d?.slug) destBySlug.set(d.slug, d)
const parentSlugOf = (d: any): string | null => {
  const p = d?.parent
  if (!p) return null
  return typeof p === 'object' ? (p.slug ?? null) : (destBySlug.get(String(p))?.slug ?? null)
}
// Walk up the parent chain (via the flat map) to the top-level destination.
const coreSlugOf = (slug: string): string => {
  let cur = destBySlug.get(slug)
  const seen = new Set<string>()
  while (cur?.slug && !seen.has(cur.slug)) {
    seen.add(cur.slug)
    const ps = parentSlugOf(cur)
    if (!ps) break
    cur = destBySlug.get(ps)
  }
  return cur?.slug ?? slug
}
const coreNameOf = (slug: string): string => destBySlug.get(coreSlugOf(slug))?.name ?? ''

// Tabs source: cores only when hierarchy is on, else all destinations.
const tabDestinations = hierEnabled
  ? destinations.filter((d: any) => d?.showInFilter === true)
  : destinations

const filterDestinations = enableDestFilter
  ? [{ label: 'All', value: 'all' }, ...tabDestinations.map((d: any) => ({ label: d.name, value: d.slug ?? '' }))]
  : []

// ── Card + pagination ───────────────────────────────────
const cardVariant: 'compact' | 'detailed' = b.cardVariant === 'compact' ? 'compact' : 'detailed'
const showLoadMore = b.showLoadMore === true
const paginationType: 'load-more' | 'pages' = b.paginationType === 'pages' ? 'pages' : 'load-more'
// Phase 4.53 — per-breakpoint counts (mirror Editorial).
const perDesktop = typeof b.initialVisibleCount === 'number' ? b.initialVisibleCount : 6
const perTablet = typeof b.initialVisibleCountTablet === 'number' ? b.initialVisibleCountTablet : perDesktop
const perMobile = typeof b.initialVisibleCountMobile === 'number' ? b.initialVisibleCountMobile : perDesktop
const loadMoreText = b.loadMoreText ?? 'Load More'
const totalPages = showLoadMore ? Math.ceil(items.length / perDesktop) : 1

// ── Styling ─────────────────────────────────────────────
const containerClass = resolveContainer(b.containerWidth)
const entry = resolveEntryAnimation(b.entryAnimation)

const ts = b.ts ?? {}
const eyebrowColor = resolveTextColor(ts.eyebrowColor)
const eyebrowAnim = resolveTextAnimIn(ts.eyebrowAnimIn)
const hColor = resolveTextColor(ts.headingColor)
const hAnim = resolveTextAnimIn(ts.headingAnimIn)
const descColor = resolveTextColor(ts.descriptionColor)
const descAnim = resolveTextAnimIn(ts.descriptionAnimIn)

const listingId = `slh-${Math.random().toString(36).slice(2, 9)}`
const visibleItems = items

// ── CMS-editable listing header (Site Settings → Section Pages) ─────────
const siteSettings = await getSiteSettings().catch(() => null)
const sp = (siteSettings as any)?.sectionPages ?? {}
const listingTitle = sp.listingTitle || 'Luxury Collections'
const listingSubtitle = sp.listingSubtitle || 'properties available in Bali & surrounding islands'
---

<section class="relative bg-sand" data-animate={entry.dataAnimate}>
  {/* ── Hero ────────────────────────────────────────── */}
  <div class:list={['relative w-full overflow-hidden', heroMinHeightClass[heroMinHeight]]}>
    {/* Media layer */}
    {mediaType === 'single' && singleImgUrl && (
      <div class="absolute inset-0 z-[1]">
        <img src={singleImgUrl} alt={singleImgAlt} class:list={['w-full h-full', singleFit, singlePos]} loading="eager" fetchpriority="high" />
      </div>
    )}

    {mediaType === 'multiple' && sliderImages.length > 0 && (
      <div
        class="absolute inset-0 z-[1] slh-slider"
        data-transition={imageTransition}
        data-interval={transitionInterval}
        data-autostart={sliderAutoStart ? 'true' : 'false'}
      >
        {sliderImages.map((s: any, i: number) => (
          <img
            src={s.url}
            alt={s.alt}
            data-idx={i}
            class:list={['absolute inset-0 w-full h-full slh-slide', singleFit, singlePos, i === 0 && 'is-active']}
            loading="eager"
            fetchpriority={i === 0 ? 'high' : undefined}
          />
        ))}
      </div>
    )}

    {mediaType === 'video' && embedInfo && (
      <div class="absolute inset-0 z-[1]">
        {posterUrl && <img src={posterUrl} alt="" class:list={['absolute inset-0 w-full h-full', singleFit, singlePos]} loading="eager" />}
        {embedInfo.kind === 'file' ? (
          <video
            class:list={['absolute inset-0 w-full h-full', singleFit, singlePos]}
            src={embedInfo.src}
            poster={posterUrl || undefined}
            autoplay={videoOpts.autoplay !== false}
            muted={videoOpts.muted !== false}
            loop={videoOpts.loop !== false}
            controls={videoOpts.controls === true}
            playsinline
          />
        ) : (
          <iframe
            class="absolute inset-0 w-full h-full pointer-events-none"
            style="width:100vw;height:56.25vw;min-height:100%;min-width:177.77vh;left:50%;top:50%;transform:translate(-50%,-50%);"
            src={embedInfo.src}
            allow="autoplay; encrypted-media"
            allowfullscreen
            frameborder="0"
          ></iframe>
        )}
      </div>
    )}

    {mediaType === 'none' && (
      <div class="absolute inset-0 z-[1] bg-gradient-to-br from-ocean via-ocean/80 to-leaf"></div>
    )}

    {/* Overlay */}
    <div class="absolute inset-0 z-[2] bg-black" style={`opacity:${overlayOpacity}`}></div>

    {/* Hero content */}
    <div class:list={['relative z-10 mx-auto flex flex-col items-center justify-center h-full py-16 md:py-20 px-4', containerClass, entry.className, heroMinHeightClass[heroMinHeight]]}>
      <div class="text-center max-w-3xl mx-auto text-white">
        {b.eyebrow && (
          <p class:list={['text-xs uppercase tracking-[0.3em] mb-4 font-semibold', eyebrowColor || 'text-white/80', eyebrowAnim]}>
            {b.eyebrow}
          </p>
        )}
        {heading && (
          <h2 class:list={['font-display italic text-4xl md:text-5xl lg:text-6xl mb-4 leading-tight', hColor || 'text-white', hAnim]}>
            {heading}
          </h2>
        )}
        {description && (
          <p class:list={['text-base md:text-lg max-w-2xl mx-auto', descColor || 'text-white/90', descAnim]}>
            {description}
          </p>
        )}
      </div>
    </div>
  </div>

  {/* ── Filter + search — unified floating card between hero & listing ── */}
  {hasFilterUI && (
    <div class:list={['relative z-20 mx-auto px-4 -mt-14 md:-mt-16', containerClass]}>
      <div class="max-w-5xl mx-auto bg-white/95 backdrop-blur-md rounded-2xl shadow-2xl overflow-hidden">
        {enableDestFilter && filterDestinations.length > 1 && (
          <div
            class:list={['hidden md:flex items-center justify-center gap-2 md:gap-3 overflow-x-auto no-scrollbar px-4 md:px-6 pt-4 md:pt-5', enableSearch ? 'pb-3 md:pb-4' : 'pb-4 md:pb-5']}
            data-role="dest-tabs"
            data-listing-id={listingId}
          >
            {filterDestinations.map((dest, i) => (
              <button
                type="button"
                data-dest={dest.value}
                data-active={i === 0 ? 'true' : 'false'}
                class="shrink-0 px-5 md:px-6 py-2 md:py-2.5 rounded-full text-xs md:text-sm font-semibold transition-all whitespace-nowrap
                       bg-sand/80 text-stone border border-sand-dark/10 hover:bg-sand
                       data-[active=true]:bg-ocean data-[active=true]:text-white data-[active=true]:border-ocean data-[active=true]:shadow-md"
              >
                {dest.label}
              </button>
            ))}
          </div>
        )}

        {enableSearch && (
          <div class:list={['px-4 md:px-6 pb-4 md:pb-5 flex flex-col md:flex-row gap-2 md:gap-3 items-stretch md:items-center', enableDestFilter && filterDestinations.length > 1 ? 'pt-4 md:border-t md:border-sand-dark/10 md:pt-4' : 'pt-4 md:pt-5']}>
            <div class:list={['flex-1 grid grid-cols-1 gap-2 md:gap-3', showDatePicker && showGuestCount ? 'md:grid-cols-3' : showDatePicker || showGuestCount ? 'md:grid-cols-2' : 'md:grid-cols-1']}>
              <label class="relative block">
                <Icon name="location_on" class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-stone-light pointer-events-none" />
                <input type="text" data-role="search-name" data-listing-id={listingId}
                       placeholder={searchNamePlaceholder}
                       class="w-full pl-12 pr-4 py-3 rounded-xl border-none bg-sand focus:bg-white focus:ring-2 focus:ring-ocean text-sm text-stone outline-none transition-all" />
              </label>
              {showDatePicker && (
                <label class="relative block">
                  <Icon name="calendar_today" class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-stone-light pointer-events-none" />
                  <input type="text" placeholder="Check-in — Check-out"
                         class="w-full pl-12 pr-4 py-3 rounded-xl border-none bg-sand focus:bg-white focus:ring-2 focus:ring-ocean text-sm text-stone outline-none transition-all" />
                </label>
              )}
              {showGuestCount && (
                <label class="relative block">
                  <Icon name="group" class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-stone-light pointer-events-none" />
                  <input type="number" min="1" value="2" placeholder="Guests"
                         class="w-full pl-12 pr-4 py-3 rounded-xl border-none bg-sand focus:bg-white focus:ring-2 focus:ring-ocean text-sm text-stone outline-none transition-all" />
                </label>
              )}
            </div>
            <button type="button" data-role="search-btn" data-listing-id={listingId}
                    class="shrink-0 inline-flex items-center justify-center gap-2 px-6 md:px-8 py-3 bg-coral hover:bg-coral-dark text-white text-sm font-semibold rounded-xl transition-colors shadow-md">
              <Icon name="search" class="w-5 h-5" /> {searchButtonText}
            </button>
          </div>
        )}
      </div>
    </div>
  )}

  {/* ── Listing section ─────────────────────────────── */}
  <div class:list={['relative mx-auto px-4', containerClass, hasFilterUI ? 'pt-10 md:pt-12 pb-12 md:pb-16' : 'py-12 md:py-16']}>
    <div class="mb-8 md:mb-10 flex items-end justify-between gap-4 flex-wrap">
      <div>
        <h3 class="font-display text-2xl md:text-3xl text-ocean">{listingTitle}</h3>
        <p class="text-sm text-stone-light mt-1">
          <span data-role="count" data-listing-id={listingId}>{visibleItems.length}</span>
          <span> {listingSubtitle}</span>
        </p>
      </div>
    </div>

    {error && (
      <div class="bg-white border border-coral/40 text-coral-dark rounded-xl p-6 text-sm max-w-2xl mx-auto">
        <p class="font-semibold mb-1">Gagal memuat listing</p>
        <pre class="text-xs bg-sand p-3 rounded mt-2 overflow-x-auto">{error}</pre>
      </div>
    )}

    {!error && visibleItems.length === 0 && (
      <div class="bg-white border border-sand-dark/10 rounded-xl p-8 text-center max-w-2xl mx-auto">
        <p class="font-display text-xl text-ocean mb-2">Belum ada item published</p>
        <p class="text-sm text-stone-light">Publish minimal 1 item di CMS untuk mengisi listing.</p>
      </div>
    )}

    {visibleItems.length > 0 && (
      <>
        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8"
          data-role="grid"
          data-listing-id={listingId}
          data-pagination={showLoadMore ? paginationType : 'none'}
          data-per-mobile={perMobile}
          data-per-tablet={perTablet}
          data-per-desktop={perDesktop}
        >
          {visibleItems.map((item: any, idx: number) => {
            const ownDestSlug = typeof item.destination === 'object' ? (item.destination?.slug ?? '') : ''
            const ownDestName = typeof item.destination === 'object' ? (item.destination?.name ?? '') : ''
            // Match key: core slug when hierarchy is on, else the item's own dest slug.
            const destSlug = hierEnabled && ownDestSlug ? coreSlugOf(ownDestSlug) : ownDestSlug
            // Searchable string: item name + (when hierarchical) its destination + core names.
            const name = [item.name ?? item.title ?? '', hierEnabled ? ownDestName : '', hierEnabled ? coreNameOf(ownDestSlug) : '']
              .join(' ').trim().toLowerCase()
            const hiddenByPagination = showLoadMore && idx >= perDesktop
            return (
              <div
                class:list={['sl-card', hiddenByPagination && 'sl-hidden-page']}
                data-dest={destSlug}
                data-name={name}
                style={hiddenByPagination ? 'display:none' : undefined}
              >
                {serviceType === 'accommodations' && <AccommodationCard accommodation={item} hrefBase={detailBase} variant={cardVariant} />}
                {serviceType === 'tours' && <TourCard tour={item} hrefBase={detailBase} variant={cardVariant} />}
                {serviceType === 'water-activities' && <WaterActivityCard activity={item} hrefBase={detailBase} variant={cardVariant} />}
                {serviceType === 'yachts' && <YachtCard yacht={item} hrefBase={detailBase} variant={cardVariant} />}
                {serviceType === 'restaurants' && <RestaurantCard restaurant={item} hrefBase={detailBase} variant={cardVariant} />}
                {serviceType === 'venues' && <VenueCard venue={item} hrefBase={detailBase} variant={cardVariant} />}
                {serviceType === 'rentals' && <RentalCard rental={item} hrefBase={detailBase} variant={cardVariant} />}
                {serviceType === 'spa' && <SpaCard spa={item} hrefBase={detailBase} variant={cardVariant} />}
                {serviceType === 'ferry-tickets' && <FerryTicketsCard ferryTicket={item} hrefBase={detailBase} variant={cardVariant} />}
              </div>
            )
          })}
        </div>

        {/* Load More button (load-more mode only) */}
        {showLoadMore && paginationType === 'load-more' && visibleItems.length > Math.min(perMobile, perTablet, perDesktop) && (
          <div class="mt-10 md:mt-12 text-center">
            <button
              type="button"
              data-role="load-more"
              data-listing-id={listingId}
              class="inline-flex items-center gap-2 px-8 md:px-10 py-3 md:py-4 border-2 border-ocean text-ocean hover:bg-ocean hover:text-white font-semibold rounded-full transition-colors"
            >
              {loadMoreText}
            </button>
          </div>
        )}

        {/* Numbered pagination (pages mode only) */}
        {showLoadMore && paginationType === 'pages' && totalPages > 1 && (
          <nav class="mt-10 md:mt-12 flex items-center justify-center gap-2 flex-wrap" data-role="pagination" data-listing-id={listingId} aria-label="Pagination">
            <button type="button" data-role="page-prev" disabled
                    class="inline-flex items-center justify-center w-10 h-10 rounded-full border border-sand-dark/20 text-stone-light hover:bg-sand disabled:opacity-40 disabled:cursor-not-allowed transition-colors">
              <Icon name="chevron_left" class="w-5 h-5" />
            </button>
            {Array.from({ length: totalPages }, (_, i) => (
              <button type="button" data-role="page-num" data-page={i + 1}
                      class:list={['inline-flex items-center justify-center w-10 h-10 rounded-full text-sm font-semibold transition-colors',
                        i === 0 ? 'bg-ocean text-white shadow-md' : 'border border-sand-dark/20 text-stone hover:bg-sand']}>
                {i + 1}
              </button>
            ))}
            <button type="button" data-role="page-next"
                    class="inline-flex items-center justify-center w-10 h-10 rounded-full border border-sand-dark/20 text-stone-light hover:bg-sand disabled:opacity-40 disabled:cursor-not-allowed transition-colors">
              <Icon name="chevron_right" class="w-5 h-5" />
            </button>
          </nav>
        )}

        <p class="hidden mt-12 text-center text-stone-light" data-role="empty" data-listing-id={listingId}>
          No items match your filter.
        </p>
      </>
    )}
  </div>
</section>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { scrollbar-width: none; -ms-overflow-style: none; }

  /* ── Slider transitions (own-scoped copy of hero-slider) ── */
  .slh-slider .slh-slide {
    opacity: 0;
    transition: opacity 900ms ease, transform 6s ease, filter 900ms ease, clip-path 1100ms cubic-bezier(0.77, 0, 0.175, 1);
    z-index: 0;
  }
  .slh-slider .slh-slide.is-active { opacity: 1; z-index: 1; }
  .slh-slider[data-transition="slide"] .slh-slide { transform: translateX(30px); }
  .slh-slider[data-transition="slide"] .slh-slide.is-active { transform: translateX(0); }
  .slh-slider[data-transition="zoom"] .slh-slide { transform: scale(1); }
  .slh-slider[data-transition="zoom"] .slh-slide.is-active { transform: scale(1.08); }
  .slh-slider[data-transition="blur"] .slh-slide { filter: blur(20px); }
  .slh-slider[data-transition="blur"] .slh-slide.is-active { filter: blur(0); }
  .slh-slider[data-transition="wipe"] .slh-slide { clip-path: inset(0 100% 0 0); opacity: 1; }
  .slh-slider[data-transition="wipe"] .slh-slide.is-active { clip-path: inset(0 0 0 0); }
  .slh-slider[data-transition="parallax"] .slh-slide { transform: translateY(30px); }
  .slh-slider[data-transition="parallax"] .slh-slide.is-active { transform: translateY(0); }
  .slh-slider[data-transition="none"] .slh-slide { transition: none; }
  @media (prefers-reduced-motion: reduce) {
    .slh-slider .slh-slide { transition: none; transform: none !important; filter: none !important; clip-path: none !important; }
  }
</style>

<script>
  const initSlhSliders = () => {
    document.querySelectorAll<HTMLElement>('.slh-slider').forEach((slider) => {
      const slides = Array.from(slider.querySelectorAll<HTMLElement>('.slh-slide'))
      if (slides.length < 2) return
      const intervalSec = Number(slider.dataset.interval ?? 5)
      const intervalMs = Math.max(2000, intervalSec * 1000)
      const autoStart = slider.dataset.autostart === 'true'
      let current = 0
      const advance = () => {
        slides[current].classList.remove('is-active')
        current = (current + 1) % slides.length
        slides[current].classList.add('is-active')
      }
      if (autoStart) setTimeout(advance, 100)
      setInterval(advance, intervalMs)
    })
  }
  document.addEventListener('astro:page-load', initSlhSliders)
  initSlhSliders()

  const scrollToGrid = (grid: HTMLElement) => {
    requestAnimationFrame(() => {
      const rect = grid.getBoundingClientRect()
      const offset = window.scrollY + rect.top - 100
      window.scrollTo({ top: Math.max(0, offset), behavior: 'smooth' })
      grid.scrollLeft = 0
    })
  }

  // Phase 4.53 — per-breakpoint pagination count (mirror Editorial).
  const readPerPage = (grid: HTMLElement): number => {
    const w = window.innerWidth
    const mobile = Number(grid.dataset.perMobile ?? grid.dataset.perDesktop ?? 6)
    const tablet = Number(grid.dataset.perTablet ?? grid.dataset.perDesktop ?? 6)
    const desktop = Number(grid.dataset.perDesktop ?? 6)
    if (w < 640) return mobile
    if (w < 1024) return tablet
    return desktop
  }

  const initHeroImmersive = () => {
    const grids = document.querySelectorAll<HTMLElement>('[data-role="grid"][data-listing-id^="slh-"]')
    grids.forEach((grid) => {
      const id = grid.dataset.listingId!
      const paginationMode = grid.dataset.pagination ?? 'none'
      let perPage = readPerPage(grid)
      const tabs = document.querySelector<HTMLElement>(`[data-role="dest-tabs"][data-listing-id="${id}"]`)
      const nameInput = document.querySelector<HTMLInputElement>(`[data-role="search-name"][data-listing-id="${id}"]`)
      const searchBtn = document.querySelector<HTMLElement>(`[data-role="search-btn"][data-listing-id="${id}"]`)
      const countEl = document.querySelector<HTMLElement>(`[data-role="count"][data-listing-id="${id}"]`)
      const emptyEl = document.querySelector<HTMLElement>(`[data-role="empty"][data-listing-id="${id}"]`)
      const loadMoreBtn = document.querySelector<HTMLButtonElement>(`[data-role="load-more"][data-listing-id="${id}"]`)
      const paginationNav = document.querySelector<HTMLElement>(`[data-role="pagination"][data-listing-id="${id}"]`)

      let activeDest = 'all'
      let searchTerm = ''
      let currentPage = 1
      let loadMoreRevealed = 0

      const getFilteredCards = () => {
        const cards = Array.from(grid.querySelectorAll<HTMLElement>('.sl-card'))
        return cards.filter((c) => {
          const d = c.dataset.dest ?? ''
          const n = c.dataset.name ?? ''
          const destOk = activeDest === 'all' || d === activeDest
          const nameOk = !searchTerm || n.includes(searchTerm.toLowerCase())
          return destOk && nameOk
        })
      }

      const applyView = () => {
        const allCards = Array.from(grid.querySelectorAll<HTMLElement>('.sl-card'))
        const filtered = getFilteredCards()
        const totalFiltered = filtered.length

        allCards.forEach((c) => c.style.display = 'none')

        if (paginationMode === 'pages') {
          const totalPg = Math.max(1, Math.ceil(totalFiltered / perPage))
          if (currentPage > totalPg) currentPage = totalPg
          const start = (currentPage - 1) * perPage
          const end = start + perPage
          filtered.forEach((c, i) => { c.style.display = (i >= start && i < end) ? '' : 'none' })
          updatePaginationNav(totalPg)
          if (countEl) countEl.textContent = String(totalFiltered)
        } else if (paginationMode === 'load-more') {
          const showCount = perPage + loadMoreRevealed
          filtered.forEach((c, i) => { c.style.display = i < showCount ? '' : 'none' })
          if (loadMoreBtn) loadMoreBtn.style.display = filtered.length > showCount ? '' : 'none'
          if (countEl) countEl.textContent = String(Math.min(showCount, totalFiltered))
        } else {
          filtered.forEach((c) => { c.style.display = '' })
          if (countEl) countEl.textContent = String(totalFiltered)
        }

        if (emptyEl) emptyEl.classList.toggle('hidden', totalFiltered > 0)
      }

      const updatePaginationNav = (totalPg: number) => {
        if (!paginationNav) return
        const prevBtn = paginationNav.querySelector<HTMLButtonElement>('[data-role="page-prev"]')
        const nextBtn = paginationNav.querySelector<HTMLButtonElement>('[data-role="page-next"]')
        const numBtns = paginationNav.querySelectorAll<HTMLButtonElement>('[data-role="page-num"]')

        if (prevBtn) prevBtn.disabled = currentPage <= 1
        if (nextBtn) nextBtn.disabled = currentPage >= totalPg

        numBtns.forEach((btn) => {
          const pg = Number(btn.dataset.page)
          const isActive = pg === currentPage
          btn.className = `inline-flex items-center justify-center w-10 h-10 rounded-full text-sm font-semibold transition-colors ${isActive ? 'bg-ocean text-white shadow-md' : 'border border-sand-dark/20 text-stone hover:bg-sand'}`
          if (pg > totalPg) {
            btn.style.display = 'none'
          } else {
            btn.style.display = ''
          }
        })
      }

      if (paginationMode === 'pages' && paginationNav) {
        paginationNav.querySelectorAll<HTMLButtonElement>('[data-role="page-num"]').forEach((btn) => {
          btn.addEventListener('click', () => {
            currentPage = Number(btn.dataset.page ?? 1)
            applyView()
            scrollToGrid(grid)
          })
        })
        paginationNav.querySelector<HTMLButtonElement>('[data-role="page-prev"]')?.addEventListener('click', () => {
          if (currentPage > 1) { currentPage--; applyView(); scrollToGrid(grid) }
        })
        paginationNav.querySelector<HTMLButtonElement>('[data-role="page-next"]')?.addEventListener('click', () => {
          const totalPg = Math.max(1, Math.ceil(getFilteredCards().length / perPage))
          if (currentPage < totalPg) { currentPage++; applyView(); scrollToGrid(grid) }
        })
      }

      tabs?.querySelectorAll<HTMLButtonElement>('button[data-dest]').forEach((btn) => {
        btn.addEventListener('click', () => {
          tabs.querySelectorAll('button[data-dest]').forEach((b) => b.setAttribute('data-active', 'false'))
          btn.setAttribute('data-active', 'true')
          activeDest = btn.dataset.dest ?? 'all'
          currentPage = 1
          loadMoreRevealed = 0
          applyView()
        })
      })

      const commitSearch = () => {
        searchTerm = (nameInput?.value ?? '').trim()
        currentPage = 1
        loadMoreRevealed = 0
        applyView()
      }
      nameInput?.addEventListener('input', commitSearch)
      searchBtn?.addEventListener('click', commitSearch)
      nameInput?.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Enter') { e.preventDefault(); commitSearch() }
      })

      loadMoreBtn?.addEventListener('click', () => {
        loadMoreRevealed += perPage
        applyView()
      })

      // Re-evaluate perPage saat viewport crossing breakpoint.
      let resizeTimer: number | undefined
      const onResize = () => {
        if (resizeTimer) window.clearTimeout(resizeTimer)
        resizeTimer = window.setTimeout(() => {
          const next = readPerPage(grid)
          if (next !== perPage) {
            perPage = next
            currentPage = 1
            loadMoreRevealed = 0
            applyView()
          }
        }, 150)
      }
      window.addEventListener('resize', onResize)
      window.addEventListener('orientationchange', onResize)

      // Initial apply — reconcile SSR (desktop count) dengan viewport aktual.
      applyView()
    })
  }
  document.addEventListener('astro:page-load', initHeroImmersive)
  initHeroImmersive()
</script>
