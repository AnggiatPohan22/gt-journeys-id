---
import type { Page } from '@shared/types/payload-types'
import Icon from '@components/common/Icon.astro'
import {
  resolveEntryAnimation, resolveBackground,
  resolveTextColor, resolveTextAnimIn,
} from '@lib/blockStyles'

type Block = Extract<NonNullable<Page['content']>[number], { blockType: 'valuePropsBanner' }>
interface Props { block: Block }
const { block } = Astro.props

const b = block as any

// Note: banner section-padding intentionally minimal — this block is meant
// to overlap the block above (-mt-16). We honor entry animation + text
// styling from Advanced tab but keep the overlap positioning.
const entry = resolveEntryAnimation(b.entryAnimation, b.entrySpeed, b.entryDurMs)
const bgResolved = resolveBackground(b.background)

const ts = b.ts ?? {}
const labelColor = resolveTextColor(ts.labelColor)
const labelAnim = resolveTextAnimIn(ts.labelAnimIn)
const subColor = resolveTextColor(ts.subheadingColor)
const subAnim = resolveTextAnimIn(ts.subheadingAnimIn)
---

<section class="relative -mt-16 z-10 container-content" data-animate={entry.dataAnimate} style={entry.style || undefined}>
  <div class:list={[
    'max-w-5xl mx-auto rounded-2xl shadow-xl border border-sand-dark/10 p-6 md:p-8 relative overflow-hidden',
    bgResolved.bgClass || 'bg-white',
    entry.className,
  ]}>
    {bgResolved.imageUrl && (
      <>
        <img src={bgResolved.imageUrl} alt="" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
        <div class="absolute inset-0 bg-black" style={`opacity:${bgResolved.overlayOpacity}`}></div>
      </>
    )}
    <div class="relative z-10 grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-4">
      {block.items.map((item, i) => (
        <div class:list={[
          'flex items-center gap-4',
          i > 0 && 'md:border-l md:border-sand-dark/20 md:pl-4',
        ]}>
          <div class="shrink-0 w-12 h-12 rounded-full bg-ocean/10 text-ocean flex items-center justify-center">
            <Icon name={item.iconName} class="w-6 h-6" />
          </div>
          <div class="min-w-0">
            <h4 class:list={['font-display text-sm font-bold', labelColor || 'text-ocean', labelAnim]}>{item.label}</h4>
            {item.subtitle && (
              <p class:list={['text-xs', subColor || 'text-stone-light', subAnim]}>{item.subtitle}</p>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
