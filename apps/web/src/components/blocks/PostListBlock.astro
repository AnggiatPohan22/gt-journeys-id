---
import { getPosts } from '@lib/payload'
import type { Media } from '@shared/types/payload-types'
import { resolveContainer, resolvePadding, resolvePaddingOverrideStyle, resolveBackground } from '@lib/blockStyles'

interface Props { block: any }
const { block } = Astro.props
const b = block ?? {}

const limit = Math.max(1, Math.min(24, Number(b.limit ?? 6)))
const columns = b.columns ?? '3'
const containerClass = resolveContainer(b.containerWidth ?? 'wide')
const paddingClass = resolvePadding(b)
const padOverrideStyle = resolvePaddingOverrideStyle(b)
const bgResolved = resolveBackground(b.background)

const where: any = {}
if (b.featuredOnly === true) where.isFeatured = { equals: true }
const catId = typeof b.filterCategory === 'object' ? b.filterCategory?.id : b.filterCategory
if (catId) where.category = { equals: catId }

const { docs } = await getPosts({ limit, where, sort: '-publishedAt' }).catch(() => ({ docs: [] as any[] }))

const asMedia = (v: unknown): Media | null => (v && typeof v === 'object' ? (v as Media) : null)

const gridCols =
  columns === '2' ? 'grid-cols-1 md:grid-cols-2' :
  columns === '4' ? 'grid-cols-1 md:grid-cols-2 lg:grid-cols-4' :
                    'grid-cols-1 md:grid-cols-2 lg:grid-cols-3'

const fmtDate = (d?: string | null) => {
  if (!d) return ''
  try { return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) }
  catch { return '' }
}

const showViewAll = b.showViewAll !== false
const viewAllText = b.viewAllText || 'View All Articles'
const viewAllLink = b.viewAllLink || '/blog'
---

<section class:list={['relative overflow-hidden', paddingClass, bgResolved.bgClass]} style={padOverrideStyle}>
  {bgResolved.imageUrl && (
    <>
      <img src={bgResolved.imageUrl} alt="" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
      <div class="absolute inset-0 bg-black" style={`opacity:${bgResolved.overlayOpacity}`}></div>
    </>
  )}
  <div class:list={['relative z-10 mx-auto', containerClass]}>
    {b.heading && (
      <h2 class="font-display text-3xl md:text-4xl mb-2 text-ocean">{b.heading}</h2>
    )}
    {b.description && (
      <p class="text-stone/80 mb-8 max-w-2xl">{b.description}</p>
    )}

    {docs.length === 0 ? (
      <p class="text-stone/60 italic">No posts published yet.</p>
    ) : (
      <div class:list={['grid gap-6 md:gap-8', gridCols]}>
        {docs.map((post: any) => {
          const img = asMedia(post.featuredImage)
          const imgUrl = img?.sizes?.card?.url ?? img?.url ?? ''
          const cat = typeof post.category === 'object' ? post.category?.name : null
          return (
            <a href={`/blog/${post.slug}`} class="group bg-white rounded-lg overflow-hidden shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex flex-col">
              <div class="aspect-[16/10] overflow-hidden relative bg-ocean/5">
                {imgUrl && <img src={imgUrl} alt={img?.alt ?? post.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />}
                {cat && (
                  <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm text-ocean text-xs font-semibold px-2 py-1 rounded-full">{cat}</span>
                )}
              </div>
              <div class="p-5 flex-grow flex flex-col">
                <h3 class="font-display text-lg md:text-xl text-ocean mb-2 line-clamp-2 group-hover:text-coral transition-colors">{post.title}</h3>
                {post.excerpt && <p class="text-sm text-stone/70 mb-4 line-clamp-2">{post.excerpt}</p>}
                <div class="mt-auto pt-3 border-t border-stone/10 flex justify-between items-center text-xs text-stone/60">
                  <span>{fmtDate(post.publishedAt)}</span>
                  {post.readingTimeMinutes && <span>{post.readingTimeMinutes} min read</span>}
                </div>
              </div>
            </a>
          )
        })}
      </div>
    )}

    {showViewAll && docs.length > 0 && (
      <div class="mt-10 text-center">
        <a href={viewAllLink} class="inline-flex items-center gap-2 text-ocean font-semibold border border-ocean px-6 py-2.5 rounded-md hover:bg-ocean hover:text-white transition-colors">
          {viewAllText}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    )}
  </div>
</section>
