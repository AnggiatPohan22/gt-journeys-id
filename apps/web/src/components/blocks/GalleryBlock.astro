---
import type { Page } from '@shared/types/payload-types'
import {
  resolveFitClass, resolvePosClass, resolveAlignment, resolveContainer,
  resolvePadding, resolvePaddingOverrideStyle, resolveEntryAnimation, resolveBackground,
  resolveTextColor, resolveTextAnimIn,
} from '@lib/blockStyles'

type Block = Extract<NonNullable<Page['content']>[number], { blockType: 'gallery' }>
interface Props { block: Block }
const { block } = Astro.props

const b = block as any

// Per-breakpoint columns (new schema). Fallback ke legacy `columns` field.
const legacyCols = block.columns ?? 3
const desktopCols = b.desktopColumns ?? legacyCols
const tabletCols = b.tabletColumns ?? Math.max(1, Math.min(4, legacyCols - 1))
const mobileCols = b.mobileColumns ?? 1

const gridColsClass = [
  mobileCols === 2 ? 'grid-cols-2' : 'grid-cols-1',
  tabletCols === 4 ? 'sm:grid-cols-4' : tabletCols === 3 ? 'sm:grid-cols-3' : tabletCols === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-1',
  desktopCols === 6 ? 'lg:grid-cols-6' : desktopCols === 5 ? 'lg:grid-cols-5' : desktopCols === 4 ? 'lg:grid-cols-4' : desktopCols === 3 ? 'lg:grid-cols-3' : desktopCols === 2 ? 'lg:grid-cols-2' : 'lg:grid-cols-1',
].join(' ')

const layout = block.layout ?? 'grid'
const enableLightbox = b.enableLightbox !== false // default true
const hoverEffect = (b.hoverEffect ?? 'zoom') as 'none' | 'zoom' | 'lift' | 'overlay' | 'grayscale'

const items = block.images.map((entry: any, idx: number) => {
  const img = typeof entry.image === 'object' ? entry.image : null
  return {
    idx,
    url: img?.sizes?.card?.url ?? img?.url ?? '',
    fullUrl: img?.sizes?.hero?.url ?? img?.url ?? '',
    alt: img?.alt ?? entry.caption ?? '',
    caption: entry.caption,
    fit: resolveFitClass(entry.imageFit),
    pos: resolvePosClass(entry.imagePosition),
  }
})

const align = resolveAlignment(b.contentAlignment)
const containerClass = resolveContainer(b.containerWidth)
const paddingClass = resolvePadding(b)
const padOverrideStyle = resolvePaddingOverrideStyle(b)
const entry = resolveEntryAnimation(b.entryAnimation, b.entrySpeed, b.entryDurMs)
const bgResolved = resolveBackground(b.background)

const ts = b.ts ?? {}
const captionColor = resolveTextColor(ts.captionColor)
const captionAnim = resolveTextAnimIn(ts.captionAnimIn)

// Unique id per gallery instance to avoid lightbox conflicts if multiple on page
const galleryId = `gallery-${Math.random().toString(36).slice(2, 9)}`

const hoverClass =
  hoverEffect === 'zoom'      ? 'group-hover:scale-110' :
  hoverEffect === 'lift'      ? 'group-hover:-translate-y-1' :
  hoverEffect === 'grayscale' ? 'grayscale group-hover:grayscale-0' :
                                ''
---

<section class:list={['relative overflow-hidden', paddingClass, bgResolved.bgClass]} data-animate={entry.dataAnimate} style={[padOverrideStyle, entry.style].filter(Boolean).join(";") || undefined}>
  {bgResolved.imageUrl && (
    <>
      <img src={bgResolved.imageUrl} alt="" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
      <div class="absolute inset-0 bg-black" style={`opacity:${bgResolved.overlayOpacity}`}></div>
    </>
  )}
  <div
    class:list={['relative z-10 mx-auto', containerClass, align.text, entry.className]}
    data-gallery-id={galleryId}
    data-enable-lightbox={enableLightbox ? 'true' : 'false'}
  >
    {layout === 'slider' ? (
      <div class="flex gap-4 overflow-x-auto snap-x pb-4">
        {items.map((it) => (
          it.url && (
            <figure class="shrink-0 snap-start w-80">
              <img src={it.url} alt={it.alt} loading="lazy"
                   class:list={['w-full h-64 rounded-lg', it.fit, it.pos]}
                   data-gallery-img={enableLightbox ? it.idx : undefined}
                   data-full={it.fullUrl} data-alt={it.alt} data-caption={it.caption || ''} />
              {it.caption && (
                <figcaption class:list={['mt-2 text-xs', !captionColor && 'text-stone-light', captionColor, captionAnim]}>{it.caption}</figcaption>
              )}
            </figure>
          )
        ))}
      </div>
    ) : (
      <div class:list={['grid gap-4', gridColsClass, layout === 'masonry' && 'items-start']} data-animate="stagger">
        {items.map((it) => (
          it.url && (
            <figure class:list={['group cursor-pointer relative', hoverEffect === 'lift' && 'transition-all duration-300 hover:shadow-xl rounded-lg']}>
              <div class:list={['w-full rounded-lg overflow-hidden relative', layout === 'grid' && 'aspect-[4/3]']}>
                <img src={it.url} alt={it.alt} loading="lazy"
                     class:list={[
                       'w-full h-full transition-all duration-500',
                       hoverClass,
                       layout === 'masonry' ? 'h-auto' : [it.fit, it.pos],
                     ]}
                     data-gallery-img={enableLightbox ? it.idx : undefined}
                     data-full={it.fullUrl} data-alt={it.alt} data-caption={it.caption || ''} />
                {hoverEffect === 'overlay' && (
                  <div class="absolute inset-0 bg-black/0 group-hover:bg-black/40 transition-colors duration-300 flex items-center justify-center">
                    <svg class="w-10 h-10 text-white opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                  </div>
                )}
              </div>
              {it.caption && (
                <figcaption class:list={['mt-2 text-xs', !captionColor && 'text-stone-light', captionColor, captionAnim]}>{it.caption}</figcaption>
              )}
            </figure>
          )
        ))}
      </div>
    )}
  </div>

  {/* Lightbox modal (shared across all galleries on page) */}
  {enableLightbox && (
    <div class="gallery-lightbox fixed inset-0 z-[100] bg-black/90 hidden items-center justify-center backdrop-blur-sm" role="dialog" aria-modal="true">
      <button class="lb-close absolute top-4 right-4 text-white/80 hover:text-white w-12 h-12 flex items-center justify-center rounded-full hover:bg-white/10 transition-colors" aria-label="Close">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
      <button class="lb-prev absolute left-2 md:left-6 top-1/2 -translate-y-1/2 text-white/80 hover:text-white w-12 h-12 md:w-14 md:h-14 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 transition-all hidden md:flex" aria-label="Previous">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </button>
      <button class="lb-next absolute right-2 md:right-6 top-1/2 -translate-y-1/2 text-white/80 hover:text-white w-12 h-12 md:w-14 md:h-14 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 transition-all hidden md:flex" aria-label="Next">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </button>
      <div class="lb-inner max-w-[90vw] max-h-[90vh] flex flex-col items-center gap-4">
        <img class="lb-img max-w-full max-h-[80vh] object-contain rounded-lg" src="" alt="" />
        <p class="lb-caption text-white/80 text-sm text-center max-w-2xl"></p>
      </div>
    </div>
  )}
</section>

<style>
  /* Lightbox open state */
  .gallery-lightbox.is-open {
    display: flex;
    animation: lbFadeIn 220ms ease-out both;
  }
  .gallery-lightbox.is-open .lb-img {
    animation: lbImgIn 320ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes lbFadeIn { from{opacity:0} to{opacity:1} }
  @keyframes lbImgIn { from{opacity:0;transform:scale(.94)} to{opacity:1;transform:scale(1)} }

  @media (prefers-reduced-motion: reduce) {
    .gallery-lightbox.is-open,
    .gallery-lightbox.is-open .lb-img { animation: none; }
  }
</style>

<script>
  const initGalleryLightboxes = () => {
    document.querySelectorAll<HTMLElement>('[data-gallery-id]').forEach((container) => {
      if (container.dataset.enableLightbox !== 'true') return
      const lightbox = container.parentElement?.querySelector<HTMLElement>('.gallery-lightbox')
      if (!lightbox) return

      const imgEl = lightbox.querySelector<HTMLImageElement>('.lb-img')!
      const captionEl = lightbox.querySelector<HTMLElement>('.lb-caption')!
      const closeBtn = lightbox.querySelector<HTMLElement>('.lb-close')!
      const prevBtn = lightbox.querySelector<HTMLElement>('.lb-prev')!
      const nextBtn = lightbox.querySelector<HTMLElement>('.lb-next')!

      const triggers = Array.from(container.querySelectorAll<HTMLImageElement>('[data-gallery-img]'))
      let current = 0

      const show = (idx: number) => {
        const el = triggers[idx]
        if (!el) return
        current = idx
        imgEl.src = el.dataset.full || el.src
        imgEl.alt = el.dataset.alt || ''
        const cap = el.dataset.caption || ''
        captionEl.textContent = cap
        captionEl.style.display = cap ? 'block' : 'none'
        // re-trigger image-in animation
        imgEl.style.animation = 'none'
        void imgEl.offsetWidth
        imgEl.style.animation = ''
      }
      const open = (idx: number) => {
        show(idx)
        lightbox.classList.add('is-open')
        document.body.style.overflow = 'hidden'
      }
      const close = () => {
        lightbox.classList.remove('is-open')
        document.body.style.overflow = ''
      }
      const prev = () => show((current - 1 + triggers.length) % triggers.length)
      const next = () => show((current + 1) % triggers.length)

      triggers.forEach((t, i) => t.addEventListener('click', () => open(i)))
      closeBtn.addEventListener('click', close)
      prevBtn.addEventListener('click', prev)
      nextBtn.addEventListener('click', next)
      lightbox.addEventListener('click', (e) => { if (e.target === lightbox) close() })
      document.addEventListener('keydown', (e) => {
        if (!lightbox.classList.contains('is-open')) return
        if (e.key === 'Escape') close()
        if (e.key === 'ArrowLeft') prev()
        if (e.key === 'ArrowRight') next()
      })
    })
  }
  document.addEventListener('astro:page-load', initGalleryLightboxes)
  initGalleryLightboxes()
</script>
