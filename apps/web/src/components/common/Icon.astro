---
/**
 * Icon — renders SVG icons from Iconify sets (mdi, lucide) with backward
 * compatibility for legacy Material Symbols names.
 *
 * Accepts either:
 *   - Legacy name: "star", "badge", "location_on" → mapped via LEGACY_ICON_MAP
 *   - Iconify id:  "mdi:star", "lucide:heart"    → resolved directly
 *
 * Icons are resolved at build time from @iconify-json/* packages (tree-shaken,
 * only SVG data for icons actually used ends up in the build).
 */
import { getIconData, iconToSVG } from '@iconify/utils'
import { icons as mdiIcons } from '@iconify-json/mdi'
import { icons as lucideIcons } from '@iconify-json/lucide'
import { LEGACY_ICON_MAP } from '@shared/icon-map'

interface Props {
  name: string
  class?: string
  size?: number
  strokeWidth?: number
  label?: string
}

const {
  name,
  class: className = 'w-5 h-5',
  size,
  label,
} = Astro.props

const ICON_SETS: Record<string, typeof mdiIcons> = {
  mdi: mdiIcons,
  lucide: lucideIcons,
}

function resolve(raw: string): { body: string; viewBox: string } | null {
  const id = raw.includes(':') ? raw : LEGACY_ICON_MAP[raw]
  if (!id) return null

  const [prefix, iconName] = id.split(':', 2)
  const set = ICON_SETS[prefix]
  if (!set) return null

  const data = getIconData(set, iconName)
  if (!data) return null

  const svg = iconToSVG(data)
  const w = data.width ?? 24
  const h = data.height ?? 24
  return { body: svg.body, viewBox: `0 0 ${w} ${h}` }
}

const icon = resolve(name)
---

{icon ? (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox={icon.viewBox}
    fill="currentColor"
    class:list={[className]}
    style={size ? `width: ${size}px; height: ${size}px` : undefined}
    aria-hidden={label ? undefined : 'true'}
    aria-label={label}
    role={label ? 'img' : undefined}
    set:html={icon.body}
  />
) : (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    class:list={[className]}
    style={size ? `width: ${size}px; height: ${size}px` : undefined}
    aria-hidden="true"
  />
)}
