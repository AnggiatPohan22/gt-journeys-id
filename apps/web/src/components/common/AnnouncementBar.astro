---
/**
 * AnnouncementBar — Phase 4.33 + Phase 4.44 (advanced theming).
 *
 * Slim site-wide bar rendered in-flow above the header. Gated by:
 *   - Site Features → features.announcementBar (master on/off)
 *   - AnnouncementBar global → message (content must exist)
 *   - Optional startDate/endDate window
 *
 * Colors (Phase 4.44):
 *   - Preset theme select (ocean/coral/leaf/sand) sets the palette.
 *   - Advanced overrides per color slot win when set.
 *   - Rendering pipes both into CSS custom properties on the bar root.
 *
 * Dismiss persistence: localStorage["dnj:ab-dismissed:{version}"]. The
 * version is auto-hashed from the message text by the CMS beforeChange
 * hook, so any message edit auto-invalidates prior dismissals.
 *
 * Zero-flash on repeat visitors: BaseLayout has an inline is:inline
 * script in <head> that reads the same key and stamps
 * <html data-ab-hidden="true"> before body paint. CSS hides the bar
 * before it can render.
 */
import { isFeatureEnabled } from '@lib/features'
import { getAnnouncementBar } from '@lib/payload'

const featureEnabled = await isFeatureEnabled('announcementBar')

let bar: any = null
try { bar = await getAnnouncementBar() } catch { /* fallback: no render */ }

const now = Date.now()
const inWindow =
  (!bar?.startDate || now >= new Date(bar.startDate).getTime()) &&
  (!bar?.endDate || now <= new Date(bar.endDate).getTime())

const hasMessage = !!bar?.message

// Homepage scope check (mirrors PromoBanner).
const showOnHomepageOnly: boolean = bar?.showOnHomepageOnly === true
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/'
const isHomepage = currentPath === '/'
const scopeMatches = !showOnHomepageOnly || isHomepage

const shouldRender = featureEnabled && hasMessage && inWindow && scopeMatches

const message: string = bar?.message ?? ''
const theme: 'ocean' | 'coral' | 'leaf' | 'sand' = bar?.theme ?? 'ocean'
const dismissible: boolean = bar?.dismissible !== false
const version: string = bar?.version ?? 'v0'
const frequencyMinutes: number = Number(bar?.displayFrequency ?? '1440') || 1440

const link = bar?.link
const linkEnabled = !!link?.enabled && !!link?.url
const linkLabel: string = link?.label ?? 'Learn more'
const linkUrl: string = link?.url ?? '#'
const linkNewTab: boolean = !!link?.newTab

// ── Colors: preset theme → default overrides. Advanced fills win. ──
const themeDefaults: Record<string, { bg: string; text: string; link: string; linkHover: string }> = {
  ocean: { bg: '#1B3A4B', text: '#F5F0E8', link: '#F5F0E8', linkHover: '#FFFFFF' },
  coral: { bg: '#E07A5F', text: '#F5F0E8', link: '#F5F0E8', linkHover: '#FFFFFF' },
  leaf:  { bg: '#6B9080', text: '#F5F0E8', link: '#F5F0E8', linkHover: '#FFFFFF' },
  sand:  { bg: '#F5F0E8', text: '#1B3A4B', link: '#1B3A4B', linkHover: '#0D1B2A' },
}
const td = themeDefaults[theme] ?? themeDefaults.ocean
const adv = bar?.advanced ?? {}
const pick = (v: string | null | undefined, fallback: string) =>
  (v && /^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(v) ? v : fallback)
const themeVars = {
  '--ab-bg':          pick(adv.bgColor,        td.bg),
  '--ab-text':        pick(adv.textColor,      td.text),
  '--ab-link':        pick(adv.linkColor,      td.link),
  '--ab-link-hover':  pick(adv.linkHoverColor, td.linkHover),
}
const themeStyle = Object.entries(themeVars).map(([k, v]) => `${k}:${v}`).join(';')
---

{shouldRender && (
  <div
    class="announcement-bar dnj-ab w-full text-xs sm:text-sm font-body overflow-hidden transition-[max-height,opacity] duration-200 ease-out"
    style={themeStyle}
    data-ab-version={version}
    data-ab-dismissible={dismissible ? '1' : '0'}
    data-ab-frequency-minutes={String(frequencyMinutes)}
    role="region"
    aria-label="Site announcement"
  >
    <div class="max-w-[1440px] mx-auto flex items-center justify-center gap-3 sm:gap-4 px-4 py-2 min-h-[36px]">
      <span class="flex-1 text-center leading-snug">
        {message}
        {linkEnabled && (
          <>
            {' '}
            <a
              href={linkUrl}
              target={linkNewTab ? '_blank' : undefined}
              rel={linkNewTab ? 'noopener noreferrer' : undefined}
              class="dnj-ab-link underline underline-offset-2 font-semibold"
            >
              {linkLabel}
            </a>
          </>
        )}
      </span>
      {dismissible && (
        <button
          type="button"
          class="ab-dismiss shrink-0 -mr-1 w-7 h-7 rounded-full flex items-center justify-center hover:bg-black/10 focus:outline-none focus:ring-2 focus:ring-white/40 transition-colors"
          aria-label="Dismiss announcement"
        >
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
          </svg>
        </button>
      )}
    </div>
  </div>
)}

<style is:global>
  /* Phase 4.44 — Announcement Bar via CSS custom properties. */
  .dnj-ab { background-color: var(--ab-bg); color: var(--ab-text); }
  .dnj-ab .dnj-ab-link { color: var(--ab-link); transition: color 200ms; }
  .dnj-ab .dnj-ab-link:hover { color: var(--ab-link-hover); }
</style>

<script>
  const DISMISS_KEY_PREFIX = 'dnj:ab-dismissed:'
  const MINUTE_MS = 60_000

  const init = () => {
    const bar = document.querySelector<HTMLElement>('.announcement-bar')
    if (!bar) return

    const version = bar.dataset.abVersion ?? 'v0'
    const frequencyMinutes = Number(bar.dataset.abFrequencyMinutes ?? '1440')
    const key = DISMISS_KEY_PREFIX + version

    try {
      const raw = localStorage.getItem(key)
      if (raw) {
        const ts = Number(raw)
        if (Number.isFinite(ts) && Date.now() - ts < frequencyMinutes * MINUTE_MS) {
          bar.style.display = 'none'
          return
        }
        localStorage.removeItem(key)
      }
    } catch { /* localStorage blocked — render as normal */ }

    const btn = bar.querySelector<HTMLButtonElement>('.ab-dismiss')
    btn?.addEventListener('click', () => {
      try { localStorage.setItem(key, String(Date.now())) } catch { /* ignore */ }
      bar.style.maxHeight = bar.offsetHeight + 'px'
      // eslint-disable-next-line @typescript-eslint/no-unused-expressions
      bar.offsetHeight
      bar.style.maxHeight = '0px'
      bar.style.opacity = '0'
      bar.addEventListener(
        'transitionend',
        () => { bar.style.display = 'none' },
        { once: true },
      )
    })
  }

  document.addEventListener('astro:page-load', init)
  init()
</script>
