---
/**
 * Render satu atau beberapa JSON-LD schema object sebagai
 * <script type="application/ld+json">. Boleh ditaruh di <head> atau <body>
 * (Google menerima keduanya). Lihat lib/structuredData.ts untuk builder.
 */
interface Props {
  schema: Record<string, unknown> | Record<string, unknown>[]
}
const { schema } = Astro.props
const list = Array.isArray(schema) ? schema : [schema]
---
{list.map((s) => (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />
))}
