---
/**
 * PromoBannerModal — Phase 4.33.
 *
 * Timed pop-up modal. Gated by:
 *   - Site Features → sections.promoBanner (master on/off)
 *   - PromoBanner global → headline (content must exist)
 *   - Optional startDate/endDate window
 *
 * Two themes:
 *   - theme1-with-image: image left / copy right (stacks on mobile)
 *   - theme2-text-only : centered copy + CTA (no image)
 *
 * Trigger: setTimeout(triggerDelay*1000) after page-load. If
 * `suppressAfterScroll` is ON and the visitor is already >50% down
 * the page before the timer fires, the modal is skipped.
 *
 * Frequency: localStorage["dnj:promo:lastShown"] holds the timestamp
 * of last close/CTA. Skipped if within `displayFrequencyDays` days.
 *
 * A11y: role=dialog, aria-modal, ESC closes, backdrop click closes,
 * focus moves into modal on open, restored to previously-focused el
 * on close.
 */
import { isSectionEnabled } from '@lib/features'
import { getPromoBanner } from '@lib/payload'

const featureEnabled = await isSectionEnabled('promoBanner')

let promo: any = null
try { promo = await getPromoBanner() } catch { /* fallback: no render */ }

const now = Date.now()
const inWindow =
  (!promo?.startDate || now >= new Date(promo.startDate).getTime()) &&
  (!promo?.endDate || now <= new Date(promo.endDate).getTime())

const hasHeadline = !!promo?.headline

const showOnHomepageOnly: boolean = promo?.showOnHomepageOnly !== false
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/'
const isHomepage = currentPath === '/'
const scopeMatches = !showOnHomepageOnly || isHomepage

const shouldRender = featureEnabled && hasHeadline && inWindow && scopeMatches

const theme: 'theme1-with-image' | 'theme2-text-only' = promo?.theme ?? 'theme1-with-image'
const headline: string = promo?.headline ?? ''
const subheadline: string = promo?.subheadline ?? ''
const imageObj = promo?.image
const imageUrl: string = typeof imageObj === 'object' && imageObj?.url ? imageObj.url : ''
const imageAlt: string = typeof imageObj === 'object' && imageObj?.alt ? imageObj.alt : headline
const cta = promo?.cta ?? {}
const ctaLabel: string = cta?.label ?? 'Learn More'
const ctaUrl: string = cta?.url ?? '#'
const ctaNewTab: boolean = !!cta?.newTab

const triggerDelaySec: number = typeof promo?.triggerDelay === 'number' ? promo.triggerDelay : 5
// displayFrequency is stored as a preset string of MINUTES:
// '30' | '60' | '360' | '720' | '1440'. Fallback: 1440 (1 day).
const frequencyMinutes: number = Number(promo?.displayFrequency ?? '1440') || 1440
const suppressAfterScroll: boolean = promo?.suppressAfterScroll !== false
// Version keys the visitor cookie — any CMS save (content edit or
// resetVisitorCookies toggle) bumps this hash, invalidating cookies.
const version: string = promo?.version ?? 'v0'

// Theme 1 requires an image; if none provided, degrade to theme 2 layout.
const effectiveTheme = theme === 'theme1-with-image' && !imageUrl ? 'theme2-text-only' : theme

// ── Advanced theming (Phase 4.44) ──
// Default warna Phase 4.33 (panel sand, heading ocean, CTA coral). Override
// jika `advanced.*` di-set. Kosong = pakai default.
// Phase 4.45 — default backdrop & body pakai 8-digit hex (alpha inclusive).
// Backdrop default `#0D1B2A99` = ~60% alpha (matches prior color-mix trick).
// Body default `#1B3A4BBF` = ~75% alpha.
const promoDefaults = {
  panelBg:    '#F5F0E8',
  backdrop:   '#0D1B2A99',
  heading:    '#1B3A4B',
  body:       '#1B3A4BBF',
  ctaBg:      '#E07A5F',
  ctaBgHover: '#C4583E',
  ctaText:    '#F5F0E8',
}
const promoAdv = promo?.advanced ?? {}
const pickHex = (v: string | null | undefined, fallback: string) =>
  (v && /^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$/.test(v) ? v : fallback)
const CTA_RADIUS_CSS: Record<string, string> = {
  pill: '9999px',
  rounded: '12px',
  'rounded-md': '6px',
  square: '0px',
}
const ctaRadius = CTA_RADIUS_CSS[promoAdv.ctaRadius ?? 'rounded'] ?? '12px'
const themeVars = {
  '--pb-panel-bg':      pickHex(promoAdv.panelBgColor,    promoDefaults.panelBg),
  '--pb-backdrop':      pickHex(promoAdv.backdropColor,   promoDefaults.backdrop),
  '--pb-heading':       pickHex(promoAdv.headingColor,    promoDefaults.heading),
  '--pb-body':          pickHex(promoAdv.bodyColor,       promoDefaults.body),
  '--pb-cta-bg':        pickHex(promoAdv.ctaBgColor,      promoDefaults.ctaBg),
  '--pb-cta-bg-hover':  pickHex(promoAdv.ctaBgHoverColor, promoDefaults.ctaBgHover),
  '--pb-cta-text':      pickHex(promoAdv.ctaTextColor,    promoDefaults.ctaText),
  '--pb-cta-radius':    ctaRadius,
}
const themeStyle = Object.entries(themeVars).map(([k, v]) => `${k}:${v}`).join(';')
---

{shouldRender && (
  <div
    class="promo-modal-root dnj-pb fixed inset-0 z-[60] hidden items-center justify-center p-4 sm:p-6"
    style={themeStyle}
    data-trigger-delay={String(triggerDelaySec)}
    data-frequency-minutes={String(frequencyMinutes)}
    data-suppress-scroll={suppressAfterScroll ? '1' : '0'}
    data-promo-version={version}
    role="dialog"
    aria-modal="true"
    aria-labelledby="promo-modal-title"
  >
    {/* Backdrop */}
    <div class="promo-modal-backdrop dnj-pb-backdrop absolute inset-0 backdrop-blur-[2px] opacity-0 transition-opacity duration-200"></div>

    {/* Panel */}
    <div class:list={[
      'promo-modal-panel dnj-pb-panel relative shadow-2xl overflow-hidden opacity-0 scale-95 transition-all duration-200 ease-out rounded-2xl',
      effectiveTheme === 'theme1-with-image'
        ? 'w-full max-w-3xl grid grid-cols-1 md:grid-cols-2'
        : 'w-full max-w-lg px-6 sm:px-10 py-10 sm:py-14 text-center',
    ]}>
      {/* × Close */}
      <button
        type="button"
        class="promo-modal-close dnj-pb-close absolute top-3 right-3 w-9 h-9 rounded-full flex items-center justify-center focus:outline-none focus:ring-2 z-10"
        aria-label="Close promotion"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 2L14 14M14 2L2 14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
        </svg>
      </button>

      {effectiveTheme === 'theme1-with-image' && (
        <div class="dnj-pb-image aspect-[4/3] md:aspect-auto md:min-h-[320px]">
          <img src={imageUrl} alt={imageAlt} class="w-full h-full object-cover" loading="lazy" />
        </div>
      )}

      <div class:list={[
        effectiveTheme === 'theme1-with-image'
          ? 'p-6 sm:p-8 flex flex-col justify-center'
          : '',
      ]}>
        <h2 id="promo-modal-title" class="dnj-pb-heading font-display text-2xl sm:text-3xl font-semibold leading-tight mb-3">
          {headline}
        </h2>
        {subheadline && (
          <p class="dnj-pb-body text-sm sm:text-base mb-6 leading-relaxed">
            {subheadline}
          </p>
        )}
        <a
          href={ctaUrl}
          target={ctaNewTab ? '_blank' : undefined}
          rel={ctaNewTab ? 'noopener noreferrer' : undefined}
          class:list={[
            'promo-modal-cta dnj-pb-cta inline-flex items-center justify-center h-12 px-6 font-semibold transition-colors',
            effectiveTheme === 'theme2-text-only' ? 'mx-auto' : 'self-start',
          ]}
        >
          {ctaLabel}
        </a>
      </div>
    </div>
  </div>
)}

<style is:global>
  /* Phase 4.44 — Promo Modal via CSS custom properties. */
  /* Phase 4.45 — Backdrop & body pakai warna langsung (alpha ada di
     nilai hex 8-digit). Script animates opacity 0→1 di backdrop. */
  .dnj-pb .dnj-pb-backdrop { background-color: var(--pb-backdrop); }
  .dnj-pb .dnj-pb-panel { background-color: var(--pb-panel-bg); color: var(--pb-heading); }
  .dnj-pb .dnj-pb-image { background-color: color-mix(in srgb, var(--pb-heading) 5%, transparent); }
  .dnj-pb .dnj-pb-heading { color: var(--pb-heading); }
  .dnj-pb .dnj-pb-body { color: var(--pb-body); }
  .dnj-pb .dnj-pb-close {
    background-color: color-mix(in srgb, var(--pb-heading) 10%, transparent);
    color: var(--pb-heading);
  }
  .dnj-pb .dnj-pb-close:hover {
    background-color: color-mix(in srgb, var(--pb-heading) 20%, transparent);
  }
  .dnj-pb .dnj-pb-close:focus { --tw-ring-color: var(--pb-cta-bg); }
  .dnj-pb .dnj-pb-cta {
    background-color: var(--pb-cta-bg);
    color: var(--pb-cta-text);
    border-radius: var(--pb-cta-radius, 12px);
  }
  .dnj-pb .dnj-pb-cta:hover { background-color: var(--pb-cta-bg-hover); }

  /* Backdrop opacity applied by script via inline style — we default to 60%
     via a fallback when the panel is visible. Script sets opacity: 1 on open,
     opacity: 0 on close; because backdrop uses solid bg color, we compose it
     with a wrapper opacity. Keep the original script-driven fade. */
</style>

<script>
  const MINUTE_MS = 60_000
  const OLD_KEY = 'dnj:promo:lastShown' // Phase 4.33 pre-version key — cleared on load

  const init = () => {
    const root = document.querySelector<HTMLElement>('.promo-modal-root')
    if (!root || root.dataset.bound === '1') return
    root.dataset.bound = '1'

    const delaySec = Number(root.dataset.triggerDelay ?? '5')
    const frequencyMinutes = Number(root.dataset.frequencyMinutes ?? '1440')
    const suppressScroll = root.dataset.suppressScroll === '1'
    const version = root.dataset.promoVersion ?? 'v0'
    const LAST_KEY = 'dnj:promo:lastShown:' + version

    // Frequency check — cookie is version-keyed, so any CMS save
    // (content change or resetVisitorCookies) invalidates it.
    try {
      // Clear legacy unversioned key so visitors from earlier releases
      // don't carry a stale timestamp forward.
      localStorage.removeItem(OLD_KEY)
      const last = Number(localStorage.getItem(LAST_KEY) ?? '0')
      if (last && Date.now() - last < frequencyMinutes * MINUTE_MS) return
    } catch { /* localStorage blocked — proceed once */ }

    const backdrop = root.querySelector<HTMLElement>('.promo-modal-backdrop')
    const panel = root.querySelector<HTMLElement>('.promo-modal-panel')
    const closeBtn = root.querySelector<HTMLButtonElement>('.promo-modal-close')
    const ctaLink = root.querySelector<HTMLAnchorElement>('.promo-modal-cta')
    if (!backdrop || !panel || !closeBtn) return

    let previouslyFocused: HTMLElement | null = null

    const scrolledPast50 = () => {
      const scrollable = document.documentElement.scrollHeight - window.innerHeight
      if (scrollable <= 0) return false
      return window.scrollY / scrollable > 0.5
    }

    // Scroll-lock: preserve original body inline styles so we can
    // restore them precisely on close. Also compensate for the
    // scrollbar width so removing overflow doesn't shift the layout.
    const savedBodyStyle = { overflow: '', paddingRight: '' }

    const lockScroll = () => {
      const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth
      savedBodyStyle.overflow = document.body.style.overflow
      savedBodyStyle.paddingRight = document.body.style.paddingRight
      document.body.style.overflow = 'hidden'
      if (scrollbarWidth > 0) {
        document.body.style.paddingRight = `${scrollbarWidth}px`
      }
    }

    const unlockScroll = () => {
      document.body.style.overflow = savedBodyStyle.overflow
      document.body.style.paddingRight = savedBodyStyle.paddingRight
    }

    const open = () => {
      if (suppressScroll && scrolledPast50()) return
      previouslyFocused = document.activeElement as HTMLElement | null
      lockScroll()
      root.classList.remove('hidden')
      root.classList.add('flex')
      // Next frame → fade in
      requestAnimationFrame(() => {
        backdrop.style.opacity = '1'
        panel.style.opacity = '1'
        panel.style.transform = 'scale(1)'
      })
      closeBtn.focus()
      document.addEventListener('keydown', onKey)
    }

    const close = (recordShown = true) => {
      if (recordShown) {
        try {
          localStorage.setItem(LAST_KEY, String(Date.now()))
        } catch { /* ignore */ }
      }
      backdrop.style.opacity = '0'
      panel.style.opacity = '0'
      panel.style.transform = 'scale(0.95)'
      root.addEventListener('transitionend', () => {
        root.classList.add('hidden')
        root.classList.remove('flex')
        unlockScroll()
      }, { once: true })
      document.removeEventListener('keydown', onKey)
      previouslyFocused?.focus?.()
    }

    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') close()
    }

    closeBtn.addEventListener('click', () => close())
    backdrop.addEventListener('click', () => close())
    ctaLink?.addEventListener('click', () => close())

    const timer = window.setTimeout(open, Math.max(0, delaySec) * 1000)
    // Cancel timer if the visitor navigates away before it fires
    document.addEventListener('astro:before-preparation', () => window.clearTimeout(timer), { once: true })
  }

  document.addEventListener('astro:page-load', init)
  init()
</script>
