---
// Render a Payload/Lexical richText document as styled HTML.
// Uses the existing lexicalToHtml serializer (paragraph, headings,
// list/listitem, link, quote, inline format bitflags). Adds a
// scoped typography class so headings/quotes/lists get article-body
// spacing without leaking into other richText usages.
//
// Usage:
//   <LexicalRenderer doc={post.body} />
import { lexicalToHtml } from '@lib/lexical'

interface Props {
  doc: unknown
  class?: string
}

const { doc, class: className = '' } = Astro.props
const html = lexicalToHtml(doc)
---

<div class:list={['lexical-body', className]} set:html={html} />

<style>
  .lexical-body :global(p) {
    margin-block: 1rem;
    line-height: 1.7;
  }
  .lexical-body :global(h2) {
    margin-block: 2.25rem 1rem;
    font-size: 1.75rem;
    line-height: 1.25;
    font-weight: 600;
  }
  .lexical-body :global(h3) {
    margin-block: 1.75rem 0.75rem;
    font-size: 1.375rem;
    line-height: 1.3;
    font-weight: 600;
  }
  .lexical-body :global(h4) {
    margin-block: 1.5rem 0.5rem;
    font-size: 1.125rem;
    font-weight: 600;
  }
  .lexical-body :global(ul),
  .lexical-body :global(ol) {
    margin-block: 1rem;
    padding-inline-start: 1.5rem;
  }
  .lexical-body :global(ul) { list-style: disc; }
  .lexical-body :global(ol) { list-style: decimal; }
  .lexical-body :global(li) {
    margin-block: 0.35rem;
    line-height: 1.6;
  }
  .lexical-body :global(blockquote) {
    margin-block: 2rem;
    padding: 1.25rem 1.5rem;
    border-inline-start: 4px solid var(--color-primary, #004873);
    background: color-mix(in oklab, var(--color-primary, #004873) 6%, transparent);
    font-style: italic;
    border-radius: 0 0.5rem 0.5rem 0;
  }
  .lexical-body :global(a) {
    color: var(--color-primary, #004873);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .lexical-body :global(a:hover) { opacity: 0.85; }
  .lexical-body :global(code) {
    padding: 0.15em 0.4em;
    border-radius: 0.25rem;
    background: rgba(0, 0, 0, 0.06);
    font-size: 0.92em;
  }
  .lexical-body :global(strong) { font-weight: 600; }
  .lexical-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
    margin-block: 1.5rem;
  }
</style>
