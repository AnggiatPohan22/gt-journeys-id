---
/**
 * DnJourneysBali — Photo lightbox (Phase 4.26 · B2, pilot).
 *
 * Fullscreen lightbox with prev/next buttons (visible on mobile too),
 * touch-swipe (native touchstart/touchend, no lib), keyboard nav
 * (Esc / ← / →), and body-scroll lock. Multiple triggers on the page
 * can open it via `data-open-lightbox="<id>"` + `data-index="<n>"`,
 * or programmatically via `window.__openPhotoLightbox(id, index)`.
 *
 * Pilot scope: villa detail page. GalleryBlock.astro's own lightbox is
 * left alone.
 */
export interface LightboxPhoto {
  url: string
  alt: string
  caption?: string
}

interface Props {
  id: string
  photos: LightboxPhoto[]
}

const { id, photos } = Astro.props
const dataId = `photo-lightbox-${id}`
---

<div
  class="photo-lightbox fixed inset-0 z-[100] bg-black/95 hidden items-center justify-center backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-label="Photo gallery"
  data-lightbox-id={id}
  id={dataId}
>
  <button
    type="button"
    class="lb-close absolute top-4 right-4 text-white/80 hover:text-white w-12 h-12 flex items-center justify-center rounded-full hover:bg-white/10 transition-colors z-10"
    aria-label="Close"
  >
    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
  </button>

  <span class="lb-counter absolute top-6 left-6 text-white/80 text-sm font-medium select-none">1 / {photos.length}</span>

  <button
    type="button"
    class="lb-prev absolute left-2 md:left-6 top-1/2 -translate-y-1/2 text-white/80 hover:text-white w-11 h-11 md:w-14 md:h-14 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 transition-all z-10"
    aria-label="Previous"
  >
    <svg class="w-6 h-6 md:w-7 md:h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
  </button>

  <button
    type="button"
    class="lb-next absolute right-2 md:right-6 top-1/2 -translate-y-1/2 text-white/80 hover:text-white w-11 h-11 md:w-14 md:h-14 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 transition-all z-10"
    aria-label="Next"
  >
    <svg class="w-6 h-6 md:w-7 md:h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  </button>

  <div class="lb-inner max-w-[95vw] max-h-[92vh] w-full h-full flex flex-col items-center justify-center gap-3 px-4">
    <img class="lb-img max-w-full max-h-[80vh] object-contain rounded-lg select-none" src="" alt="" draggable="false" />
    <p class="lb-caption text-white/80 text-sm text-center max-w-2xl min-h-[1.25rem]"></p>
  </div>
</div>

<script type="application/json" data-lightbox-data={id} set:html={JSON.stringify(photos)} />

<style>
  .photo-lightbox.is-open {
    display: flex;
    animation: lbFadeIn 220ms ease-out both;
  }
  .photo-lightbox.is-open .lb-img {
    animation: lbImgIn 320ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes lbFadeIn { from{opacity:0} to{opacity:1} }
  @keyframes lbImgIn { from{opacity:0;transform:scale(.96)} to{opacity:1;transform:scale(1)} }
  @media (prefers-reduced-motion: reduce) {
    .photo-lightbox.is-open,
    .photo-lightbox.is-open .lb-img { animation: none; }
  }
</style>

<script>
  type LightboxPhoto = { url: string; alt: string; caption?: string }

  const initPhotoLightboxes = () => {
    const w = window as any
    // Registry keyed by lightbox id → controller
    if (!w.__photoLightboxes) w.__photoLightboxes = {}

    document.querySelectorAll<HTMLElement>('.photo-lightbox[data-lightbox-id]').forEach((box) => {
      const id = box.dataset.lightboxId!
      if (w.__photoLightboxes[id]) return // already wired this page-load

      const dataEl = document.querySelector<HTMLScriptElement>(`script[data-lightbox-data="${id}"]`)
      const photos: LightboxPhoto[] = dataEl ? JSON.parse(dataEl.textContent || '[]') : []
      if (photos.length === 0) return

      const imgEl = box.querySelector<HTMLImageElement>('.lb-img')!
      const capEl = box.querySelector<HTMLElement>('.lb-caption')!
      const counterEl = box.querySelector<HTMLElement>('.lb-counter')!
      const closeBtn = box.querySelector<HTMLElement>('.lb-close')!
      const prevBtn = box.querySelector<HTMLElement>('.lb-prev')!
      const nextBtn = box.querySelector<HTMLElement>('.lb-next')!
      const innerEl = box.querySelector<HTMLElement>('.lb-inner')!

      let current = 0

      const show = (idx: number) => {
        current = ((idx % photos.length) + photos.length) % photos.length
        const p = photos[current]
        imgEl.src = p.url
        imgEl.alt = p.alt || ''
        const cap = p.caption || ''
        capEl.textContent = cap
        capEl.style.visibility = cap ? 'visible' : 'hidden'
        counterEl.textContent = `${current + 1} / ${photos.length}`
        // re-trigger image-in animation
        imgEl.style.animation = 'none'
        void imgEl.offsetWidth
        imgEl.style.animation = ''
      }
      const open = (idx: number) => {
        show(idx)
        box.classList.add('is-open')
        document.body.style.overflow = 'hidden'
      }
      const close = () => {
        box.classList.remove('is-open')
        document.body.style.overflow = ''
      }
      const prev = () => show(current - 1)
      const next = () => show(current + 1)

      closeBtn.addEventListener('click', close)
      prevBtn.addEventListener('click', prev)
      nextBtn.addEventListener('click', next)
      box.addEventListener('click', (e) => {
        if (e.target === box || e.target === innerEl) close()
      })

      // Touch swipe on the inner container (works over the image too).
      let touchX: number | null = null
      let touchY: number | null = null
      innerEl.addEventListener('touchstart', (e) => {
        if (e.touches.length !== 1) return
        touchX = e.touches[0].clientX
        touchY = e.touches[0].clientY
      }, { passive: true })
      innerEl.addEventListener('touchend', (e) => {
        if (touchX === null || touchY === null) return
        const t = e.changedTouches[0]
        const dx = t.clientX - touchX
        const dy = t.clientY - touchY
        touchX = touchY = null
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
          if (dx < 0) next(); else prev()
        }
      }, { passive: true })

      document.addEventListener('keydown', (e) => {
        if (!box.classList.contains('is-open')) return
        if (e.key === 'Escape') { e.preventDefault(); close() }
        else if (e.key === 'ArrowLeft') { e.preventDefault(); prev() }
        else if (e.key === 'ArrowRight') { e.preventDefault(); next() }
      })

      w.__photoLightboxes[id] = { open, close, show, count: photos.length }
    })

    // Global opener helper for programmatic triggers (e.g. hero swipe tap).
    if (!w.__openPhotoLightbox) {
      w.__openPhotoLightbox = (id: string, index = 0) => {
        const ctl = w.__photoLightboxes?.[id]
        if (ctl) ctl.open(index)
      }
    }

    // Wire up data-open-lightbox triggers (attach once per element).
    document.querySelectorAll<HTMLElement>('[data-open-lightbox]').forEach((el) => {
      if ((el as any).__lbBound) return
      ;(el as any).__lbBound = true
      el.addEventListener('click', (e) => {
        const id = el.dataset.openLightbox!
        const index = parseInt(el.dataset.index || '0', 10)
        e.preventDefault()
        w.__openPhotoLightbox(id, isNaN(index) ? 0 : index)
      })
    })
  }

  document.addEventListener('astro:page-load', initPhotoLightboxes)
  initPhotoLightboxes()
</script>
