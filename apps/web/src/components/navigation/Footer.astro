---
import { siteConfig } from '@config/site'
import { getResolvedServiceTypes } from '@lib/serviceTypes'
import { getSiteSettings, getFooterSettings } from '@lib/payload'
import Icon from '@components/common/Icon.astro'
import type { Media, SiteSetting } from '@shared/types/payload-types'

// Fetch: SiteSettings (branding/contact/social/copyright) + FooterSettings (menu columns)
let settings: SiteSetting | null = null
let footerCfg: any = null
try { settings = await getSiteSettings() } catch { /* fallback */ }
try { footerCfg = await getFooterSettings() } catch { /* fallback */ }

// Resolve footer columns — CMS-driven. Each column's `menu` relationship is
// already populated with items[] by the global fetch, so read from it directly.
type FooterColumn = { label: string; items: { label: string; url: string; target?: string }[] }
const footerColumns: FooterColumn[] = []
const columnsRaw = (footerCfg?.columns ?? []) as Array<{ columnLabel?: string; menu?: any }>
for (const c of columnsRaw) {
  const menu = (c.menu && typeof c.menu === 'object' && Array.isArray(c.menu.items)) ? c.menu : null
  if (!menu) continue
  const items = (menu.items ?? []).map((it: any) => ({
    label: it.label,
    url: it.url ?? '#',
    target: it.target ?? undefined,
  }))
  if (items.length > 0) footerColumns.push({ label: c.columnLabel ?? 'Links', items })
}

// Fallback: kalau FooterSettings kosong, tampilkan static Quick Links legacy
const useFallbackQuickLinks = footerColumns.length === 0

const siteName = settings?.siteName ?? siteConfig.name
const tagline = settings?.tagline ?? siteConfig.tagline
const logo = (typeof settings?.logo === 'object' ? settings.logo : null) as Media | null
const logoUrl = logo?.url ?? ''
const logoAlt = logo?.alt ?? siteName

const contact = {
  email: settings?.contact?.email ?? siteConfig.contact.email,
  phone: settings?.contact?.phone ?? siteConfig.contact.phone,
  address: settings?.contact?.address ?? siteConfig.contact.address,
}
const businessHours = settings?.whatsappDefaults?.businessHours

const social = {
  instagram: settings?.socialMedia?.instagram ?? siteConfig.social.instagram,
  facebook: settings?.socialMedia?.facebook ?? siteConfig.social.facebook,
  tiktok: settings?.socialMedia?.tiktok ?? siteConfig.social.tiktok,
  youtube: settings?.socialMedia?.youtube ?? siteConfig.social.youtube,
  tripadvisor: settings?.socialMedia?.tripadvisor ?? siteConfig.social.tripadvisor,
}
const copyright = settings?.footer?.copyrightText
const additionalScripts = settings?.footer?.additionalScripts as string | undefined

// Normalize bare social handles to full URLs
const socialUrl = (platform: keyof typeof social) => {
  const raw = social[platform]
  if (!raw) return ''
  if (/^https?:\/\//.test(raw)) return raw
  const bases: Record<keyof typeof social, string> = {
    instagram: 'https://instagram.com/',
    facebook: 'https://facebook.com/',
    tiktok: 'https://tiktok.com/@',
    youtube: 'https://youtube.com/@',
    tripadvisor: 'https://tripadvisor.com/',
  }
  return bases[platform] + raw.replace(/^@/, '')
}

// ── Column toggles + labels (FooterSettings-driven, default true) ─────
const showBrand = footerCfg?.showBrandColumn !== false
const brandTaglineOverride = footerCfg?.brandTaglineOverride as string | undefined
const brandTagline = brandTaglineOverride || tagline

const showServices = footerCfg?.showServicesColumn !== false
const servicesLabel = footerCfg?.servicesColumnLabel || 'Our Services'
// Services items — cascade: explicit CMS `servicesMenu` → ServiceTypes collection
// (CMS-editable metadata) → modules.ts hardcoded fallback (di dalam resolver).
let servicesItems: Array<{ label: string; url: string; target?: string }>
const servicesMenuData = footerCfg?.servicesMenu
const servicesMenuPopulated = (servicesMenuData && typeof servicesMenuData === 'object' && Array.isArray(servicesMenuData.items))
  ? servicesMenuData
  : null
if (servicesMenuPopulated) {
  servicesItems = (servicesMenuPopulated.items ?? []).map((it: any) => ({
    label: it.label, url: it.url ?? '#', target: it.target ?? undefined,
  }))
} else {
  const svcTypes = await getResolvedServiceTypes()
  servicesItems = svcTypes.map((s) => ({ label: s.name, url: `/${s.slug}` }))
}

const showContact = footerCfg?.showContactColumn !== false
const contactLabel = footerCfg?.contactColumnLabel || 'Contact Us'

const bottomRight = footerCfg?.bottomBarRightText || 'Designed with ♥ in Bali'

const currentYear = new Date().getFullYear()
---

<footer class="bg-ocean text-white/85">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">

      <!-- Brand + social (toggleable via FooterSettings.showBrandColumn) -->
      {showBrand && (
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-3 no-underline text-white">
          {logoUrl ? (
            <img src={logoUrl} alt={logoAlt} class="h-10 w-10 rounded-full object-cover" />
          ) : (
            <span aria-hidden="true" class="h-10 w-10 rounded-full bg-white/10 flex items-center justify-center font-display font-bold text-white text-sm">
              {siteName.slice(0, 2)}
            </span>
          )}
          <span class="font-display text-xl font-bold">{siteName}</span>
        </a>

        {brandTagline && (
          <p class="mt-4 text-sm leading-relaxed text-white/70">{brandTagline}</p>
        )}

        <div class="flex gap-3 mt-6">
          {social.instagram && (
            <a href={socialUrl('instagram')} target="_blank" rel="noopener noreferrer"
               class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white/80 hover:text-white transition-colors no-underline"
               aria-label="Instagram">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
          )}
          {social.facebook && (
            <a href={socialUrl('facebook')} target="_blank" rel="noopener noreferrer"
               class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white/80 hover:text-white transition-colors no-underline"
               aria-label="Facebook">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.99 22 12z"/></svg>
            </a>
          )}
          {social.tiktok && (
            <a href={socialUrl('tiktok')} target="_blank" rel="noopener noreferrer"
               class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white/80 hover:text-white transition-colors no-underline"
               aria-label="TikTok">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43V8.35a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.84-.35z"/></svg>
            </a>
          )}
          {social.youtube && (
            <a href={socialUrl('youtube')} target="_blank" rel="noopener noreferrer"
               class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white/80 hover:text-white transition-colors no-underline"
               aria-label="YouTube">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
          )}
        </div>
      </div>
      )}

      <!-- CMS-driven footer columns (from FooterSettings.columns) -->
      {footerColumns.map((col) => (
        <div>
          <h4 class="font-display text-white text-sm uppercase tracking-widest mb-6">{col.label}</h4>
          <ul class="space-y-3 text-sm">
            {col.items.map((it) => (
              <li>
                <a
                  href={it.url}
                  target={it.target === '_blank' ? '_blank' : undefined}
                  rel={it.target === '_blank' ? 'noopener noreferrer' : undefined}
                  class="text-white/70 hover:text-white transition-colors no-underline">
                  {it.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      {/* Fallback Quick Links kalau FooterSettings kosong */}
      {useFallbackQuickLinks && (
        <div>
          <h4 class="font-display text-white text-sm uppercase tracking-widest mb-6">Quick Links</h4>
          <ul class="space-y-3 text-sm">
            <li><a href="/" class="text-white/70 hover:text-white transition-colors no-underline">Home</a></li>
            <li><a href="/about" class="text-white/70 hover:text-white transition-colors no-underline">About Us</a></li>
            <li><a href="/tour" class="text-white/70 hover:text-white transition-colors no-underline">Tours</a></li>
            <li><a href="/property" class="text-white/70 hover:text-white transition-colors no-underline">Property</a></li>
            <li><a href="/contact" class="text-white/70 hover:text-white transition-colors no-underline">Contact Us</a></li>
          </ul>
        </div>
      )}

      <!-- Services (toggleable + label + optional CMS menu override) -->
      {showServices && servicesItems.length > 0 && (
        <div>
          <h4 class="font-display text-white text-sm uppercase tracking-widest mb-6">{servicesLabel}</h4>
          <ul class="space-y-3 text-sm">
            {servicesItems.map((s) => (
              <li>
                <a href={s.url}
                   target={s.target === '_blank' ? '_blank' : undefined}
                   rel={s.target === '_blank' ? 'noopener noreferrer' : undefined}
                   class="text-white/70 hover:text-white transition-colors no-underline">
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Contact (toggleable + label) -->
      {showContact && (
      <div>
        <h4 class="font-display text-white text-sm uppercase tracking-widest mb-6">{contactLabel}</h4>
        <ul class="space-y-4 text-sm">
          {contact.phone && (
            <li class="flex items-start gap-3 text-white/70">
              <Icon name="phone" class="w-5 h-5 mt-0.5 shrink-0 text-white/60" />
              <a href={`tel:${contact.phone}`} class="hover:text-white transition-colors no-underline">
                {contact.phone}
              </a>
            </li>
          )}
          {contact.email && (
            <li class="flex items-start gap-3 text-white/70">
              <Icon name="mail" class="w-5 h-5 mt-0.5 shrink-0 text-white/60" />
              <a href={`mailto:${contact.email}`} class="hover:text-white transition-colors no-underline break-all">
                {contact.email}
              </a>
            </li>
          )}
          {contact.address && (
            <li class="flex items-start gap-3 text-white/70">
              <Icon name="location_on" class="w-5 h-5 mt-0.5 shrink-0 text-white/60" />
              <span>{contact.address}</span>
            </li>
          )}
          {businessHours && (
            <li class="flex items-start gap-3 text-white/70">
              <Icon name="schedule" class="w-5 h-5 mt-0.5 shrink-0 text-white/60" />
              <span class="whitespace-pre-line">{businessHours}</span>
            </li>
          )}
        </ul>
      </div>
      )}
    </div>

    <!-- Bottom bar (copyright dari SiteSettings, right text dari FooterSettings) -->
    <div class="mt-14 pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-2 text-xs text-white/50">
      <p>&copy; {currentYear} {copyright ?? `${siteName}. All rights reserved.`}</p>
      <p>{bottomRight}</p>
    </div>
  </div>
</footer>

{/*
  Tracking / additional scripts dari CMS (site-settings.footer.additionalScripts).
  Raw HTML — trusted karena update field ini super-admin only via SiteSettings access.
  Ideal untuk: pixel tracking, chat widgets, retargeting scripts, dst.
*/}
{additionalScripts && <Fragment set:html={additionalScripts} />}
