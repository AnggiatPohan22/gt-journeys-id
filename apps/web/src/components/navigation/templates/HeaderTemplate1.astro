---
// HeaderTemplate1 — "Classic" (Logo | Menu | CTA). Replika layout Header lama.
// Sub-menu: klik-untuk-buka (desktop) via NavDesktop; mobile = overlay full-screen.
// Phase 4.41: warna menu/CTA/icon via CSS vars (--h-*) yang di-inject di #main-header.
import Icon from '@components/common/Icon.astro'
import NavDesktop from './_HeaderNavDesktop.astro'
import HeaderMobile from './_HeaderMobile.astro'
const { siteName, logoUrl, logoAlt, items = [], currentPath = '/', transparent = false, cta = { show: false }, themeStyle = '' } = Astro.props as any
---
<header id="main-header" style={themeStyle} class:list={['fixed top-0 left-0 right-0 z-40 transition-all duration-300', transparent ? 'bg-transparent' : 'bg-white/85 backdrop-blur-md border-b border-sand-dark/20 shadow-sm']}>
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    <nav class="flex items-center justify-between h-20" aria-label="Main navigation">
      <a href="/" class="flex items-center gap-3 no-underline text-current">
        {logoUrl ? (
          <img src={logoUrl} alt={logoAlt} class="h-10 w-10 rounded-full object-cover" />
        ) : (
          <span aria-hidden="true" class="h-10 w-10 rounded-full bg-ocean text-white flex items-center justify-center font-display font-bold">{siteName.slice(0, 2)}</span>
        )}
        <span class="font-display text-lg font-bold text-ocean hidden sm:inline">{siteName}</span>
      </a>

      <NavDesktop items={items} currentPath={currentPath} ulClass="gap-6 xl:gap-8 tracking-wide" />

      <div class="flex items-center gap-3">
        {cta.show && cta.href && (
          <a href={cta.href} target={cta.external ? '_blank' : undefined} rel={cta.external ? 'noopener noreferrer' : undefined} class="dnj-cta hidden sm:inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold no-underline shadow-sm hover:shadow-md">
            <Icon name="chat" class="w-4 h-4" />
            <span class="hidden md:inline">{cta.text}</span>
            <span class="md:hidden">Book</span>
          </a>
        )}
        <button id="mobile-toggle" type="button" class="dnj-icon-btn lg:hidden p-2 rounded-md hover:bg-sand transition-colors" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
          <Icon name="menu" class="w-6 h-6 mobile-toggle-open" />
          <Icon name="close" class="w-6 h-6 mobile-toggle-close hidden" />
        </button>
      </div>
    </nav>
  </div>
</header>

<HeaderMobile items={items} currentPath={currentPath} siteName={siteName} logoUrl={logoUrl} logoAlt={logoAlt}>
  {cta.show && cta.href && (
    <a href={cta.href} target={cta.external ? '_blank' : undefined} rel={cta.external ? 'noopener noreferrer' : undefined} class="dnj-cta mt-5 flex items-center justify-center gap-2 px-5 py-3 text-base font-semibold no-underline">
      <Icon name="chat" class="w-5 h-5" />{cta.text}
    </a>
  )}
</HeaderMobile>
<div class="h-20"></div>
