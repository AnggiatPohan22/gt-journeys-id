---
import { siteConfig } from '@config/site'
import { getSiteSettings, getMenuBySlug, getHeaderSettings } from '@lib/payload'
import Icon from '@components/common/Icon.astro'
import type { Media, Menu, SiteSetting } from '@shared/types/payload-types'

interface Props {
  transparent?: boolean
}

const { transparent: transparentProp } = Astro.props

// Fetch: SiteSettings (brand), HeaderSettings (CTA + menu wiring + populated primaryMenu).
let settings: SiteSetting | null = null
let headerCfg: any = null
try { settings = await getSiteSettings() } catch { /* fallback */ }
try { headerCfg = await getHeaderSettings() } catch { /* fallback */ }

// Menu items — HeaderSettings.primaryMenu already comes populated with items[] from
// the global fetch (Payload resolves the relationship by default). Prefer that.
// Fallback: re-fetch by slug 'main-navigation' if the relationship wasn't populated
// (e.g. editor unset primaryMenu but the default seed menu still exists).
let menu: Menu | null = null
const primaryMenuData = headerCfg?.primaryMenu
if (primaryMenuData && typeof primaryMenuData === 'object' && Array.isArray(primaryMenuData.items)) {
  menu = primaryMenuData as Menu
} else {
  try { menu = await getMenuBySlug('main-navigation') } catch { /* fallback nav */ }
}

const siteName = settings?.siteName ?? siteConfig.name
const logo = (typeof settings?.logo === 'object' ? settings.logo : null) as Media | null
const logoUrl = logo?.url ?? ''
const logoAlt = logo?.alt ?? siteName

// CTA resolution — HeaderSettings-driven
const showCta = headerCfg?.showCtaButton !== false
const ctaText = headerCfg?.ctaText || 'WhatsApp Booking'
const ctaType = headerCfg?.ctaType || 'whatsapp'
const waRaw = settings?.contact?.whatsapp ?? siteConfig.contact.whatsapp
const waNumber = waRaw.replace(/\D/g, '')
const ctaHref = ctaType === 'custom' && headerCfg?.ctaCustomLink
  ? headerCfg.ctaCustomLink
  : `https://wa.me/${waNumber}`
const ctaIsExternal = ctaHref.startsWith('http')

// Transparent resolution — prop overrides HeaderSettings default
const transparent = transparentProp !== undefined ? transparentProp : (headerCfg?.transparentOnTop ?? false)

// Menu items — fallback jika menu belum ada di CMS
type NavItem = { label: string; url: string; target?: '_self' | '_blank' | null; children?: NavItem[]; asSpan?: boolean }

// Resolve URL untuk child item — support type: 'page' (relationship) / custom_url / anchor / none
const resolveChildUrl = (c: any): { url: string; asSpan: boolean } => {
  if (c.type === 'none') return { url: '#', asSpan: true }
  if (c.type === 'page' && typeof c.page === 'object' && c.page)
    return { url: `/${c.page.slug ?? ''}`, asSpan: false }
  return { url: c.url ?? '#', asSpan: false }
}
const fallbackNav: NavItem[] = [
  { label: 'Home', url: '/' },
  { label: 'Tours', url: '/tour' },
  { label: 'Contact', url: '/contact' },
]

const navItems: NavItem[] = (menu?.items ?? []).map((item: any) => {
  // Parent URL: prefer type-based resolution (page relationship > url string).
  // Type 'none' = dropdown-only trigger; tidak navigate saat klik.
  const asSpan = item.type === 'none'
  const url = asSpan
    ? '#'
    : item.type === 'page' && typeof item.page === 'object' && item.page
      ? `/${item.page.slug ?? ''}`
      : (item.url ?? '#')
  return {
    label: item.label,
    url,
    target: item.target,
    asSpan,
    children: (item.children ?? []).map((c: any) => {
      const { url, asSpan } = resolveChildUrl(c)
      return { label: c.label, url, target: c.target, asSpan }
    }),
  }
})
const items = navItems.length > 0 ? navItems : fallbackNav

// Active-state matching — compare path prefix (agar sub-route juga highlight parent)
const currentPath = new URL(Astro.request.url).pathname
const isActive = (url: string): boolean => {
  if (url === '/') return currentPath === '/'
  return currentPath === url || currentPath.startsWith(url + '/')
}
---

<header
  id="main-header"
  class:list={[
    'fixed top-0 left-0 right-0 z-40 transition-all duration-300',
    transparent
      ? 'bg-transparent'
      : 'bg-white/85 backdrop-blur-md border-b border-sand-dark/20 shadow-sm',
  ]}
>
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    <nav class="flex items-center justify-between h-20" aria-label="Main navigation">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 no-underline text-current">
        {logoUrl ? (
          <img src={logoUrl} alt={logoAlt} class="h-10 w-10 rounded-full object-cover" />
        ) : (
          <span aria-hidden="true" class="h-10 w-10 rounded-full bg-ocean text-white flex items-center justify-center font-display font-bold">
            {siteName.slice(0, 2)}
          </span>
        )}
        <span class="font-display text-lg font-bold text-ocean hidden sm:inline">{siteName}</span>
      </a>

      <!-- Desktop Navigation -->
      <ul class="hidden lg:flex items-center gap-6 xl:gap-8 text-sm font-semibold tracking-wide">
        {items.map((item) => {
          const hasChildren = item.children && item.children.length > 0
          const active = isActive(item.url)
          return (
            <li class={hasChildren ? 'relative group' : ''}>
              {hasChildren ? (
                <>
                  <button
                    class:list={[
                      'nav-link flex items-center gap-1 transition-colors',
                      active ? 'text-ocean font-bold' : 'text-stone hover:text-ocean',
                    ]}
                    aria-expanded="false"
                  >
                    {item.label}
                    <Icon name="expand_more" class="w-4 h-4 transition-transform group-hover:rotate-180" />
                  </button>
                  <div class="absolute top-full left-0 pt-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                    <ul class="bg-white rounded-xl shadow-xl p-2 min-w-[220px] border border-sand-dark/10">
                      {item.children!.map((child) => (
                        <li>
                          {child.asSpan ? (
                            <span class="block px-4 py-2.5 text-stone-light font-semibold uppercase tracking-wider text-xs">
                              {child.label}
                            </span>
                          ) : (
                            <a
                              href={child.url}
                              target={child.target ?? undefined}
                              rel={child.target === '_blank' ? 'noopener noreferrer' : undefined}
                              class="block px-4 py-2.5 text-stone hover:text-ocean hover:bg-sand rounded-md transition-colors no-underline text-sm"
                            >
                              {child.label}
                            </a>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                </>
              ) : item.asSpan ? (
                <span class="nav-link inline-block pb-1 text-stone-light cursor-default">
                  {item.label}
                </span>
              ) : (
                <a
                  href={item.url}
                  target={item.target ?? undefined}
                  rel={item.target === '_blank' ? 'noopener noreferrer' : undefined}
                  class:list={[
                    'nav-link inline-block pb-1 transition-colors',
                    active
                      ? 'text-ocean font-bold border-b-2 border-coral'
                      : 'text-stone hover:text-ocean',
                  ]}
                  aria-current={active ? 'page' : undefined}
                >
                  {item.label}
                </a>
              )}
            </li>
          )
        })}
      </ul>

      <!-- CTA + Mobile Toggle -->
      <div class="flex items-center gap-3">
        {showCta && ctaHref && (
          <a
            href={ctaHref}
            target={ctaIsExternal ? '_blank' : undefined}
            rel={ctaIsExternal ? 'noopener noreferrer' : undefined}
            class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 bg-ocean text-white text-sm font-semibold rounded-full hover:bg-ocean-light transition-colors no-underline shadow-sm hover:shadow-md"
          >
            <Icon name="chat" class="w-4 h-4" />
            <span class="hidden md:inline">{ctaText}</span>
            <span class="md:hidden">Book</span>
          </a>
        )}

        <!-- Mobile menu button -->
        <button
          id="mobile-toggle"
          type="button"
          class="lg:hidden p-2 text-ocean rounded-md hover:bg-sand transition-colors"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Icon name="menu" class="w-6 h-6 mobile-toggle-open" />
          <Icon name="close" class="w-6 h-6 mobile-toggle-close hidden" />
        </button>
      </div>
    </nav>

    <!-- Mobile drawer (hidden by default, toggled by mobile-toggle) -->
    <div
      id="mobile-menu"
      class="lg:hidden hidden border-t border-sand-dark/20 pb-4"
      aria-hidden="true"
    >
      <ul class="flex flex-col divide-y divide-sand-dark/10 text-sm font-semibold">
        {items.map((item) => {
          const hasChildren = item.children && item.children.length > 0
          const active = isActive(item.url)
          return (
            <li>
              {item.asSpan ? (
                <span class="block px-2 py-4 text-stone-light font-semibold">
                  {item.label}
                </span>
              ) : (
                <a
                  href={item.url}
                  target={item.target ?? undefined}
                  rel={item.target === '_blank' ? 'noopener noreferrer' : undefined}
                  class:list={[
                    'block px-2 py-4 no-underline transition-colors',
                    active ? 'text-ocean font-bold' : 'text-stone hover:text-ocean',
                  ]}
                  aria-current={active ? 'page' : undefined}
                >
                  {item.label}
                </a>
              )}
              {hasChildren && (
                <ul class="pl-4 pb-2 space-y-1 text-sm font-normal">
                  {item.children!.map((child) => (
                    <li>
                      {child.asSpan ? (
                        <span class="block px-2 py-2 text-stone-light font-semibold uppercase tracking-wider text-xs">
                          {child.label}
                        </span>
                      ) : (
                        <a
                          href={child.url}
                          target={child.target ?? undefined}
                          rel={child.target === '_blank' ? 'noopener noreferrer' : undefined}
                          class="block px-2 py-2 text-stone-light hover:text-ocean no-underline"
                        >
                          {child.label}
                        </a>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </li>
          )
        })}
      </ul>

      {showCta && ctaHref && (
        <a
          href={ctaHref}
          target={ctaIsExternal ? '_blank' : undefined}
          rel={ctaIsExternal ? 'noopener noreferrer' : undefined}
          class="mt-4 mx-2 flex items-center justify-center gap-2 px-5 py-3 bg-ocean text-white text-sm font-semibold rounded-full no-underline sm:hidden"
        >
          <Icon name="chat" class="w-4 h-4" />
          {ctaText}
        </a>
      )}
    </div>
  </div>
</header>

<!-- Spacer to prevent content from hiding behind fixed header -->
<div class="h-20"></div>

<style>
  .nav-link {
    @apply relative no-underline;
  }
</style>

<script>
  const setupMobileMenu = () => {
    const toggle = document.getElementById('mobile-toggle')
    const menu = document.getElementById('mobile-menu')
    if (!toggle || !menu) return

    const openIcon = toggle.querySelector('.mobile-toggle-open')
    const closeIcon = toggle.querySelector('.mobile-toggle-close')

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open))
      menu.setAttribute('aria-hidden', String(!open))
      menu.classList.toggle('hidden', !open)
      openIcon?.classList.toggle('hidden', open)
      closeIcon?.classList.toggle('hidden', !open)
    }

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true'
      setOpen(!isOpen)
    })

    // Close on link click (drawer navigates immediately, this cleans state
    // before next page paints)
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false))
    })

    // Close on ESC
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false)
      }
    })

    // Auto-close if viewport crosses lg breakpoint (>=1024px)
    const mq = window.matchMedia('(min-width: 1024px)')
    mq.addEventListener('change', (e) => {
      if (e.matches) setOpen(false)
    })
  }

  // Run on initial page load AND after any Astro view transition
  document.addEventListener('astro:page-load', setupMobileMenu)
  setupMobileMenu()
</script>
