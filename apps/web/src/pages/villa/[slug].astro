---
import PageLayout from '@layouts/PageLayout.astro'
import Icon from '@components/common/Icon.astro'
import BlockRenderer from '@components/blocks/BlockRenderer.astro'
import RelatedServices from '@components/common/RelatedServices.astro'
import { getAccommodations, getAccommodationBySlug, getSiteSettings } from '@lib/payload'
import { resolveRelatedConfig } from '@lib/relatedServices'
import { isModuleEnabled } from '@lib/features'
import { generateWhatsAppLink, renderWhatsAppTemplate, accommodationMessage } from '@lib/whatsapp'
import { getServiceWhatsApp, getServiceTypeByKey } from '@lib/serviceTypes'
import { formatPrice } from '@shared/utils/format-price'
import { siteConfig } from '@config/site'
import { lexicalToPlainText } from '@lib/lexical'
import Breadcrumbs from '@components/common/Breadcrumbs.astro'
import StructuredData from '@components/common/StructuredData.astro'
import PhotoLightbox from '@components/gallery/PhotoLightbox.astro'
import { serviceItemSchema } from '@lib/structuredData'
import type { Accommodation, Media } from '@shared/types/payload-types'

// ── Static paths: SEMUA accommodation (villa/hotel/resort/guesthouse) ──
// /villa/[slug] adalah canonical detail untuk semua tipe akomodasi.
// (Route legacy /accommodations/[slug] sudah dihapus → 301 via _redirects.)
export async function getStaticPaths() {
  if (!(await isModuleEnabled('accommodations'))) return []
  const { docs } = await getAccommodations({ limit: 200 })
  return docs.map((a) => ({ params: { slug: a.slug } }))
}

const { slug } = Astro.params
if (!slug) return Astro.redirect('/villa')

const item = await getAccommodationBySlug(slug)
if (!item) return Astro.redirect('/404')

// ── Data extraction ────────────────────────────────────────────
const asMedia = (v: unknown): Media | null => (v && typeof v === 'object' ? (v as Media) : null)

const dest = typeof item.destination === 'object' ? item.destination : null
const heroImg = asMedia(item.featuredImage)
const heroUrl = heroImg?.sizes?.hero?.url ?? heroImg?.url ?? ''
const heroAlt = heroImg?.alt ?? item.name

// Gallery: first 3 for bento (main + 2 side). Rest for lightbox trigger count.
const galleryEntries = (item.gallery ?? [])
  .map((g) => ({ media: asMedia(g.image), caption: g.caption ?? undefined }))
  .filter((g): g is { media: Media; caption?: string } => !!g.media)
const galleryImages = galleryEntries.map((g) => g.media)
const sideImg1 = galleryImages[0]
const sideImg2 = galleryImages[1]
const totalPhotos = 1 + galleryImages.length

// Photos for lightbox + hero swipe: [hero, ...gallery]. Use hero-size url
// so the big-view is sharp; alt falls back to villa name.
const allPhotos = [
  { url: heroUrl, alt: heroAlt, caption: undefined as string | undefined },
  ...galleryEntries.map((g) => ({
    url: g.media.sizes?.hero?.url ?? g.media.url ?? '',
    alt: g.media.alt ?? '',
    caption: g.caption,
  })),
].filter((p) => !!p.url)

// Pricing
const rooms = item.roomTypes ?? []
const cheapest = rooms
  .map((r) => r.pricePerNight)
  .filter((p): p is number => typeof p === 'number' && p > 0)
  .sort((a, b) => a - b)[0]
const currency = rooms.find((r) => r.pricePerNight === cheapest)?.currency ?? 'IDR'

// Description (plain text from richText)
const descriptionText = lexicalToPlainText(item.description)

// Quick specs — derive from roomTypes + starRating
const roomsCount = rooms.length
const totalCapacity = rooms.reduce((sum, r) => sum + (r.maxGuests ?? 0), 0)
const bedTypes = [...new Set(rooms.map((r) => r.bedType).filter(Boolean))].join(' & ')

// Amenities & tags — highlightTags explicit dari CMS, fallback ke amenities
const amenities = item.amenities ?? []
const explicitTags = ((item as any).highlightTags ?? [])
  .map((t: any) => t?.text)
  .filter((s: any): s is string => typeof s === 'string' && s.length > 0)
const topTags = explicitTags.length > 0 ? explicitTags.slice(0, 6) : amenities.slice(0, 4).map((a) => a.name)

// Nearby landmarks & curated experiences (opsional from CMS)
const nearbyLandmarks = ((item as any).nearbyLandmarks ?? []) as Array<{ name: string; distance?: string }>
const curatedExperiences = ((item as any).curatedExperiences ?? []) as Array<{ name: string }>

// Subtitle + policies (optional)
const subtitle = (item as any).subtitle as string | undefined
const policiesText = item.policies ? lexicalToPlainText(item.policies) : ''
const checkInTime = (item as any).checkInTime as string | undefined
const checkOutTime = (item as any).checkOutTime as string | undefined

// Type label — dideklarasikan sebelum derivedQuickSpecs (dipakai di label
// quick spec untuk stay tanpa starRating, mis. guesthouse) agar tidak TDZ.
const typeLabel: Record<typeof item.type, string> = {
  villa: 'Private Villa',
  hotel: 'Hotel',
  resort: 'Resort',
  guesthouse: 'Guesthouse',
}

// Quick specs — CMS override or auto-derive
type QuickSpec = { iconName: string; label: string; subtitle?: string }
const cmsQuickSpecs = ((item as any).quickSpecs ?? []) as QuickSpec[]
const derivedQuickSpecs: QuickSpec[] = [
  { iconName: 'villa', label: `${roomsCount || '—'} ${roomsCount === 1 ? 'Room' : 'Rooms'}`, subtitle: bedTypes || 'Various beds' },
  { iconName: 'group', label: `${totalCapacity || '—'} Guests`, subtitle: 'Max Capacity' },
  { iconName: 'star',  label: item.starRating ? `${item.starRating}-Star` : typeLabel[item.type], subtitle: item.starRating ? 'Rating' : 'Category' },
  { iconName: 'badge', label: `${amenities.length || '—'} Amenities`, subtitle: 'Included' },
]
const quickSpecs = cmsQuickSpecs.length > 0 ? cmsQuickSpecs.slice(0, 4) : derivedQuickSpecs

// Custom additional blocks (super-admin adds via CMS)
const additionalBlocks = ((item as any).additionalBlocks ?? []) as any[]

// Location
const address = item.location?.address ?? ''
const mapEmbed = item.location?.mapEmbed ?? ''

// ── WhatsApp + Site Settings ──────────────────────────────────
let waNumber = siteConfig.contact.whatsapp
let siteSettings: any = null
try {
  siteSettings = await getSiteSettings()
  waNumber = siteSettings?.contact?.whatsapp ?? siteConfig.contact.whatsapp
} catch { /* fallback */ }
const svcWa = await getServiceWhatsApp('accommodations', waNumber).catch(() => ({ number: waNumber, template: undefined }))
waNumber = svcWa.number
const waLink = generateWhatsAppLink(
  waNumber,
  item.whatsappMessage
    ?? (svcWa.template ? renderWhatsAppTemplate(svcWa.template, { serviceName: item.name, destination: dest?.name }) : accommodationMessage(item.name, dest?.name ?? 'Bali')),
)

// Phase 4.17 — Related Services cascade
const svcType = await getServiceTypeByKey('accommodations').catch(() => null)
const relatedConfig = resolveRelatedConfig(item, svcType, siteSettings)

const priceFormatted = cheapest ? formatPrice(cheapest, currency) : null

// SEO
const title = item.seo?.metaTitle ?? `${item.name} — ${dest?.name ?? 'Bali'}`
const description = item.seo?.metaDescription ?? descriptionText.slice(0, 160)

// ── SEO: breadcrumbs + JSON-LD (D-tech) ──
const detailUrl = `/villa/${slug}`
const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Villas & Hotels', url: '/villa' },
  { name: item.name, url: detailUrl },
]
const itemSchema = serviceItemSchema({
  serviceType: 'accommodations', name: item.name,
  description: descriptionText ? descriptionText.slice(0, 300) : undefined,
  url: detailUrl, image: heroUrl || undefined,
  price: cheapest ?? null, currency,
  addressLocality: dest?.name ?? undefined,
  site: Astro.site?.href,
})
---

<PageLayout title={title} description={description} ogType="product" ogImage={heroUrl || undefined}>
  <Breadcrumbs items={crumbs} />
  <StructuredData schema={itemSchema} />
  {/* ═══ HERO BENTO GALLERY ═══ */}
  <section class="container-content pt-8 md:pt-12 mb-12 md:mb-16">
    <div class="grid grid-cols-1 md:grid-cols-4 grid-rows-2 gap-3 md:gap-4 h-[50vh] md:h-[70vh] rounded-2xl overflow-hidden shadow-lg">
      {/* Main big image — dual-layer crossfade */}
      <div
        id="villa-hero-cell"
        class="md:col-span-3 row-span-2 relative group overflow-hidden cursor-pointer touch-pan-y"
        role="button"
        tabindex="0"
        aria-label="Open photo gallery"
        data-open-lightbox="villa-photos"
        data-index="0"
      >
        {heroUrl ? (
          <>
            <img id="villa-hero-a" src={heroUrl} alt={heroAlt}
                 class="villa-hero-layer villa-hero-layer--visible absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 select-none"
                 loading="eager" fetchpriority="high" draggable="false" />
            <img id="villa-hero-b" src="" alt=""
                 class="villa-hero-layer villa-hero-layer--hidden absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 select-none"
                 aria-hidden="true" draggable="false" />
          </>
        ) : (
          <div class="w-full h-full bg-sand flex items-center justify-center text-stone-light">No image</div>
        )}
        <div class="absolute inset-0 bg-black/10 group-hover:bg-black/0 transition-colors duration-500 pointer-events-none"></div>
      </div>

      {/* Side 1 (desktop only) */}
      <div class="hidden md:block relative group overflow-hidden cursor-pointer"
           data-open-lightbox={sideImg1 ? 'villa-photos' : undefined}
           data-index={sideImg1 ? '1' : undefined}>
        {sideImg1 ? (
          <img src={sideImg1.sizes?.card?.url ?? sideImg1.url ?? ''}
               alt={sideImg1.alt ?? ''}
               class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
               loading="lazy" />
        ) : (
          <div class="w-full h-full bg-sand"></div>
        )}
        <div class="absolute inset-0 bg-black/10 group-hover:bg-black/0 transition-colors duration-500 pointer-events-none"></div>
      </div>

      {/* Side 2 with "Show all photos" overlay */}
      <div class="hidden md:block relative group overflow-hidden cursor-pointer"
           data-open-lightbox={sideImg2 ? 'villa-photos' : undefined}
           data-index={sideImg2 ? '2' : undefined}>
        {sideImg2 ? (
          <img src={sideImg2.sizes?.card?.url ?? sideImg2.url ?? ''}
               alt={sideImg2.alt ?? ''}
               class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
               loading="lazy" />
        ) : (
          <div class="w-full h-full bg-sand"></div>
        )}
        <div class="absolute inset-0 bg-black/10 group-hover:bg-black/0 transition-colors duration-500 pointer-events-none"></div>
        {galleryImages.length > 2 && (
          <button type="button"
             data-open-lightbox="villa-photos" data-index="0"
             class="absolute inset-0 flex items-center justify-center bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 text-white text-sm font-semibold gap-2 border-0 cursor-pointer">
            <Icon name="filter_list" class="w-5 h-5" /> Show all {totalPhotos} photos
          </button>
        )}
      </div>
    </div>

    {/* Mobile-only "Show all photos" button (hover overlay is desktop-only) */}
    {totalPhotos > 1 && (
      <div class="md:hidden mt-3 flex justify-center">
        <button type="button"
                data-open-lightbox="villa-photos" data-index="0"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-sand-dark/30 text-ocean text-sm font-semibold shadow-sm">
          <Icon name="filter_list" class="w-4 h-4" /> Show all {totalPhotos} photos
        </button>
      </div>
    )}
  </section>

  <PhotoLightbox id="villa-photos" photos={allPhotos} />

  <style is:global>
    /* Phase 4.27 — hero crossfade layers */
    .villa-hero-layer {
      transition: opacity 350ms cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity;
    }
    .villa-hero-layer--visible { opacity: 1; }
    .villa-hero-layer--hidden  { opacity: 0; }
    @media (prefers-reduced-motion: reduce) {
      .villa-hero-layer { transition: none; }
    }
  </style>

  <script is:inline define:vars={{ heroPhotos: allPhotos }}>
    // Hero in-place swipe (Option 1): swipe cycles the main image; tap opens lightbox.
    // Mobile-primary — desktop still has hover-zoom + click-to-open.
    // 4.27: dual-layer crossfade between images. Frame stays locked.
    (function () {
      const cell = document.getElementById('villa-hero-cell');
      const layerA = document.getElementById('villa-hero-a');
      const layerB = document.getElementById('villa-hero-b');
      if (!cell || !layerA || !layerB || !Array.isArray(heroPhotos) || heroPhotos.length < 2) return;

      let idx = 0;
      let active = layerA; // starts visible
      let inactive = layerB;
      let startX = null, startY = null, startT = 0, moved = false;
      let swapping = false;

      const setPhoto = (i) => {
        const target = ((i % heroPhotos.length) + heroPhotos.length) % heroPhotos.length;
        if (target === idx || swapping) return;
        const p = heroPhotos[target];
        swapping = true;
        const preload = new Image();
        const done = () => {
          inactive.src = p.url;
          inactive.alt = p.alt || '';
          // Force a frame so the transition kicks in from opacity:0.
          requestAnimationFrame(() => {
            inactive.classList.remove('villa-hero-layer--hidden');
            inactive.classList.add('villa-hero-layer--visible');
            active.classList.remove('villa-hero-layer--visible');
            active.classList.add('villa-hero-layer--hidden');
            const prev = active;
            active = inactive;
            inactive = prev;
            idx = target;
            cell.setAttribute('data-index', String(idx));
            // Clear swap lock after the transition finishes.
            window.setTimeout(() => { swapping = false; }, 380);
          });
        };
        preload.onload = done;
        preload.onerror = done;
        preload.src = p.url;
        // Fallback: if load event never fires (cache oddities), swap anyway.
        window.setTimeout(() => { if (swapping && inactive.src !== p.url) done(); }, 400);
      };

      cell.addEventListener('touchstart', (e) => {
        if (e.touches.length !== 1) return;
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
        startT = Date.now();
        moved = false;
      }, { passive: true });

      cell.addEventListener('touchmove', (e) => {
        if (startX === null) return;
        const dx = e.touches[0].clientX - startX;
        const dy = e.touches[0].clientY - startY;
        if (Math.abs(dx) > 10 || Math.abs(dy) > 10) moved = true;
      }, { passive: true });

      cell.addEventListener('touchend', (e) => {
        if (startX === null) return;
        const t = e.changedTouches[0];
        const dx = t.clientX - startX;
        const dy = t.clientY - startY;
        const dt = Date.now() - startT;
        startX = startY = null;

        // Horizontal swipe → cycle in-place
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
          e.preventDefault();
          setPhoto(dx < 0 ? idx + 1 : idx - 1);
          return;
        }
        // Tap (no meaningful movement, short duration) → open lightbox at current idx
        if (!moved && dt < 400) {
          e.preventDefault();
          const w = window;
          if (w.__openPhotoLightbox) w.__openPhotoLightbox('villa-photos', idx);
        }
      });

      // Keyboard accessibility on the cell (desktop)
      cell.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const w = window;
          if (w.__openPhotoLightbox) w.__openPhotoLightbox('villa-photos', idx);
        }
      });
    })();
  </script>

  {/* ═══ MAIN LAYOUT: LEFT DETAIL + RIGHT STICKY BOOKING ═══ */}
  <section class="container-content grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 mb-24">

    {/* ─── LEFT COLUMN (col-span-8) ─── */}
    <div class="lg:col-span-8">

      {/* Title + Location + Description */}
      <div class="mb-10 pb-10 border-b border-sand-dark/30">
        <div class="flex flex-wrap justify-between items-start gap-4 mb-4">
          <div class="min-w-0">
            <p class="text-xs uppercase tracking-widest text-coral mb-2 font-semibold">{typeLabel[item.type]}</p>
            <h1 class="font-display text-3xl md:text-4xl lg:text-5xl text-ocean mb-2">{item.name}</h1>
            {subtitle && (
              <p class="text-stone-light text-sm md:text-base mb-3 italic">{subtitle}</p>
            )}
            <div class="flex items-center gap-2 text-stone">
              <Icon name="location_on" class="w-4 h-4 text-coral" />
              <span class="text-sm">{[address, dest?.name, 'Bali'].filter(Boolean).join(', ')}</span>
            </div>
          </div>
          {priceFormatted && (
            <div class="text-right hidden sm:block shrink-0">
              <p class="text-xs uppercase tracking-widest text-stone-light font-semibold mb-1">Starting from</p>
              <p class="font-display text-xl md:text-2xl text-ocean">{priceFormatted} <span class="text-sm text-stone-light font-normal">/ night</span></p>
            </div>
          )}
        </div>
        {descriptionText && (
          <p class="text-stone text-base md:text-lg leading-relaxed mt-6">{descriptionText}</p>
        )}
      </div>

      {/* Quick Specs — CMS override or auto-derive */}
      {quickSpecs.length > 0 && (
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 mb-12">
          {quickSpecs.map((spec) => (
            <div class="flex flex-col items-center p-5 md:p-6 bg-white rounded-xl shadow-sm border border-sand-dark/10 text-center">
              <div class="mb-3 text-coral"><Icon name={spec.iconName || 'star'} class="w-8 h-8" /></div>
              <p class="font-semibold text-ocean text-sm md:text-base">{spec.label}</p>
              {spec.subtitle && <p class="text-xs text-stone-light mt-1">{spec.subtitle}</p>}
            </div>
          ))}
        </div>
      )}

      {/* Amenities */}
      {amenities.length > 0 && (
        <div class="mb-12 pb-12 border-b border-sand-dark/30">
          <h2 class="font-display text-2xl md:text-3xl text-ocean mb-8">Curated Amenities &amp; Facilities</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-4 gap-x-8">
            {amenities.map((am) => (
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-full bg-ocean/10 flex items-center justify-center text-ocean shrink-0">
                  <Icon name={am.icon ?? 'star'} class="w-5 h-5" />
                </div>
                <span class="text-stone text-sm md:text-base">{am.name}</span>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* Location */}
      <div class="mb-12">
        <h2 class="font-display text-2xl md:text-3xl text-ocean mb-6">Location</h2>
        <div class="w-full h-[300px] md:h-[400px] bg-sand rounded-2xl overflow-hidden border border-sand-dark/20">
          {mapEmbed ? (
            <iframe src={mapEmbed} class="w-full h-full" loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
          ) : (
            <div class="w-full h-full flex flex-col items-center justify-center text-stone-light text-sm gap-2">
              <Icon name="location_on" class="w-12 h-12" />
              <p>{address || dest?.name || 'Bali'}</p>
              <p class="text-xs">Map embed not configured</p>
            </div>
          )}
        </div>
        {address && (
          <p class="mt-4 text-stone text-sm flex items-center gap-2">
            <Icon name="location_on" class="w-4 h-4 text-coral" /> {address}
          </p>
        )}

        {(nearbyLandmarks.length > 0 || curatedExperiences.length > 0) && (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6 mt-8">
            {nearbyLandmarks.length > 0 && (
              <div class="p-5 md:p-6 bg-white rounded-xl border border-sand-dark/10">
                <h3 class="font-display text-lg text-ocean mb-3">Nearby Landmarks</h3>
                <ul class="space-y-2 text-sm text-stone">
                  {nearbyLandmarks.map((l) => (
                    <li class="flex items-start gap-2">
                      <span class="text-coral mt-1">•</span>
                      <span>{l.name}{l.distance && <span class="text-stone-light"> ({l.distance})</span>}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {curatedExperiences.length > 0 && (
              <div class="p-5 md:p-6 bg-white rounded-xl border border-sand-dark/10">
                <h3 class="font-display text-lg text-ocean mb-3">Curated Experiences</h3>
                <ul class="space-y-2 text-sm text-stone">
                  {curatedExperiences.map((e) => (
                    <li class="flex items-start gap-2">
                      <span class="text-coral mt-1">•</span>
                      <span>{e.name}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )}
      </div>

      {/* Policies (opsional) */}
      {policiesText && (
        <div class="mb-12">
          <h2 class="font-display text-2xl md:text-3xl text-ocean mb-6">Policies</h2>
          <div class="bg-white rounded-xl border border-sand-dark/10 p-5 md:p-6 text-stone text-sm whitespace-pre-line">
            {policiesText}
          </div>
        </div>
      )}

      {/* Room Types (if any, list) */}
      {rooms.length > 0 && (
        <div class="mb-12">
          <h2 class="font-display text-2xl md:text-3xl text-ocean mb-6">Room Options</h2>
          <div class="space-y-4">
            {rooms.map((r) => (
              <div class="bg-white rounded-xl border border-sand-dark/10 p-5 md:p-6 flex flex-wrap items-start gap-4 md:gap-6">
                <div class="flex-1 min-w-0">
                  <h3 class="font-display text-lg text-ocean mb-2">{r.name}</h3>
                  {r.description && <p class="text-sm text-stone mb-3">{r.description}</p>}
                  <div class="flex flex-wrap gap-4 text-xs text-stone-light">
                    {r.bedType && <span class="inline-flex items-center gap-1"><Icon name="villa" class="w-4 h-4" /> {r.bedType}</span>}
                    {r.maxGuests && <span class="inline-flex items-center gap-1"><Icon name="group" class="w-4 h-4" /> {r.maxGuests} guests</span>}
                  </div>
                </div>
                {typeof r.pricePerNight === 'number' && r.pricePerNight > 0 && (
                  <div class="text-right shrink-0">
                    <p class="text-coral font-semibold text-lg">{formatPrice(r.pricePerNight, r.currency ?? 'IDR')}</p>
                    <p class="text-xs text-stone-light">per night</p>
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      )}
    </div>

    {/* ─── RIGHT COLUMN (col-span-4, sticky booking) ─── */}
    <aside class="lg:col-span-4">
      <div class="lg:sticky lg:top-28 bg-white rounded-2xl shadow-lg border border-sand-dark/10 p-6 md:p-8">
        {/* Tags */}
        {topTags.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-6">
            {topTags.map((tag) => (
              <span class="px-3 py-1 bg-ocean/10 text-ocean rounded-full text-[10px] uppercase tracking-wider font-bold">
                {tag}
              </span>
            ))}
          </div>
        )}

        {/* Price */}
        {priceFormatted && (
          <div class="mb-6 flex justify-between items-end">
            <div>
              <p class="text-xs uppercase tracking-widest text-stone-light font-semibold mb-1">From</p>
              <p class="font-display text-2xl md:text-3xl text-ocean">
                {priceFormatted}
                <span class="text-sm text-stone-light font-normal"> / night</span>
              </p>
            </div>
            {item.starRating && (
              <div class="flex text-coral">
                {Array.from({ length: item.starRating }).map(() => <span>★</span>)}
              </div>
            )}
          </div>
        )}

        {/* Booking form (visual — WA submit) */}
        <form class="space-y-4" onsubmit="return false;">
          <div class="grid grid-cols-2 gap-3">
            <label class="block">
              <span class="block text-xs font-semibold text-stone mb-1">Check-in</span>
              <div class="relative">
                <input type="date"
                       class="w-full bg-sand border border-sand-dark/30 rounded-lg py-2.5 px-3 pl-9 text-sm text-stone focus:outline-none focus:border-ocean focus:ring-1 focus:ring-ocean transition-colors" />
                <Icon name="calendar_today" class="w-4 h-4 absolute left-2.5 top-1/2 -translate-y-1/2 text-stone-light pointer-events-none" />
              </div>
            </label>
            <label class="block">
              <span class="block text-xs font-semibold text-stone mb-1">Check-out</span>
              <div class="relative">
                <input type="date"
                       class="w-full bg-sand border border-sand-dark/30 rounded-lg py-2.5 px-3 pl-9 text-sm text-stone focus:outline-none focus:border-ocean focus:ring-1 focus:ring-ocean transition-colors" />
                <Icon name="calendar_today" class="w-4 h-4 absolute left-2.5 top-1/2 -translate-y-1/2 text-stone-light pointer-events-none" />
              </div>
            </label>
          </div>
          <label class="block">
            <span class="block text-xs font-semibold text-stone mb-1">Guests</span>
            <div class="relative">
              <select class="w-full bg-sand border border-sand-dark/30 rounded-lg py-2.5 px-3 pl-9 pr-8 text-sm text-stone focus:outline-none focus:border-ocean focus:ring-1 focus:ring-ocean appearance-none transition-colors cursor-pointer">
                {Array.from({ length: Math.max(totalCapacity, 10) }, (_, i) => i + 1).slice(0, 20).map((n) => (
                  <option>{n} {n === 1 ? 'Guest' : 'Guests'}</option>
                ))}
              </select>
              <Icon name="group" class="w-4 h-4 absolute left-2.5 top-1/2 -translate-y-1/2 text-stone-light pointer-events-none" />
              <Icon name="expand_more" class="w-4 h-4 absolute right-2.5 top-1/2 -translate-y-1/2 text-stone-light pointer-events-none" />
            </div>
          </label>

          <a href={waLink} target="_blank" rel="noopener noreferrer"
             class="block w-full bg-coral hover:bg-coral-dark text-white text-center py-3.5 rounded-lg font-semibold text-sm uppercase tracking-wider transition-colors no-underline shadow-md hover:shadow-lg">
            Reserve Now
          </a>
        </form>

        {(checkInTime || checkOutTime) && (
          <div class="mt-6 pt-6 border-t border-sand-dark/30 grid grid-cols-2 gap-3 text-center">
            {checkInTime && (
              <div>
                <p class="text-[10px] uppercase tracking-wider text-stone-light font-semibold">Check-in</p>
                <p class="text-sm font-semibold text-ocean mt-1">{checkInTime}</p>
              </div>
            )}
            {checkOutTime && (
              <div>
                <p class="text-[10px] uppercase tracking-wider text-stone-light font-semibold">Check-out</p>
                <p class="text-sm font-semibold text-ocean mt-1">{checkOutTime}</p>
              </div>
            )}
          </div>
        )}

        <div class="mt-6 pt-6 border-t border-sand-dark/30 text-center">
          <p class="text-xs text-stone-light mb-4">You won't be charged yet. Our concierge will confirm details.</p>
          <a href={waLink} target="_blank" rel="noopener noreferrer"
             class="flex items-center justify-center gap-2 w-full border border-ocean text-ocean hover:bg-ocean hover:text-white py-3 rounded-lg font-semibold text-sm no-underline transition-colors">
            <Icon name="headset_mic" class="w-4 h-4" /> Contact Concierge
          </a>
        </div>
      </div>
    </aside>
  </section>

  {/* ═══ CUSTOM SECTIONS (super-admin added blocks) ═══ */}
  {additionalBlocks.length > 0 && (
    <BlockRenderer blocks={additionalBlocks} excludeId={item.id} />
  )}

  {/* ═══ RELATED SERVICES (Phase 4.17 — 3-layer cascade) ═══ */}
  <RelatedServices
    config={relatedConfig}
    serviceType="accommodations"
    excludeId={item.id}
    extraWhere={item.type ? { type: { equals: item.type } } : undefined}
  />
</PageLayout>
