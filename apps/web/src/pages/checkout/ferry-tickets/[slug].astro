---
/**
 * Checkout / Customer Information — Ferry Ticket (Phase 4.62 → 4.63 → 4.63.1).
 *
 * SSR (prerender=false). Alur: detail ticket (isi date/adults/children/class
 * di sidebar) → halaman ini (contact + passengers) → POST /api/bookings/create
 * → confirmation.
 *
 * Phase 4.63.1: Trip Details section dihapus dari UI — semua trip data
 * (departureDate, adults, children, ferryClass*) jadi hidden input, diambil
 * dari query string. Kalau user mau ubah trip → klik "Change trip" di strip
 * atas → balik ke detail page. Kalau date kosong → server redirect balik.
 */
import PageLayout from '@layouts/PageLayout.astro'
import Icon from '@components/common/Icon.astro'
import Breadcrumbs from '@components/common/Breadcrumbs.astro'
import { getFerryTicketsBySlug } from '@lib/payload'
import { isModuleEnabled } from '@lib/features'
import { formatPrice } from '@shared/utils/format-price'
import { resolveLocation, routeLabelFrom } from '@lib/location'
import { issueFormStamp } from '@lib/checkout/signedToken'
import { PHONE_REGIONS, DEFAULT_PHONE_REGION } from '@config/phoneRegions'
import type { Media } from '@shared/types/payload-types'

export const prerender = false

const { slug } = Astro.params
if (!slug) return Astro.redirect('/ferry-tickets')
if (!(await isModuleEnabled('ferryTickets'))) return Astro.redirect('/')

const item = await getFerryTicketsBySlug(slug)
if (!item) return Astro.redirect('/404')

const asMedia = (v: unknown): Media | null => (v && typeof v === 'object' ? (v as Media) : null)
const heroImg = asMedia(item.featuredImage)
const heroUrl = heroImg?.sizes?.card?.url ?? heroImg?.url ?? ''

const url = new URL(Astro.request.url)
const qDate = url.searchParams.get('date') ?? ''
const qAdults = Math.max(1, Math.min(10, Number(url.searchParams.get('adults')) || 1))
const qChildren = Math.max(0, Math.min(6, Number(url.searchParams.get('children')) || 0))
const qClass = url.searchParams.get('class') ?? ''
const errCode = url.searchParams.get('err') ?? ''

// Guard: without a date the booking can't be created. Send user back to
// the detail page to fill the sidebar form.
const detailUrl = `/ferry-tickets/${slug}`
if (!qDate) return Astro.redirect(`${detailUrl}?err=needs_date`)

type FerryClass = {
  name: string
  classType: 'ekonomi' | 'emerald'
  currency?: string
  adultPrice: number
  childPrice?: number
}
const ferryClasses = ((item as any).ferryClasses ?? []) as FerryClass[]
const sortedClasses = ferryClasses.slice().sort((a, b) => (a.adultPrice ?? 0) - (b.adultPrice ?? 0))
const preselected = sortedClasses.find((c) => c.classType === qClass) ?? sortedClasses[0] ?? null

const routeLabel = routeLabelFrom(
  (item as any).originLocation,
  (item as any).arrivalLocation,
  (item as any).origin,
  (item as any).arrival,
)
const originLoc = resolveLocation((item as any).originLocation, (item as any).origin)?.name ?? ''
const destinationLoc = resolveLocation((item as any).arrivalLocation, (item as any).arrival)?.name ?? ''

const currency = preselected?.currency ?? 'IDR'
const unitPrice = preselected?.adultPrice ?? null
const priceFormatted = unitPrice ? formatPrice(unitPrice, currency) : null

const formStamp = await issueFormStamp()

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Ferry Tickets', url: '/ferry-tickets' },
  { name: item.title, url: detailUrl },
  { name: 'Checkout', url: `/checkout/ferry-tickets/${slug}` },
]

const errorMessages: Record<string, string> = {
  invalid_body: 'Terjadi kesalahan mengirim form. Coba lagi.',
  invalid_fields: 'Isi semua field wajib (nama, telepon, email).',
  invalid_passengers: 'Data penumpang belum lengkap — periksa nama depan & belakang untuk tiap penumpang.',
  invalid_passport_expiry: 'Passport minimal 1 penumpang habis dalam <6 bulan setelah tanggal keberangkatan.',
  stamp_malformed: 'Session form kadaluarsa. Silakan reload halaman.',
  stamp_bad_signature: 'Session form invalid. Silakan reload halaman.',
  stamp_too_fast: 'Mohon isi form dengan seksama sebelum submit (min. 3 detik).',
  stamp_expired: 'Form kadaluarsa. Silakan reload dan isi ulang.',
  store_misconfigured: 'Layanan booking sedang tidak tersedia. Silakan hubungi admin via WhatsApp.',
  store_server_error: 'Gagal menyimpan booking. Silakan coba lagi atau hubungi admin.',
  rate_limited: 'Terlalu banyak percobaan booking dari perangkat ini. Coba lagi dalam 15 menit atau hubungi admin via WhatsApp.',
}
const errorMsg = errCode ? errorMessages[errCode] ?? 'Terjadi kesalahan. Coba lagi.' : ''

const titleOptions = [
  { value: 'mr',     label: 'Mr' },
  { value: 'mrs',    label: 'Mrs' },
  { value: 'ms',     label: 'Ms' },
  { value: 'master', label: 'Master' },
  { value: 'miss',   label: 'Miss' },
]

// Nationality options — reuse PHONE_REGIONS data (dedupe by iso), sorted
// dgn negara populer di atas (order dari phoneRegions.ts sudah SE-Asia dulu).
const nationalityOptions = (() => {
  const seen = new Set<string>()
  return PHONE_REGIONS.filter((r) => {
    if (seen.has(r.iso)) return false
    seen.add(r.iso)
    return true
  }).map((r) => ({ value: r.name, label: `${r.flag} ${r.name}` }))
})()

// Compact date formatter for the trip strip (with weekday — Phase 4.63.2).
const depDateFmt = (() => {
  try {
    return new Date(qDate).toLocaleDateString('en-GB', {
      weekday: 'short', day: 'numeric', month: 'short', year: 'numeric',
    })
  } catch { return qDate }
})()

// Phase 4.63.2 — Price breakdown for the sidebar summary. Child price
// takes preselected.childPrice from CMS if defined; otherwise falls back
// to 50% of the adult price (parity with the endpoint's totalEstimate
// calculation).
const childUnitPrice =
  preselected?.childPrice != null && preselected.childPrice > 0
    ? preselected.childPrice
    : (unitPrice != null ? Math.round(unitPrice / 2) : 0)
const adultLineTotal = (unitPrice ?? 0) * qAdults
const childLineTotal = childUnitPrice * qChildren
const ticketFare = adultLineTotal + childLineTotal

// Service fee & Discount rows are HIDDEN until configured (owner decision
// Phase 4.63.2). When enabled later (CMS field or promo code), set these
// non-zero and the corresponding rows will render.
const serviceFee = 0
const discount = 0
const subtotalDeparture = ticketFare + serviceFee - discount
const totalPrice = subtotalDeparture // one-way; sum of all departures kalau nanti round-trip

const priceFmt = (n: number) => formatPrice(n, currency)
---

<PageLayout title={`Checkout — ${item.title}`} description={`Isi data penumpang untuk booking ${item.title}.`}>
  <Breadcrumbs items={crumbs} />

  <section class="container-content grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 py-10 lg:py-16">
    <div class="lg:col-span-8">
      <p class="text-xs uppercase tracking-widest text-coral mb-2 font-semibold">Checkout · Step 1 of 2</p>
      <h1 class="font-display text-3xl md:text-4xl text-ocean mb-3">Contact & Passenger Information</h1>
      <p class="text-stone mb-6">Isi data kontak & seluruh penumpang. Data ini digunakan untuk konfirmasi booking dan penyusunan tiket final.</p>

      {/* ── Trip strip (read-only) ── */}
      <div class="mb-6 flex flex-wrap items-center justify-between gap-3 bg-ocean/5 border border-ocean/15 rounded-xl px-5 py-3">
        <div class="flex items-center gap-4 flex-wrap text-sm text-ocean min-w-0">
          <span class="inline-flex items-center gap-1.5"><Icon name="ship" class="w-4 h-4 text-coral" /><span class="font-semibold truncate max-w-[16rem]">{item.title}</span></span>
          {routeLabel && <span class="inline-flex items-center gap-1.5"><Icon name="location_on" class="w-4 h-4 text-coral" />{routeLabel}</span>}
          <span class="inline-flex items-center gap-1.5"><Icon name="calendar_today" class="w-4 h-4 text-coral" />{depDateFmt}</span>
          <span class="inline-flex items-center gap-1.5"><Icon name="group" class="w-4 h-4 text-coral" />{qAdults} adult{qAdults > 1 ? 's' : ''}{qChildren > 0 ? ` · ${qChildren} child${qChildren > 1 ? 'ren' : ''}` : ''}</span>
          {preselected && <span class="inline-flex items-center gap-1.5 px-2 py-0.5 bg-ocean/10 rounded-full text-xs font-semibold">{preselected.name}</span>}
        </div>
        <a href={detailUrl} class="text-xs font-semibold text-coral hover:text-coral-dark underline underline-offset-4 whitespace-nowrap">Change trip →</a>
      </div>

      {errorMsg && (
        <div class="mb-6 p-4 bg-coral/10 border border-coral/30 rounded-lg text-sm text-stone">
          <strong class="text-coral">Perhatian:</strong> {errorMsg}
        </div>
      )}

      <form
        method="POST"
        action="/api/bookings/create"
        class="bg-white rounded-2xl border border-sand-dark/10 p-6 md:p-8 space-y-8"
        id="checkout-form"
      >
        {/* Hidden: identity + trip data */}
        <input type="hidden" name="slug" value={slug} />
        <input type="hidden" name="ferryTicketId" value={String(item.id)} />
        <input type="hidden" name="originLocation" value={originLoc} />
        <input type="hidden" name="destinationLocation" value={destinationLoc} />
        <input type="hidden" name="formStamp" value={formStamp} />
        <input type="hidden" name="departureDate" value={qDate} />
        <input type="hidden" name="adults" value={String(qAdults)} />
        <input type="hidden" name="children" value={String(qChildren)} />
        {preselected && (
          <>
            <input type="hidden" name="ferryClassType" value={preselected.classType} />
            <input type="hidden" name="ferryClassName" value={preselected.name} />
            <input type="hidden" name="unitPrice" value={String(preselected.adultPrice)} />
            <input type="hidden" name="currency" value={preselected.currency ?? 'IDR'} />
          </>
        )}
        <div class="hidden" aria-hidden="true">
          <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        {/* ── Contact ── */}
        <section>
          <h2 class="font-display text-xl text-ocean mb-4">Contact Information</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <label class="block">
              <span class="block text-xs font-semibold text-stone mb-1">Full Name <span class="text-coral">*</span></span>
              <input type="text" name="customerName" required minlength="2" maxlength="200" placeholder="e.g. Anggi Pohan"
                class="w-full bg-sand border border-sand-dark/30 rounded-lg py-2.5 px-3 text-sm focus:outline-none focus:border-ocean focus:ring-1 focus:ring-ocean placeholder:text-stone-light/70" />
            </label>
            <label class="block">
              <span class="block text-xs font-semibold text-stone mb-1">Email <span class="text-coral">*</span></span>
              <input type="email" name="customerEmail" required maxlength="200" placeholder="you@example.com"
                class="w-full bg-sand border border-sand-dark/30 rounded-lg py-2.5 px-3 text-sm focus:outline-none focus:border-ocean focus:ring-1 focus:ring-ocean placeholder:text-stone-light/70" />
            </label>
          </div>

          <div class="mt-4">
            <span class="block text-xs font-semibold text-stone mb-1">Phone Number <span class="text-coral">*</span></span>
            <div class="flex flex-wrap gap-2 items-stretch">
              <select name="contactPhoneRegion" required
                class="bg-sand border border-sand-dark/30 rounded-lg py-2.5 px-3 text-sm focus:outline-none focus:border-ocean focus:ring-1 focus:ring-ocean min-w-[8rem]">
                {PHONE_REGIONS.map((r) => (
                  <option value={r.code} selected={r.code === DEFAULT_PHONE_REGION}>{r.flag} {r.code} {r.name}</option>
                ))}
              </select>
              <input type="tel" name="contactPhone" required minlength="4" maxlength="20" placeholder="8123456789"
                class="flex-1 min-w-0 bg-sand border border-sand-dark/30 rounded-lg py-2.5 px-3 text-sm focus:outline-none focus:border-ocean focus:ring-1 focus:ring-ocean placeholder:text-stone-light/70" />
              <label class="inline-flex items-center gap-2 px-3 bg-sand/50 border border-sand-dark/30 rounded-lg cursor-pointer">
                <input type="checkbox" name="contactPhoneIsWhatsapp" value="1" checked class="accent-ocean" />
                <span class="text-xs font-semibold text-stone whitespace-nowrap">Also WhatsApp</span>
              </label>
            </div>
            <p class="mt-1 text-xs text-stone-light">Kalau nomor WA berbeda, uncheck lalu tambahkan di catatan di bawah.</p>
          </div>

          <div class="mt-4">
            <label class="block">
              <span class="block text-xs font-semibold text-stone mb-1">Country (opsional)</span>
              <input type="text" name="customerCountry" maxlength="100" placeholder="e.g. Indonesia"
                class="w-full bg-sand border border-sand-dark/30 rounded-lg py-2.5 px-3 text-sm focus:outline-none focus:border-ocean focus:ring-1 focus:ring-ocean placeholder:text-stone-light/70" />
            </label>
          </div>
        </section>

        {/* ── Passengers ── */}
        <section class="pt-6 border-t border-sand-dark/10">
          <div class="flex items-end justify-between mb-4 gap-3 flex-wrap">
            <div>
              <h2 class="font-display text-xl text-ocean">Passenger Details</h2>
              <p class="text-xs text-stone-light mt-1">Data tiap penumpang untuk manifest & tiket. Passport minimal berlaku 6 bulan setelah tanggal keberangkatan.</p>
            </div>
            <p class="text-xs text-stone-light">{qAdults} adult{qAdults > 1 ? 's' : ''}{qChildren > 0 ? ` · ${qChildren} child${qChildren > 1 ? 'ren' : ''}` : ''}</p>
          </div>

          <div class="space-y-4">
            {Array.from({ length: qAdults + qChildren }, (_, i) => {
              const type: 'adult' | 'child' = i < qAdults ? 'adult' : 'child'
              const paxNum = type === 'adult' ? i + 1 : i - qAdults + 1
              return (
                <div class="bg-sand/40 border border-sand-dark/20 rounded-xl p-5">
                  <div class="flex items-center justify-between mb-4">
                    <h3 class="font-display text-base text-ocean">
                      Passenger {i + 1} — <span class="uppercase tracking-wider text-xs text-coral font-semibold">{type} {paxNum}</span>
                    </h3>
                    <label class="inline-flex items-center gap-2 text-xs text-stone-light opacity-50 cursor-not-allowed" title="Fitur ini akan diaktifkan di Phase 4.64 dengan proteksi data passport.">
                      <input type="checkbox" name={`passengers[${i}][remember]`} value="1" disabled class="accent-ocean" />
                      <span>Remember (soon)</span>
                    </label>
                  </div>

                  <input type="hidden" name={`passengers[${i}][passengerType]`} value={type} />

                  <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                    <label class="block">
                      <span class="block text-xs font-semibold text-stone mb-1">Title</span>
                      <select name={`passengers[${i}][title]`} class="w-full bg-white border border-sand-dark/30 rounded-lg py-2 px-2.5 text-sm focus:outline-none focus:border-ocean focus:ring-1 focus:ring-ocean">
                        <option value="">Select…</option>
                        {titleOptions.map((t) => <option value={t.value}>{t.label}</option>)}
                      </select>
                    </label>
                    <label class="block">
                      <span class="block text-xs font-semibold text-stone mb-1">Gender</span>
                      <select name={`passengers[${i}][gender]`} class="w-full bg-white border border-sand-dark/30 rounded-lg py-2 px-2.5 text-sm focus:outline-none focus:border-ocean focus:ring-1 focus:ring-ocean">
                        <option value="">Select…</option>
                        <option value="male">Male</option>
                        <option value="female">Female</option>
                      </select>
                    </label>
                    <label class="block col-span-2 md:col-span-2">
                      <span class="block text-xs font-semibold text-stone mb-1">Nationality</span>
                      <select name={`passengers[${i}][nationality]`} class="w-full bg-white border border-sand-dark/30 rounded-lg py-2 px-2.5 text-sm focus:outline-none focus:border-ocean focus:ring-1 focus:ring-ocean">
                        <option value="">Select nationality…</option>
                        {nationalityOptions.map((n) => <option value={n.value}>{n.label}</option>)}
                      </select>
                    </label>
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mt-3">
                    <label class="block">
                      <span class="block text-xs font-semibold text-stone mb-1">First Name <span class="text-coral">*</span></span>
                      <input type="text" name={`passengers[${i}][firstName]`} required minlength="1" maxlength="80" placeholder="e.g. John"
                        class="w-full bg-white border border-sand-dark/30 rounded-lg py-2 px-2.5 text-sm focus:outline-none focus:border-ocean focus:ring-1 focus:ring-ocean placeholder:text-stone-light/70" />
                    </label>
                    <label class="block">
                      <span class="block text-xs font-semibold text-stone mb-1">Last Name <span class="text-coral">*</span></span>
                      <input type="text" name={`passengers[${i}][lastName]`} required minlength="1" maxlength="80" placeholder="e.g. Doe"
                        class="w-full bg-white border border-sand-dark/30 rounded-lg py-2 px-2.5 text-sm focus:outline-none focus:border-ocean focus:ring-1 focus:ring-ocean placeholder:text-stone-light/70" />
                    </label>
                  </div>

                  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-3">
                    <label class="block">
                      <span class="block text-xs font-semibold text-stone mb-1">Date of Birth</span>
                      <input type="date" name={`passengers[${i}][dateOfBirth]`}
                        class="w-full bg-white border border-sand-dark/30 rounded-lg py-2 px-2.5 text-sm focus:outline-none focus:border-ocean focus:ring-1 focus:ring-ocean" />
                    </label>
                    <label class="block">
                      <span class="block text-xs font-semibold text-stone mb-1">Passport Number</span>
                      <input type="text" name={`passengers[${i}][passportNumber]`} maxlength="30" autocomplete="off" placeholder="e.g. A12345678"
                        class="w-full bg-white border border-sand-dark/30 rounded-lg py-2 px-2.5 text-sm focus:outline-none focus:border-ocean focus:ring-1 focus:ring-ocean placeholder:text-stone-light/70" />
                    </label>
                    <label class="block">
                      <span class="block text-xs font-semibold text-stone mb-1">Issue Date</span>
                      <input type="date" name={`passengers[${i}][passportIssueDate]`}
                        class="w-full bg-white border border-sand-dark/30 rounded-lg py-2 px-2.5 text-sm focus:outline-none focus:border-ocean focus:ring-1 focus:ring-ocean" />
                    </label>
                    <label class="block">
                      <span class="block text-xs font-semibold text-stone mb-1">Expiry Date</span>
                      <input type="date" name={`passengers[${i}][passportExpiryDate]`}
                        class="w-full bg-white border border-sand-dark/30 rounded-lg py-2 px-2.5 text-sm focus:outline-none focus:border-ocean focus:ring-1 focus:ring-ocean" />
                    </label>
                  </div>
                </div>
              )
            })}
          </div>
        </section>

        {/* ── Notes ── */}
        <section class="pt-6 border-t border-sand-dark/10">
          <label class="block">
            <span class="block text-xs font-semibold text-stone mb-1">Additional Notes (opsional)</span>
            <textarea name="customerNotes" rows="3" maxlength="1000"
              placeholder="Contoh: nomor WA berbeda dari phone, request kursi dekat jendela, jemput hotel, dsb."
              class="w-full bg-sand border border-sand-dark/30 rounded-lg py-2.5 px-3 text-sm focus:outline-none focus:border-ocean focus:ring-1 focus:ring-ocean placeholder:text-stone-light/70"></textarea>
          </label>
        </section>

        {/* ── Submit ── */}
        <div class="pt-6 border-t border-sand-dark/10 flex flex-col md:flex-row-reverse items-center gap-3">
          <button type="submit"
            class="w-full md:w-auto bg-coral hover:bg-coral-dark text-white px-8 py-3.5 rounded-lg font-semibold text-sm uppercase tracking-wider transition-colors shadow-md">
            Lanjut ke Konfirmasi
          </button>
          <a href={detailUrl} class="text-sm text-stone hover:text-ocean underline underline-offset-4">← Kembali ke detail ticket</a>
        </div>
      </form>
    </div>

    {/* ─── Summary sidebar ─── */}
    <aside class="lg:col-span-4">
      <div class="lg:sticky lg:top-28 bg-white rounded-2xl shadow-lg border border-sand-dark/10 p-6">
        <p class="text-xs uppercase tracking-widest text-stone-light font-semibold mb-3">Booking Summary</p>
        <div class="flex gap-3 mb-4 pb-4 border-b border-sand-dark/10">
          {heroUrl && (
            <div class="w-20 h-20 rounded-lg overflow-hidden bg-sand shrink-0">
              <img src={heroUrl} alt={item.title} class="w-full h-full object-cover" loading="lazy" />
            </div>
          )}
          <div class="min-w-0">
            <h2 class="font-display text-base text-ocean line-clamp-2">{item.title}</h2>
            {routeLabel && <p class="text-xs text-stone-light mt-1 flex items-center gap-1"><Icon name="location_on" class="w-3 h-3 text-coral" />{routeLabel}</p>}
          </div>
        </div>
        {/* Trip meta */}
        <dl class="space-y-2 text-sm mb-4">
          <div class="flex justify-between">
            <dt class="text-stone-light">Departure</dt>
            <dd class="text-ocean font-semibold text-right">{depDateFmt}</dd>
          </div>
          {preselected && (
            <div class="flex justify-between">
              <dt class="text-stone-light">Class</dt>
              <dd class="text-ocean font-semibold">{preselected.name}</dd>
            </div>
          )}
        </dl>

        {/* Price breakdown (Phase 4.63.2) */}
        <div class="pt-4 border-t border-sand-dark/10">
          <p class="text-[10px] uppercase tracking-widest text-stone-light font-semibold mb-3">Price Breakdown</p>

          <dl class="space-y-1.5 text-sm">
            {unitPrice != null && (
              <div class="flex justify-between">
                <dt class="text-stone">
                  Adult
                  <span class="text-stone-light text-xs"> ({qAdults} × {priceFmt(unitPrice)})</span>
                </dt>
                <dd class="text-ocean font-semibold tabular-nums">{priceFmt(adultLineTotal)}</dd>
              </div>
            )}
            {qChildren > 0 && (
              <div class="flex justify-between">
                <dt class="text-stone">
                  Child
                  <span class="text-stone-light text-xs"> ({qChildren} × {priceFmt(childUnitPrice)})</span>
                </dt>
                <dd class="text-ocean font-semibold tabular-nums">{priceFmt(childLineTotal)}</dd>
              </div>
            )}
          </dl>

          <div class="mt-3 pt-3 border-t border-sand-dark/10 space-y-1.5 text-sm">
            <div class="flex justify-between">
              <dt class="text-stone-light">Ticket fare</dt>
              <dd class="text-ocean font-semibold tabular-nums">{priceFmt(ticketFare)}</dd>
            </div>
            {/*
              Service Fee & Discount rows disembunyikan sampai fee configurable
              & promo code aktif (Phase 4.65+). Struktur di bawah sudah siap
              — cukup ubah `serviceFee`/`discount` != 0 di atas.
            */}
            {serviceFee > 0 && (
              <div class="flex justify-between">
                <dt class="text-stone-light">Service fee</dt>
                <dd class="text-ocean tabular-nums">{priceFmt(serviceFee)}</dd>
              </div>
            )}
            {discount > 0 && (
              <div class="flex justify-between">
                <dt class="text-stone-light">Discount</dt>
                <dd class="text-leaf tabular-nums">− {priceFmt(discount)}</dd>
              </div>
            )}
          </div>

          <div class="mt-3 pt-3 border-t border-sand-dark/10 flex justify-between text-sm">
            <dt class="text-stone-light">Subtotal <span class="text-stone-light/70">(Departure)</span></dt>
            <dd class="text-ocean font-semibold tabular-nums">{priceFmt(subtotalDeparture)}</dd>
          </div>

          <div class="mt-3 pt-3 border-t-2 border-ocean/20 flex justify-between items-baseline">
            <dt class="font-display text-ocean text-base">Total Price</dt>
            <dd class="font-display text-coral text-xl md:text-2xl tabular-nums">{priceFmt(totalPrice)}</dd>
          </div>
        </div>

        <p class="mt-4 text-xs text-stone-light leading-relaxed">
          Anda tidak dikenai biaya sekarang. Rincian di atas adalah estimasi harga tiket; instruksi pembayaran final dikirim via WhatsApp setelah admin mengkonfirmasi ketersediaan.
        </p>
      </div>
    </aside>
  </section>
</PageLayout>
