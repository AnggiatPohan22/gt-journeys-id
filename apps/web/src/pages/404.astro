---
import BaseLayout from '@layouts/BaseLayout.astro'
import Header from '@components/navigation/HeaderRenderer.astro'
import Footer from '@components/navigation/FooterRenderer.astro'
import { getSiteSettings } from '@lib/payload'

const settings = await getSiteSettings().catch(() => null)
const nf = settings?.errorPages?.notFound as any

const title = nf?.title || 'Halaman Tidak Ditemukan'
const message = nf?.message || 'Halaman yang kamu cari mungkin sudah dipindahkan, dihapus, atau modul-nya sedang dinonaktifkan.'
const buttonText = nf?.buttonText || 'Kembali ke Beranda'
---

<BaseLayout title={`404 — ${title}`} description={message} noindex={true}>
  <Header />
  <main class="min-h-[60vh] flex items-center justify-center px-4 py-24">
    <div class="text-center max-w-lg">
      <p class="font-display text-6xl font-bold text-ocean">404</p>
      <h1 class="mt-4 font-display text-2xl md:text-3xl text-ocean">{title}</h1>
      <p class="mt-4 text-stone-light">{message}</p>
      <a href="/" class="mt-8 inline-flex items-center gap-2 px-6 py-3 bg-ocean text-white rounded-full no-underline hover:bg-ocean-light transition-colors">
        {buttonText}
      </a>
    </div>
  </main>
  <Footer />
</BaseLayout>
