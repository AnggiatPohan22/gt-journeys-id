---
import PageLayout from '@layouts/PageLayout.astro'
import Icon from '@components/common/Icon.astro'
import BlockRenderer from '@components/blocks/BlockRenderer.astro'
import RelatedServices from '@components/common/RelatedServices.astro'
import { getTours, getTourBySlug, getSiteSettings } from '@lib/payload'
import { resolveRelatedConfig } from '@lib/relatedServices'
import { isModuleEnabled } from '@lib/features'
import { generateWhatsAppLink, renderWhatsAppTemplate, tourBookingMessage } from '@lib/whatsapp'
import { getServiceWhatsApp, getServiceTypeByKey } from '@lib/serviceTypes'
import { formatPrice } from '@shared/utils/format-price'
import { siteConfig } from '@config/site'
import { lexicalToPlainText } from '@lib/lexical'
import Breadcrumbs from '@components/common/Breadcrumbs.astro'
import StructuredData from '@components/common/StructuredData.astro'
import HeroBentoGallery from '@components/gallery/HeroBentoGallery.astro'
import { serviceItemSchema } from '@lib/structuredData'
import type { Tour, Media } from '@shared/types/payload-types'

export async function getStaticPaths() {
  if (!(await isModuleEnabled('tours'))) return []
  const { docs } = await getTours({ limit: 200 })
  return docs.map((t) => ({ params: { slug: t.slug } }))
}

const { slug } = Astro.params
if (!slug) return Astro.redirect('/tour')

const item = await getTourBySlug(slug)
if (!item) return Astro.redirect('/404')

const asMedia = (v: unknown): Media | null => (v && typeof v === 'object' ? (v as Media) : null)
const dest = typeof item.destination === 'object' ? item.destination : null

// ── Hero bento ─────────────────────────────────────────────
const heroImg = asMedia(item.featuredImage)
const heroUrl = heroImg?.sizes?.hero?.url ?? heroImg?.url ?? ''
const heroAlt = heroImg?.alt ?? item.title
// Hero + gallery merge lives inside <HeroBentoGallery /> — see 4.28.

// ── Pricing ────────────────────────────────────────────────
const adultPrice = item.pricing?.adultPrice
const childPrice = item.pricing?.childPrice
const currency = item.pricing?.currency ?? 'IDR'
const priceNote = item.pricing?.priceNote ?? 'per person'
const priceFormatted = adultPrice ? formatPrice(adultPrice, currency) : null

// ── Text extraction ────────────────────────────────────────
const descriptionText = lexicalToPlainText(item.description)
const additionalInfoText = (item as any).additionalInfo ? lexicalToPlainText((item as any).additionalInfo) : ''

const highlights = ((item as any).highlights ?? []) as Array<{ text: string }>
const includes = (item.includes ?? []) as Array<{ item: string }>
const excludes = (item.excludes ?? []) as Array<{ item: string }>
const itinerary = (item.itinerary ?? []) as Array<{ time?: string; title: string; description?: string; iconName?: string }>

const meetingPoint = (item as any).meetingPoint as { name?: string; time?: string; address?: string; mapEmbed?: string } | undefined
const pickupService = (item as any).pickupService as { available?: boolean; areas?: string; notes?: string } | undefined

const subtitle = (item as any).subtitle as string | undefined

// Sidebar tags — top highlights (parity dgn villa highlightTags)
const topTags = highlights.slice(0, 4).map((h) => h.text)

// Quick specs — CMS override or derive
type QuickSpec = { iconName: string; label: string; subtitle?: string }
const cmsQuickSpecs = ((item as any).quickSpecs ?? []) as QuickSpec[]
const derivedQuickSpecs: QuickSpec[] = [
  { iconName: 'schedule', label: item.duration ?? '—',                                    subtitle: 'Duration' },
  { iconName: 'group',    label: `${item.minParticipants ?? '?'}-${item.maxParticipants ?? '?'}`, subtitle: 'Participants' },
  { iconName: 'star',     label: `${itinerary.length || '—'} Stops`,                       subtitle: 'Itinerary' },
  { iconName: 'badge',    label: `${includes.length || '—'} Included`,                     subtitle: 'Perks' },
]
const quickSpecs = cmsQuickSpecs.length > 0 ? cmsQuickSpecs.slice(0, 4) : derivedQuickSpecs

// Custom super-admin blocks
const additionalBlocks = ((item as any).additionalBlocks ?? []) as any[]

// WhatsApp + Site Settings (reused for Related Services cascade)
let waNumber = siteConfig.contact.whatsapp
let siteSettings: any = null
try {
  siteSettings = await getSiteSettings()
  waNumber = siteSettings?.contact?.whatsapp ?? siteConfig.contact.whatsapp
} catch { /* fallback */ }
const svcWa = await getServiceWhatsApp('tours', waNumber).catch(() => ({ number: waNumber, template: undefined }))
waNumber = svcWa.number
const waLink = generateWhatsAppLink(
  waNumber,
  item.whatsappMessage
    ?? (svcWa.template ? renderWhatsAppTemplate(svcWa.template, { serviceName: item.title, destination: dest?.name }) : tourBookingMessage(item.title, dest?.name ?? 'Bali')),
)

// Phase 4.17 — Related Services cascade (Individual > ServiceType > Global)
const svcType = await getServiceTypeByKey('tours').catch(() => null)
const relatedConfig = resolveRelatedConfig(item, svcType, siteSettings)

const title = item.seo?.metaTitle ?? `${item.title} — ${dest?.name ?? 'Bali'}`
const description = item.seo?.metaDescription ?? descriptionText.slice(0, 160)

// ── SEO: breadcrumbs + JSON-LD (D-tech) ──
const detailUrl = `/tour/${slug}`
const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Tours', url: '/tour' },
  { name: item.title, url: detailUrl },
]
const itemSchema = serviceItemSchema({
  serviceType: 'tours', name: item.title,
  description: descriptionText ? descriptionText.slice(0, 300) : undefined,
  url: detailUrl, image: heroUrl || undefined,
  price: adultPrice ?? null, currency,
  addressLocality: dest?.name ?? undefined,
  site: Astro.site?.href,
})
---

<PageLayout title={title} description={description} ogType="product" ogImage={heroUrl || undefined}>
  <Breadcrumbs items={crumbs} />
  <StructuredData schema={itemSchema} />
  {/* ═══ HERO BENTO GALLERY (shared component — 4.28) ═══ */}
  <HeroBentoGallery id="tour-photos" heroImg={heroImg} heroAlt={heroAlt} gallery={item.gallery} />

  {/* ═══ MAIN 12-COL LAYOUT ═══ */}
  <section class="container-content grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 mb-24">
    <div class="lg:col-span-8">

      {/* ─── Title area + description ─── */}
      <div class="mb-10 pb-10 border-b border-sand-dark/30">
        <div class="flex flex-wrap justify-between items-start gap-4 mb-4">
          <div class="min-w-0">
            <p class="text-xs uppercase tracking-widest text-coral mb-2 font-semibold">Tour Experience</p>
            <h1 class="font-display text-3xl md:text-4xl lg:text-5xl text-ocean mb-2">{item.title}</h1>
            {subtitle && <p class="text-stone-light text-sm md:text-base mb-3 italic">{subtitle}</p>}
            <div class="flex items-center gap-2 text-stone flex-wrap">
              <Icon name="location_on" class="w-4 h-4 text-coral" />
              <span class="text-sm">{dest?.name ?? 'Bali'}, Indonesia</span>
              {item.duration && (
                <>
                  <span class="text-stone-light">·</span>
                  <Icon name="schedule" class="w-4 h-4 text-coral" />
                  <span class="text-sm">{item.duration}</span>
                </>
              )}
            </div>
          </div>
          {priceFormatted && (
            <div class="text-right hidden sm:block shrink-0">
              <p class="text-xs uppercase tracking-widest text-stone-light font-semibold mb-1">Starting from</p>
              <p class="font-display text-xl md:text-2xl text-ocean">{priceFormatted} <span class="text-sm text-stone-light font-normal">/ {priceNote}</span></p>
            </div>
          )}
        </div>
        {descriptionText && <p class="text-stone text-base md:text-lg leading-relaxed mt-6">{descriptionText}</p>}
      </div>

      {/* ─── Quick Specs 4-card ─── */}
      {quickSpecs.length > 0 && (
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 mb-12">
          {quickSpecs.map((spec) => (
            <div class="flex flex-col items-center p-5 md:p-6 bg-white rounded-xl shadow-sm border border-sand-dark/10 text-center">
              <div class="mb-3 text-coral"><Icon name={spec.iconName || 'star'} class="w-8 h-8" /></div>
              <p class="font-semibold text-ocean text-sm md:text-base">{spec.label}</p>
              {spec.subtitle && <p class="text-xs text-stone-light mt-1">{spec.subtitle}</p>}
            </div>
          ))}
        </div>
      )}

      {/* ─── Tour Highlights (styled = villa Amenities) ─── */}
      {highlights.length > 0 && (
        <div class="mb-12 pb-12 border-b border-sand-dark/30">
          <h2 class="font-display text-2xl md:text-3xl text-ocean mb-8">Tour Highlights & Perks</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-4 gap-x-8">
            {highlights.map((h) => (
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-full bg-ocean/10 flex items-center justify-center text-ocean shrink-0">
                  <Icon name="star" class="w-5 h-5" />
                </div>
                <span class="text-stone text-sm md:text-base">{h.text}</span>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* ─── Location (map + 2-col info: Meeting Point + Pickup) ─── */}
      {(meetingPoint?.name || meetingPoint?.mapEmbed || pickupService?.available) && (
        <div class="mb-12 pb-12 border-b border-sand-dark/30">
          <h2 class="font-display text-2xl md:text-3xl text-ocean mb-6">Location</h2>
          <div class="w-full h-[300px] md:h-[400px] bg-sand rounded-2xl overflow-hidden border border-sand-dark/20">
            {meetingPoint?.mapEmbed ? (
              <iframe src={meetingPoint.mapEmbed} class="w-full h-full" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
            ) : (
              <div class="w-full h-full flex flex-col items-center justify-center text-stone-light text-sm gap-2">
                <Icon name="location_on" class="w-12 h-12" />
                <p>{meetingPoint?.address || dest?.name || 'Bali'}</p>
                <p class="text-xs">Map embed not configured</p>
              </div>
            )}
          </div>
          {meetingPoint?.address && (
            <p class="mt-4 text-stone text-sm flex items-center gap-2">
              <Icon name="location_on" class="w-4 h-4 text-coral" /> {meetingPoint.address}
            </p>
          )}

          {(meetingPoint?.name || pickupService?.available) && (
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6 mt-8">
              {meetingPoint?.name && (
                <div class="p-5 md:p-6 bg-white rounded-xl border border-sand-dark/10">
                  <h3 class="font-display text-lg text-ocean mb-3">Meeting Point</h3>
                  <ul class="space-y-2 text-sm text-stone">
                    <li class="flex items-start gap-2">
                      <span class="text-coral mt-1">•</span>
                      <span>{meetingPoint.name}</span>
                    </li>
                    {meetingPoint.time && (
                      <li class="flex items-start gap-2">
                        <span class="text-coral mt-1">•</span>
                        <span>Meeting time: <strong>{meetingPoint.time}</strong></span>
                      </li>
                    )}
                  </ul>
                </div>
              )}
              {pickupService?.available && (
                <div class="p-5 md:p-6 bg-white rounded-xl border border-sand-dark/10">
                  <h3 class="font-display text-lg text-ocean mb-3">Pickup Service</h3>
                  <ul class="space-y-2 text-sm text-stone">
                    {pickupService.areas && (
                      <li class="flex items-start gap-2">
                        <span class="text-coral mt-1">•</span>
                        <span>{pickupService.areas}</span>
                      </li>
                    )}
                    {pickupService.notes && (
                      <li class="flex items-start gap-2 text-stone-light italic">
                        <span class="text-coral mt-1">•</span>
                        <span>{pickupService.notes}</span>
                      </li>
                    )}
                  </ul>
                </div>
              )}
            </div>
          )}
        </div>
      )}

      {/* ─── Policies / Additional Info (styled = villa Policies) ─── */}
      {additionalInfoText && (
        <div class="mb-12">
          <h2 class="font-display text-2xl md:text-3xl text-ocean mb-6">Policies &amp; Info</h2>
          <div class="bg-white rounded-xl border border-sand-dark/10 p-5 md:p-6 text-stone text-sm whitespace-pre-line">
            {additionalInfoText}
          </div>
        </div>
      )}

      {/* ─── Options (styled = villa Room Options, per-item card) ─── */}
      {itinerary.length > 0 && (
        <div class="mb-12" id="options">
          <h2 class="font-display text-2xl md:text-3xl text-ocean mb-6">Itinerary</h2>
          <div class="space-y-4">
            {itinerary.map((step, i) => (
              <div class="bg-white rounded-xl border border-sand-dark/10 p-5 md:p-6 flex flex-wrap items-start gap-4 md:gap-6">
                <div class="w-12 h-12 rounded-full bg-ocean text-white flex items-center justify-center font-display font-bold shrink-0">
                  {step.iconName ? <Icon name={step.iconName} class="w-5 h-5" /> : (i + 1)}
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex flex-wrap items-baseline gap-2 mb-1">
                    <h3 class="font-display text-lg text-ocean">{step.title}</h3>
                    {step.time && <span class="text-xs text-coral font-semibold uppercase tracking-wider">{step.time}</span>}
                  </div>
                  {step.description && <p class="text-sm text-stone">{step.description}</p>}
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* ─── Includes vs Excludes (bonus section, styled consistent) ─── */}
      {(includes.length > 0 || excludes.length > 0) && (
        <div class="mb-12">
          <h2 class="font-display text-2xl md:text-3xl text-ocean mb-6">What's Included</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {includes.length > 0 && (
              <div class="p-5 md:p-6 bg-white rounded-xl border border-sand-dark/10">
                <h3 class="font-display text-lg text-ocean mb-3">Included</h3>
                <ul class="space-y-2 text-sm text-stone">
                  {includes.map((i) => <li class="flex items-start gap-2"><span class="text-leaf mt-1">✓</span><span>{i.item}</span></li>)}
                </ul>
              </div>
            )}
            {excludes.length > 0 && (
              <div class="p-5 md:p-6 bg-white rounded-xl border border-sand-dark/10">
                <h3 class="font-display text-lg text-ocean mb-3">Not Included</h3>
                <ul class="space-y-2 text-sm text-stone">
                  {excludes.map((e) => <li class="flex items-start gap-2"><span class="text-coral mt-1">✕</span><span>{e.item}</span></li>)}
                </ul>
              </div>
            )}
          </div>
        </div>
      )}
    </div>

    {/* ─── SIDEBAR (parity dgn villa sidebar) ─── */}
    <aside class="lg:col-span-4">
      <div class="lg:sticky lg:top-28 bg-white rounded-2xl shadow-lg border border-sand-dark/10 p-6 md:p-8">
        {topTags.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-6">
            {topTags.map((tag) => (
              <span class="px-3 py-1 bg-ocean/10 text-ocean rounded-full text-[10px] uppercase tracking-wider font-bold">{tag}</span>
            ))}
          </div>
        )}

        {priceFormatted && (
          <div class="mb-6 flex justify-between items-end">
            <div>
              <p class="text-xs uppercase tracking-widest text-stone-light font-semibold mb-1">From</p>
              <p class="font-display text-2xl md:text-3xl text-ocean">
                {priceFormatted}
                <span class="text-sm text-stone-light font-normal"> / {priceNote}</span>
              </p>
            </div>
          </div>
        )}

        <form class="space-y-4" onsubmit="return false;">
          <div class="grid grid-cols-2 gap-3">
            <label class="block">
              <span class="block text-xs font-semibold text-stone mb-1">Tour Date</span>
              <div class="relative">
                <input type="date" class="w-full bg-sand border border-sand-dark/30 rounded-lg py-2.5 px-3 pl-9 text-sm text-stone focus:outline-none focus:border-ocean focus:ring-1 focus:ring-ocean transition-colors" />
                <Icon name="calendar_today" class="w-4 h-4 absolute left-2.5 top-1/2 -translate-y-1/2 text-stone-light pointer-events-none" />
              </div>
            </label>
            <label class="block">
              <span class="block text-xs font-semibold text-stone mb-1">Adults</span>
              <div class="relative">
                <select class="w-full bg-sand border border-sand-dark/30 rounded-lg py-2.5 px-3 pl-9 pr-8 text-sm text-stone focus:outline-none focus:border-ocean appearance-none transition-colors cursor-pointer">
                  {Array.from({ length: item.maxParticipants ?? 10 }, (_, i) => i + (item.minParticipants ?? 1)).map((n) => <option>{n}</option>)}
                </select>
                <Icon name="group" class="w-4 h-4 absolute left-2.5 top-1/2 -translate-y-1/2 text-stone-light pointer-events-none" />
                <Icon name="expand_more" class="w-4 h-4 absolute right-2.5 top-1/2 -translate-y-1/2 text-stone-light pointer-events-none" />
              </div>
            </label>
          </div>
          <label class="block">
            <span class="block text-xs font-semibold text-stone mb-1">Children</span>
            <div class="relative">
              <select class="w-full bg-sand border border-sand-dark/30 rounded-lg py-2.5 px-3 pl-9 pr-8 text-sm text-stone focus:outline-none focus:border-ocean appearance-none transition-colors cursor-pointer">
                {Array.from({ length: 6 }, (_, i) => i).map((n) => <option>{n} {n === 1 ? 'child' : 'children'}{childPrice ? ` (+${formatPrice(childPrice, currency)})` : ''}</option>)}
              </select>
              <Icon name="sentiment_satisfied" class="w-4 h-4 absolute left-2.5 top-1/2 -translate-y-1/2 text-stone-light pointer-events-none" />
              <Icon name="expand_more" class="w-4 h-4 absolute right-2.5 top-1/2 -translate-y-1/2 text-stone-light pointer-events-none" />
            </div>
          </label>

          <a href={waLink} target="_blank" rel="noopener noreferrer" class="block w-full bg-coral hover:bg-coral-dark text-white text-center py-3.5 rounded-lg font-semibold text-sm uppercase tracking-wider transition-colors no-underline shadow-md hover:shadow-lg">Reserve Now</a>
        </form>

        {(item.duration || meetingPoint?.time) && (
          <div class="mt-6 pt-6 border-t border-sand-dark/30 grid grid-cols-2 gap-3 text-center">
            {item.duration && (
              <div>
                <p class="text-[10px] uppercase tracking-wider text-stone-light font-semibold">Duration</p>
                <p class="text-sm font-semibold text-ocean mt-1">{item.duration}</p>
              </div>
            )}
            {meetingPoint?.time && (
              <div>
                <p class="text-[10px] uppercase tracking-wider text-stone-light font-semibold">Meeting</p>
                <p class="text-sm font-semibold text-ocean mt-1">{meetingPoint.time}</p>
              </div>
            )}
          </div>
        )}

        <div class="mt-6 pt-6 border-t border-sand-dark/30 text-center">
          <p class="text-xs text-stone-light mb-4">You won't be charged yet. Our concierge will confirm details.</p>
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 w-full border border-ocean text-ocean hover:bg-ocean hover:text-white py-3 rounded-lg font-semibold text-sm no-underline transition-colors">
            <Icon name="headset_mic" class="w-4 h-4" /> Contact Concierge
          </a>
        </div>
      </div>
    </aside>
  </section>

  {/* ═══ CUSTOM SECTIONS (super-admin blocks) ═══ */}
  {additionalBlocks.length > 0 && <BlockRenderer blocks={additionalBlocks} excludeId={item.id} />}

  {/* ═══ RELATED SERVICES (Phase 4.17 — 3-layer cascade) ═══ */}
  <RelatedServices config={relatedConfig} serviceType="tours" excludeId={item.id} />
</PageLayout>
