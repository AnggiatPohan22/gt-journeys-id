# Payload CMS API URL
CMS_URL=http://localhost:8787

# Site URL (for sitemap, canonical URLs)
SITE_URL=https://dnjourneysbali.com

# Payload API key (users.enableAPIKey) — used by server-side endpoints
# (newsletter subscribe, bookings create) to authenticate against the CMS.
PAYLOAD_API_KEY=

# Phase 4.62 — Checkout channel for Ferry Ticket. `manual_wa` is the
# fallback (WhatsApp handoff). Placeholders reserved: `xendit`, `midtrans`.
# The Manual WhatsApp button ALWAYS stays visible even when a gateway is
# active, so admins can still reach customers manually.
PUBLIC_FERRY_CHECKOUT_CHANNEL=manual_wa

# Phase 4.62 — HMAC secret for signing hidden form timestamps (time-trap
# anti-spam on the checkout form). Set a long random string in production.
BOOKING_FORM_SECRET=change-this-to-a-long-random-string
