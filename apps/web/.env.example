# Payload CMS API URL
CMS_URL=http://localhost:8787

# Site URL (for sitemap, canonical URLs)
SITE_URL=https://example.com

# Payload API key (users.enableAPIKey) — used by server-side endpoints
# (newsletter subscribe, bookings create) to authenticate against the CMS.
PAYLOAD_API_KEY=

# Phase 4.62 — Checkout channel for Ferry Ticket. `manual_wa` is the
# fallback (WhatsApp handoff). Placeholders reserved: `xendit`, `midtrans`.
# The Manual WhatsApp button ALWAYS stays visible even when a gateway is
# active, so admins can still reach customers manually.
PUBLIC_FERRY_CHECKOUT_CHANNEL=manual_wa

# Phase 4.62 — HMAC secret for signing hidden form timestamps (time-trap
# anti-spam on the checkout form). Set a long random string in production.
BOOKING_FORM_SECRET=change-this-to-a-long-random-string

# ─────────────────────────────────────────────────────────────────────
# Phase 4.69.1 — Resend email provider (OTP + booking notifications).
# ─────────────────────────────────────────────────────────────────────
# Dev stage: pakai sandbox `onboarding@resend.dev` sebagai FROM. Resend
# sandbox hanya izinkan kirim ke email yang di-whitelist di dashboard
# (biasanya email akun Resend owner + tester).
#
# Launch stage (saat domain gtjourneys.id siap + DNS verified di Resend):
#   RESEND_FROM_EMAIL=noreply@gtjourneys.id
#   RESEND_REPLY_TO_EMAIL=booking@gtjourneys.id
# Zero code change — hanya flip 2 env var.
#
# Generate API key di https://resend.com/api-keys (permission: Sending
# access cukup; Full access tidak perlu).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_REPLY_TO_EMAIL=
# Optional display name di header From (mis. "GtJourneysID Booking").
RESEND_FROM_NAME=
