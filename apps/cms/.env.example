# Payload secret — ganti dengan string acak (openssl rand -hex 32)
PAYLOAD_SECRET=CHANGE-THIS-TO-A-RANDOM-32-CHAR-STRING

# Local SQLite database file (dev). Kosongkan untuk pakai default cms.db.
# DATABASE_URI=file:./cms.db

# URL server CMS (dev)
SERVER_URL=http://localhost:3000

# URL frontend web (untuk compose confirmationUrl di admin "Send Payment").
# Prod: https://gtjourneysid.com
SITE_URL=http://localhost:4321

# ── Email (Phase 4.69.7 — admin "Send Payment" / "Send Ticket" buttons) ──
# Resend API key (sama dgn apps/web/.env). Daftar di resend.com.
# Dev: sandbox mode — email HANYA ke address verified di dashboard Resend.
# Prod: butuh DNS domain verified di Resend dashboard dulu.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=GtJourneysID
# Reply-to opsional
# RESEND_REPLY_TO_EMAIL=
